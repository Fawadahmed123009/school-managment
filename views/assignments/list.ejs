<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Academics</p>
    <h1>Teacher assignments</h1>
  </div>
</div>

<% if (ok) { %><div class="flash ok"><%= okMsg || 'Saved.' %></div><% } %>
<% if (createError) { %><div class="flash error"><%= createError %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load assignments: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>Assign a teacher to class sections</h2></div>
  <div class="panel-body">
    <form method="POST" action="/assignments/create" id="assignmentForm">
      <div class="field-row">
        <div class="field">
          <label for="teacher">Teacher</label>
          <select name="teacher" id="teacher" required>
            <option value="">Select a teacher</option>
            <% teachers.forEach(function(t) { %>
              <option value="<%= t._id %>"><%= t.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <select name="subject" id="subject" required>
            <option value="">Select a subject</option>
            <% subjects.forEach(function(s) { %>
              <option value="<%= s._id %>"><%= s.name %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <!-- Class selection: checkbox list grouped by grade -->
      <div class="field" style="margin-top:8px;">
        <label>Class sections <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;color:var(--ink-soft);">(select one or more)</span></label>
        <div id="classCheckboxes" style="max-height:320px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:12px 16px;background:#fafbfd;">
          <p id="classPrompt" style="color:var(--ink-soft);font-size:13px;margin:0;">Select a subject above to see available classes.</p>
        </div>
      </div>

      <div style="margin-top:14px;display:flex;align-items:center;gap:16px;">
        <button type="submit" class="btn btn-primary">Assign</button>
        <span id="selectionCount" style="font-size:13px;color:var(--ink-soft);"></span>
      </div>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel-head">
    <h2>Current assignments</h2>
    <% if (pagination) { %>
      <span class="muted" style="font-size:13px;"><%= pagination.total %> total</span>
    <% } %>
  </div>

  <!-- Filter bar -->
  <div style="padding:16px 24px; border-bottom:1px solid var(--border); background:#fafbfd;">
    <form method="GET" action="/assignments" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
      <div style="display:flex; flex-direction:column; gap:4px; min-width:180px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Search</label>
        <input type="text" name="search" value="<%= filters.search %>" placeholder="Teacher, subject or class…" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;" />
      </div>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Teacher</label>
        <select name="teacher" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;">
          <option value="">All teachers</option>
          <% teachers.forEach(function(t) { %>
            <option value="<%= t._id %>" <%= filters.teacher === t._id ? 'selected' : '' %>><%= t.name %></option>
          <% }); %>
        </select>
      </div>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Subject</label>
        <select name="subject" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;">
          <option value="">All subjects</option>
          <% subjects.forEach(function(s) { %>
            <option value="<%= s._id %>" <%= filters.subject === s._id ? 'selected' : '' %>><%= s.name %></option>
          <% }); %>
        </select>
      </div>
      <div style="display:flex; gap:6px; align-items:flex-end;">
        <button type="submit" class="btn btn-primary" style="padding:8px 16px;">Filter</button>
        <% if (filters.search || filters.teacher || filters.subject || filters.classLevel) { %>
          <a href="/assignments" class="btn btn-ghost" style="padding:8px 12px;">Clear</a>
        <% } %>
      </div>
    </form>
  </div>

  <% if (assignments.length === 0) { %>
    <div class="empty">
      <div class="display"><%= (filters.search || filters.teacher || filters.subject) ? 'No assignments match your filters' : 'No assignments yet' %></div>
      <% if (!filters.search && !filters.teacher && !filters.subject) { %>
        <p class="support" style="margin-top:6px;">Use the form above to assign a teacher to a class section.</p>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-wrap">
    <table class="ledger">
      <thead>
        <tr>
          <th>Teacher</th>
          <th>Subject</th>
          <th>Class</th>
          <th>Grade</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% assignments.forEach(function(a) { %>
          <tr>
            <td>
              <strong><%= a.teacher ? a.teacher.name : 'Unknown' %></strong>
              <% if (a.teacher && a.teacher.teacherId) { %>
                <span class="mono" style="display:block;font-size:11px;color:var(--ink-soft);"><%= a.teacher.teacherId %></span>
              <% } %>
            </td>
            <td><%= a.subject ? a.subject.name : 'Unknown' %></td>
            <td>
              <%= a.classLevel ? a.classLevel.name : 'Unknown' %>
              <% if (a.classLevel && a.classLevel.section) { %>
                <span style="color:var(--ink-soft);font-size:12px;"> — <%= a.classLevel.section %></span>
              <% } %>
            </td>
            <td>
              <% if (a.classLevel) { %>
                Grade <%= a.classLevel.gradeLevel %>
                <% if (a.classLevel.group) { %> · <%= a.classLevel.group %><% } %>
              <% } else { %>
                —
              <% } %>
            </td>
            <td style="text-align:right;">
              <form method="POST" action="/assignments/<%= a._id %>/delete" style="display:inline;" data-confirm="Remove this assignment?">
                <button type="submit" class="btn" style="padding:4px 12px; font-size:13px; background:var(--error); color:#fff; border:none;">Remove</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>

    <!-- Pagination controls -->
    <% if (pagination && pagination.pages > 1) { %>
      <%
        var qs = '';
        if (filters.search) qs += '&search=' + encodeURIComponent(filters.search);
        if (filters.teacher) qs += '&teacher=' + encodeURIComponent(filters.teacher);
        if (filters.subject) qs += '&subject=' + encodeURIComponent(filters.subject);
        if (filters.classLevel) qs += '&classLevel=' + encodeURIComponent(filters.classLevel);
      %>
      <div class="pagination-bar">
        <span class="pagination-info">
          Page <%= pagination.page %> of <%= pagination.pages %> &middot; <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %>
        </span>
        <div class="pagination-links">
          <% if (pagination.hasPrev) { %>
            <a href="/assignments?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">&laquo; Prev</a>
          <% } else { %>
            <span class="page-link disabled">&laquo; Prev</span>
          <% } %>

          <%
            var cur = pagination.page;
            var total = pagination.pages;
            var pages = [];
            pages.push(1);
            for (var i = Math.max(2, cur - 2); i <= Math.min(total - 1, cur + 2); i++) {
              pages.push(i);
            }
            if (total > 1) pages.push(total);
            pages = pages.filter(function(v, idx, arr) { return arr.indexOf(v) === idx; }).sort(function(a, b) { return a - b; });
          %>
          <% var prev = 0; %>
          <% pages.forEach(function(p) { %>
            <% if (p - prev > 1) { %>
              <span class="page-ellipsis">&hellip;</span>
            <% } %>
            <% if (p === cur) { %>
              <span class="page-link active"><%= p %></span>
            <% } else { %>
              <a href="/assignments?page=<%= p %>&limit=<%= pagination.limit %><%= qs %>" class="page-link"><%= p %></a>
            <% } %>
            <% prev = p; %>
          <% }); %>

          <% if (pagination.hasNext) { %>
            <a href="/assignments?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">Next &raquo;</a>
          <% } else { %>
            <span class="page-link disabled">Next &raquo;</span>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<!-- Pass data to external JS via CSP-safe JSON islands -->
<script type="application/json" id="subjectClassMap"><%- subjectClassMap %></script>
<script type="application/json" id="subjectHasAppliesTo"><%- subjectHasAppliesTo %></script>
<script type="application/json" id="allClassesData"><%- JSON.stringify(classes) %></script>
<script type="application/json" id="sortedGradesData"><%- JSON.stringify(sortedGrades) %></script>
<script type="application/json" id="classesByGradeData"><%- JSON.stringify(classesByGrade) %></script>
<script src="/js/assignment-classes.js"></script>

<%- include('../partials/foot') %>
