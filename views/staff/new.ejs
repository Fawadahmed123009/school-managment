<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Staff</p>
    <h1>Add Teacher</h1>
  </div>
  <a href="/staff" class="btn btn-ghost">Back to list</a>
</div>

<% if (error) { %><div class="flash error"><%= error %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>New teacher account</h2></div>
  <div class="panel-body">
    <form method="POST" action="/staff/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field">
        <label for="name">Full name</label>
        <input type="text" id="name" name="name" required placeholder="e.g. Ahmed Khan" />
      </div>
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="teacher@school.local" />
      </div>
      <div class="field">
        <label for="whatsappNumber">WhatsApp number <span style="color:var(--ink-soft); font-size:12px;">(optional — for marking reminders)</span></label>
        <input type="tel" id="whatsappNumber" name="whatsappNumber" placeholder="+92 300 1234567" />
      </div>
      <div class="field">
        <label for="password">Temporary password</label>
        <input type="text" id="password" name="password" required placeholder="Min 6 characters" />
      </div>
      <div style="display:flex; gap:16px; flex-wrap:wrap;">
        <div class="field" style="max-width:220px;">
          <label for="expectedArrivalTime">Expected arrival time <span style="color:var(--ink-soft); font-size:12px;">(optional)</span></label>
          <input type="time" id="expectedArrivalTime" name="expectedArrivalTime" />
        </div>
        <div class="field" style="max-width:220px;">
          <label for="expectedDepartureTime">Expected departure time <span style="color:var(--ink-soft); font-size:12px;">(optional)</span></label>
          <input type="time" id="expectedDepartureTime" name="expectedDepartureTime" />
        </div>
      </div>
      <p style="font-size:13px; color:var(--ink-soft); margin:0 0 12px;">
        Expected times drive staff-attendance late detection (arrival + grace period). A teacher without an
        expected arrival time is <strong>never flagged late</strong> until it is set here or via Staff → Edit.
      </p>
      <div style="margin-top: 8px;">
        <button type="submit" class="btn btn-primary">Create teacher</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/foot') %>
