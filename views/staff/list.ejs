<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Roster</p>
    <h1>Staff</h1>
  </div>
  <a href="/staff/new" class="btn btn-primary">+ Add Teacher</a>
</div>

<% if (ok) { %><div class="flash ok">Saved.</div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load staff: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-head">
    <h2>All teachers</h2>
    <% if (pagination) { %>
      <span class="muted" style="font-size:13px;"><%= pagination.total %> total</span>
    <% } %>
  </div>

  <!-- Filter bar -->
  <div style="padding:16px 24px; border-bottom:1px solid var(--border); background:#fafbfd;">
    <form method="GET" action="/staff" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
      <div style="display:flex; flex-direction:column; gap:4px; min-width:200px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Teacher name</label>
        <input type="text" name="search" value="<%= filters.search %>" placeholder="Search by name…" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;" />
      </div>
      <div style="display:flex; gap:6px; align-items:flex-end;">
        <button type="submit" class="btn btn-primary" style="padding:8px 16px;">Filter</button>
        <% if (filters.search) { %>
          <a href="/staff" class="btn btn-ghost" style="padding:8px 12px;">Clear</a>
        <% } %>
      </div>
    </form>
  </div>

  <% if (teachers.length === 0) { %>
    <div class="empty">
      <div class="display"><%= filters.search ? 'No teachers match your search' : 'No teachers yet' %></div>
      <% if (!filters.search) { %>
        <a href="/staff/new" class="btn btn-primary" style="margin-top:12px;">+ Add Teacher</a>
      <% } %>
    </div>
  <% } else { %>
    <div class="table-wrap">
    <table class="ledger">
      <thead>
        <tr>
          <th>Name</th>
          <th>Teacher ID</th>
          <th>Email</th>
          <th>Employed</th>
          <th>Status</th>
          <th>Attendance manager</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% teachers.forEach(function(t) { %>
          <tr>
            <td><strong><%= t.name %></strong></td>
            <td class="mono"><%= t.teacherId %></td>
            <td><%= t.email %></td>
            <td><%= new Date(t.dateEmployed).toLocaleDateString() %></td>
            <td>
              <% if (t.isSuspended) { %><span class="pill review">Suspended</span>
              <% } else if (t.isWithdrawn) { %><span class="pill error">Withdrawn</span>
              <% } else { %><span class="pill ocr">Active</span><% } %>
            </td>
            <td>
              <form method="POST" action="/staff/<%= t._id %>/toggle-attendance-manager" style="display:inline;">
                <% if (t.isAttendanceManager) { %>
                  <button type="submit" class="pill paid" style="border:none; cursor:pointer;">On — click to remove</button>
                <% } else { %>
                  <button type="submit" class="btn btn-ghost" style="padding:4px 10px;">Make manager</button>
                <% } %>
              </form>
            </td>
            <td style="text-align:right;">
              <a href="/staff/<%= t._id %>/edit" class="btn btn-ghost" style="padding:4px 12px; font-size:13px;">Edit</a>
              <form method="POST" action="/staff/<%= t._id %>/delete" style="display:inline;" data-confirm="Delete <%= t.name %>? This cannot be undone.">
                <button type="submit" class="btn" style="padding:4px 12px; font-size:13px; background:var(--error); color:#fff; border:none;">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>

    <!-- Pagination controls -->
    <% if (pagination && pagination.pages > 1) { %>
      <%
        var qs = '';
        if (filters.search) qs += '&search=' + encodeURIComponent(filters.search);
      %>
      <div class="pagination-bar">
        <span class="pagination-info">
          Page <%= pagination.page %> of <%= pagination.pages %> &middot; <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %>
        </span>
        <div class="pagination-links">
          <% if (pagination.hasPrev) { %>
            <a href="/staff?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">&laquo; Prev</a>
          <% } else { %>
            <span class="page-link disabled">&laquo; Prev</span>
          <% } %>

          <%
            var cur = pagination.page;
            var total = pagination.pages;
            var pages = [];
            pages.push(1);
            for (var i = Math.max(2, cur - 2); i <= Math.min(total - 1, cur + 2); i++) {
              pages.push(i);
            }
            if (total > 1) pages.push(total);
            pages = pages.filter(function(v, idx, arr) { return arr.indexOf(v) === idx; }).sort(function(a, b) { return a - b; });
          %>
          <% var prev = 0; %>
          <% pages.forEach(function(p) { %>
            <% if (p - prev > 1) { %>
              <span class="page-ellipsis">&hellip;</span>
            <% } %>
            <% if (p === cur) { %>
              <span class="page-link active"><%= p %></span>
            <% } else { %>
              <a href="/staff?page=<%= p %>&limit=<%= pagination.limit %><%= qs %>" class="page-link"><%= p %></a>
            <% } %>
            <% prev = p; %>
          <% }); %>

          <% if (pagination.hasNext) { %>
            <a href="/staff?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">Next &raquo;</a>
          <% } else { %>
            <span class="page-link disabled">Next &raquo;</span>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/foot') %>
