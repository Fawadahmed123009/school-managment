<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Staff Attendance</p>
    <h1>Teacher attendance</h1>
  </div>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <a href="/teacher-attendance/history" class="btn btn-ghost">History &amp; hours</a>
    <% if (user.role === 'admin') { %>
      <a href="/teacher-attendance/settings" class="btn btn-ghost">Late-arrival rule</a>
    <% } %>
  </div>
</div>

<% if (ok) { %><div class="flash ok">Attendance saved.</div><% } %>
<% if (error) { %><div class="flash error"><%= error %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load roster: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-body">
    <div class="field" style="max-width:220px;">
      <label for="date-picker">Date</label>
      <input type="date" id="date-picker" value="<%= date %>" data-mark-base="/teacher-attendance" />
    </div>
    <p style="margin:8px 0 0; font-size:13px; color:var(--ink-soft);">
      Arrivals and departures are <strong>captured automatically</strong> from each teacher's first login and
      their logout. Use this page to review and correct — e.g. fill in a departure for a teacher who never
      logged out. A saved correction replaces the auto-captured time.
    </p>
    <p style="margin:6px 0 0; font-size:13px; color:var(--ink-soft);">
      <% if (settings.lateDetectionEnabled) { %>
        Late detection is <strong>on</strong> — each teacher is compared against <strong>their own expected arrival time</strong>
        from the staff profile (+ <%= settings.graceMinutes %> min grace). Teachers without one are not checked.
      <% } else { %>
        Late detection is <strong>off</strong>. <% if (user.role === 'admin') { %><a href="/teacher-attendance/settings">Configure the late-arrival rule</a>.<% } else { %>An admin can enable it.<% } %>
      <% } %>
    </p>
  </div>
</div>

<div class="stats">
  <div class="stat-card accent-blue">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div class="stat-value"><%= summary.marked %> / <%= summary.totalTeachers %></div>
    <div class="stat-label">Teachers marked</div>
  </div>
  <div class="stat-card accent-green">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="stat-value"><%= formatMinutes(summary.totalMinutes) %></div>
    <div class="stat-label">Total working hours (day)</div>
  </div>
  <div class="stat-card accent-gold">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div class="stat-value"><%= summary.lateCount %></div>
    <div class="stat-label">Late arrivals (day)</div>
  </div>
</div>

<% if (roster.length === 0) { %>
  <div class="empty"><div class="display">No active teachers on the roster</div></div>
<% } else { %>
  <form method="POST" action="/teacher-attendance" id="ta-form">
    <input type="hidden" name="date" value="<%= date %>" />
    <input type="hidden" name="records" id="records-input" value="" />
    <div class="panel">
      <div class="panel-head">
        <h2>Arrival &amp; departure — <%= date %></h2>
        <button type="button" class="btn btn-accent" id="save-attendance-btn">Save day</button>
      </div>
      <div class="table-wrap">
        <table class="ledger" id="ta-roster">
          <thead>
            <tr>
              <th>Teacher</th>
              <th>Arrival</th>
              <th>Departure</th>
              <th>Working hours</th>
              <th>Late</th>
            </tr>
          </thead>
          <tbody>
            <% roster.forEach(function(r) { %>
              <tr data-teacher="<%= r.teacher %>" data-name="<%= r.name %>" data-expected="<%= r.expectedArrivalTime %>">
                <td>
                  <strong><%= r.name %></strong>
                  <% if (r.teacherId) { %><div style="font-size:12px; color:var(--ink-soft);"><%= r.teacherId %></div><% } %>
                  <% if (settings.lateDetectionEnabled && !r.expectedArrivalTime) { %><div style="font-size:11px; color:#b45309; margin-top:2px;">no expected arrival set — late check skipped</div><% } %>
                </td>
                <td>
                  <input type="time" class="ta-arrival" value="<%= r.arrivalTime %>" aria-label="Arrival time for <%= r.name %>" />
                  <% if (r.marked && r.arrivalSource === 'login') { %><div style="font-size:11px; color:var(--ink-soft); margin-top:2px;">from login</div><% } %>
                </td>
                <td>
                  <input type="time" class="ta-departure" value="<%= r.departureTime %>" aria-label="Departure time for <%= r.name %>" />
                  <% if (r.marked && r.departureSource === 'logout') { %><div style="font-size:11px; color:var(--ink-soft); margin-top:2px;">from logout</div><% } %>
                  <% if (r.marked && !r.departureTime) { %><div style="font-size:11px; color:#b45309; margin-top:2px;">no logout captured</div><% } %>
                </td>
                <td class="ta-hours mono"><%= r.marked && r.departureTime ? formatMinutes(r.workingMinutes) : '—' %></td>
                <td class="ta-late">
                  <% if (r.marked && r.isLate) { %><span class="pill review">Late +<%= r.lateMinutes %>m</span>
                  <% } else if (r.marked && settings.lateDetectionEnabled && !r.expectedArrivalTime) { %><span class="pill" title="No expected arrival time on this teacher's staff profile — late detection is skipped">not checked</span>
                  <% } else if (r.marked) { %><span class="pill paid">On time</span>
                  <% } else { %>—<% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="panel-body" style="font-size:13px; color:var(--ink-soft);">
        Times are 24-hour, to the minute. Change only what needs correcting — a blank departure side is
        kept from the teacher's logout (if any). Rows you save become manual records; untouched rows keep
        whatever login/logout captured. Saving again for the same date updates the existing records.
      </div>
    </div>
  </form>

  <!-- Per-request data island (CSP-safe: no inline executable script) -->
  <script type="application/json" id="ta-settings"><%- JSON.stringify({ lateDetectionEnabled: settings.lateDetectionEnabled, startTime: settings.startTime, graceMinutes: settings.graceMinutes }) %></script>
  <script src="/js/staff-attendance-mark.js"></script>
<% } %>

<%- include('../partials/foot') %>