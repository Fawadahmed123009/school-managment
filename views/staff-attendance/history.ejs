<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Staff Attendance</p>
    <h1>Teacher attendance history</h1>
  </div>
  <div style="display:flex; gap:8px; flex-wrap:wrap;">
    <a href="/teacher-attendance" class="btn btn-ghost">← Mark attendance</a>
    <% if (user.role === 'admin') { %>
      <a href="/teacher-attendance/settings" class="btn btn-ghost">Late-arrival rule</a>
    <% } %>
  </div>
</div>

<% if (loadError) { %><div class="flash error">Couldn't load history: <%= loadError %></div><% } %>

<!-- ── Filters: teacher + date range ── -->
<div class="panel">
  <div class="panel-body">
    <form method="GET" action="/teacher-attendance/history" class="field-row" style="align-items:flex-end; margin-bottom:0; flex-wrap:wrap; gap:12px;">
      <div class="field" style="min-width:200px;">
        <label for="teacherId">Teacher</label>
        <select name="teacherId" id="teacherId">
          <option value="">All teachers</option>
          <% teachers.forEach(function(t) { %>
            <option value="<%= t._id %>" <%= teacherId === String(t._id) ? 'selected' : '' %>><%= t.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="max-width:180px;">
        <label for="startDate">From</label>
        <input type="date" name="startDate" id="startDate" value="<%= startDate %>" />
      </div>
      <div class="field" style="max-width:180px;">
        <label for="endDate">To</label>
        <input type="date" name="endDate" id="endDate" value="<%= endDate %>" />
      </div>
      <div class="field" style="flex:none;">
        <button type="submit" class="btn btn-primary">View</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Range totals (the working-hours sum Phase 2 salary will use) ── -->
<div class="stats">
  <div class="stat-card accent-green">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="stat-value"><%= formatMinutes(summary.totalMinutes) %></div>
    <div class="stat-label">Total working hours (<%= summary.totalHours %> h)</div>
  </div>
  <div class="stat-card accent-blue">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <div class="stat-value"><%= summary.records %></div>
    <div class="stat-label">Records in range</div>
  </div>
  <div class="stat-card accent-purple">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div class="stat-value"><%= perTeacher.length %></div>
    <div class="stat-label">Teachers with records</div>
  </div>
  <div class="stat-card accent-gold">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
    </div>
    <div class="stat-value"><%= summary.lateCount %></div>
    <div class="stat-label">Late arrivals (range)</div>
  </div>
</div>

<!-- ── Per-teacher totals over the selected range ── -->
<div class="panel">
  <div class="panel-head">
    <h2>Working hours by teacher</h2>
    <span class="chart-subtitle"><%= startDate %> → <%= endDate %></span>
  </div>
  <% if (perTeacher.length === 0) { %>
    <div class="panel-body" style="color:var(--ink-soft);">No attendance recorded in this range.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr><th>Teacher</th><th>Days</th><th>Working hours</th><th>Late arrivals</th></tr>
        </thead>
        <tbody>
          <% perTeacher.forEach(function(t) { %>
            <tr>
              <td><strong><%= t.name %></strong><% if (t.teacherId) { %> <span style="font-size:12px; color:var(--ink-soft);">(<%= t.teacherId %>)</span><% } %></td>
              <td class="mono"><%= t.days %></td>
              <td class="mono"><%= formatMinutes(t.totalMinutes) %> <span style="color:var(--ink-soft);">(<%= t.totalHours %> h)</span></td>
              <td><% if (t.lateCount > 0) { %><span class="pill review"><%= t.lateCount %> late</span><% } else { %>—<% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<!-- ── Date-wise records ── -->
<div class="panel">
  <div class="panel-head">
    <h2>Daily records</h2>
    <span class="chart-subtitle"><%= pagination.total %> record<%= pagination.total !== 1 ? 's' : '' %></span>
  </div>
  <% if (records.length === 0) { %>
    <div class="panel-body" style="color:var(--ink-soft);">Nothing to show for the selected filters.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr><th>Date</th><th>Teacher</th><th>Arrival</th><th>Departure</th><th>Working hours</th><th>Late</th></tr>
        </thead>
        <tbody>
          <% records.forEach(function(r) { %>
            <tr>
              <td class="mono"><%= r.dateKey %></td>
              <td><%= r.teacherName %></td>
              <td class="mono"><%= r.arrivalTime %></td>
              <td class="mono"><%= r.departureTime %></td>
              <td class="mono"><%= r.duration %></td>
              <td>
                <% if (r.isLate) { %><span class="pill review">Late +<%= r.lateMinutes %>m</span>
                <% } else { %><span class="pill paid">On time</span><% } %>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%
      /* Pagination links keep the active filters */
      var qs = '&startDate=' + encodeURIComponent(startDate) + '&endDate=' + encodeURIComponent(endDate);
      if (teacherId) qs += '&teacherId=' + encodeURIComponent(teacherId);
    %>
    <div class="panel-body">
      <div class="pagination-bar">
        <span class="pagination-info">
          Page <%= pagination.page %> of <%= Math.max(pagination.pages, 1) %> &middot; <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %>
        </span>
        <div class="pagination-links">
          <% if (pagination.hasPrev) { %>
            <a href="/teacher-attendance/history?page=<%= pagination.page - 1 %><%= qs %>" class="page-link">&laquo; Prev</a>
          <% } else { %>
            <span class="page-link disabled">&laquo; Prev</span>
          <% } %>
          <% if (pagination.hasNext) { %>
            <a href="/teacher-attendance/history?page=<%= pagination.page + 1 %><%= qs %>" class="page-link">Next &raquo;</a>
          <% } else { %>
            <span class="page-link disabled">Next &raquo;</span>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<%- include('../partials/foot') %>