<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Scan &amp; enter</p>
    <h1>Photo to marks</h1>
  </div>
</div>

<div id="upload-step">
  <div class="panel">
    <div class="panel-head"><h2>Select a test</h2></div>
    <div class="panel-body">
      <% if (!classes || classes.length === 0) { %>
        <div class="empty"><div class="display">No classes assigned</div><p>You are not assigned to teach any classes. Contact your administrator.</p></div>
      <% } else { %>
        <div class="field" style="margin-bottom:12px;">
          <label>1. Select class(es) <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;color:var(--ink-soft);">(one or more)</span></label>
          <div style="display:flex; gap:12px; margin-bottom:6px;">
            <button type="button" id="select-all-classes" class="btn btn-ghost" style="padding:4px 12px; font-size:12px;">Select all</button>
            <button type="button" id="clear-all-classes" class="btn btn-ghost" style="padding:4px 12px; font-size:12px;">Clear</button>
            <span id="class-count" style="font-size:12px; color:var(--ink-soft); align-self:center;"></span>
          </div>
          <div id="class-checkbox-list" style="max-height:280px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:12px 16px;background:#fafbfd;">
            <% var gradeGroups = {}; %>
            <% classes.forEach(function(c) { var g = c.gradeLevel || '—'; (gradeGroups[g] = gradeGroups[g] || []).push(c); }); %>
            <% Object.keys(gradeGroups).forEach(function(g) { var groupClasses = gradeGroups[g]; %>
            <div class="grade-group" data-grade="<%= g %>" style="margin-bottom:10px;">
              <% if (groupClasses.length > 1) { %>
                <label style="display:flex;align-items:center;gap:8px;padding:4px 0;font-size:12px;font-weight:600;text-transform:none;letter-spacing:0;color:var(--ink-soft);border-bottom:1px dashed var(--border);margin-bottom:4px;cursor:pointer;">
                  <input type="checkbox" class="grade-all-cb" />
                  All sections of grade <%= g %>
                </label>
              <% } else { %>
                <div style="font-size:12px;font-weight:600;color:var(--ink-soft);padding:4px 0;border-bottom:1px dashed var(--border);margin-bottom:4px;">Grade <%= g %></div>
              <% } %>
              <% groupClasses.forEach(function(c) { %>
                <label style="display:flex;align-items:center;gap:8px;padding:5px 0 5px 22px;cursor:pointer;font-size:13px;text-transform:none;letter-spacing:0;font-weight:400;color:var(--ink);">
                  <input type="checkbox" name="classLevel" value="<%= c._id %>" class="class-cb" />
                  <%= c.gradeLevel ? c.gradeLevel + ' — ' : '' %><%= c.name %><%= c.group ? ' (' + c.group + ')' : '' %>
                </label>
              <% }); %>
            </div>
            <% }); %>
          </div>
        </div>

        <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top:12px;">
          <div class="field">
            <label for="subject-select">2. Select subject</label>
            <select id="subject-select" disabled required>
              <option value="">Select class(es) first...</option>
            </select>
          </div>

          <div class="field" id="session-field" style="display:none;">
            <label for="session-select">3. Select session</label>
            <select id="session-select" disabled required>
              <option value="">Select a subject first...</option>
            </select>
          </div>
        </div>

        <div style="display:grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top:12px;">
          <div class="field" id="phase-field" style="display:none;">
            <label for="phase-select">4. Select phase</label>
            <select id="phase-select" disabled required>
              <option value="">Select a session first...</option>
            </select>
          </div>

          <div class="field" id="week-field" style="display:none;">
            <label for="week-select">5. Select week</label>
            <select id="week-select" disabled required>
              <option value="">Select a phase first...</option>
            </select>
          </div>
        </div>

        <div class="field" id="test-field" style="margin-top:12px; display:none;">
          <label for="test-select">6. Select test</label>
          <select id="test-select" disabled required>
            <option value="">Select filters first...</option>
          </select>
        </div>

        <!-- Test score scale — appears once a test is chosen, so the teacher can
             fix total/pass marks before scanning (scores are validated against it). -->
        <div class="panel" id="test-settings" style="display:none; margin-top:16px;">
          <div class="panel-head"><h2>Test settings</h2></div>
          <div class="panel-body" style="display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
            <div class="field" style="margin:0;">
              <label for="ocr-total-marks">Total marks</label>
              <input type="number" id="ocr-total-marks" min="1" style="width:110px;" />
            </div>
            <div class="field" style="margin:0;">
              <label for="ocr-pass-marks">Pass marks</label>
              <input type="number" id="ocr-pass-marks" min="0" style="width:110px;" />
            </div>
            <button type="button" class="btn btn-primary" id="ocr-save-marks">Save marks</button>
            <span id="ocr-marks-status" style="font-size:13px; align-self:center;"></span>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <div class="upload-drop" id="upload-drop" style="display:none">
    <div class="display">Drop a photo of the marks sheet</div>
    <p>Typed names, handwritten scores — both are read automatically. You'll confirm everything before it's saved.</p>
    <input type="file" id="photo-input" accept="image/*" style="display:none" />
    <button type="button" class="btn btn-accent" id="pick-photo-btn">Choose photo</button>
  </div>

  <div class="panel cam-capture-panel" id="camera-drop" data-target-input="photo-input" style="display:none">
    <div class="panel-head"><h2>Or take a photo with the camera</h2></div>
    <div class="panel-body">
      <video class="cam-video" autoplay playsinline muted style="width:100%; max-width:640px; border-radius:8px; background:#000;"></video>
      <canvas class="cam-canvas" style="display:none;"></canvas>
      <img class="cam-preview" alt="Captured photo preview" style="display:none; width:100%; max-width:640px; border-radius:8px;" />
      <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
        <button type="button" class="btn btn-primary cam-start">Start camera</button>
        <button type="button" class="btn btn-primary cam-capture" disabled>Capture</button>
        <button type="button" class="btn btn-ghost cam-switch" disabled>Switch camera</button>
        <button type="button" class="btn btn-primary cam-use" disabled>Use photo</button>
        <button type="button" class="btn btn-ghost cam-retake" disabled>Retake</button>
        <button type="button" class="btn btn-ghost cam-stop" disabled>Stop camera</button>
      </div>
      <p class="cam-status hint" style="margin-top:8px;"></p>
      <p class="hint">Every scan is also archived to cloud storage (marks-scans) for reference.</p>
    </div>
  </div>
</div>

<div id="review-step" style="display:none">
  <div class="ocr-layout">
    <div class="ocr-source">
      <img id="source-preview" alt="Uploaded marks sheet" />
      <p class="hint">Check this against the table if a row looks off.</p>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h2>Extracted rows</h2>
        <span id="row-count" class="pill ocr"></span>
      </div>
      <div class="attend-filters" style="padding:0 16px 12px;">
        <div class="attend-filter-field">
          <label for="sort-roll-ocr">Sort by</label>
          <select id="sort-roll-ocr">
            <option value="">Default order</option>
            <option value="rollAsc">Roll number (ascending)</option>
            <option value="rollDesc">Roll number (descending)</option>
          </select>
        </div>
      </div>
      <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr>
            <th>Confidence</th>
            <th>Student</th>
            <th>Roll #</th>
            <th class="num">Score</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="rows-body"></tbody>
      </table>
      </div>
      <div class="review-foot">
        <div class="total">
          <span class="l">Rows to save</span>
          <span id="row-total">0</span>
        </div>
        <div style="display:flex; gap:10px;">
          <button type="button" class="btn btn-ghost" id="rescan-btn">Start over</button>
          <button type="button" class="btn btn-primary" id="save-btn">Save all confirmed rows</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="marks-ocr-students"><%- JSON.stringify(students).replace(/</g, '\\u003c') %></script>
<script src="/js/marks-ocr-review.js"></script>
<script src="/js/ocr-camera.js"></script>

<script src="/js/test-cascade-filters.js"></script>
<script src="/js/test-cascade-ocr.js"></script>

<%- include('../partials/foot') %>
