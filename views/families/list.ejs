<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Administration</p>
    <h1>Families</h1>
  </div>
</div>

<% if (ok) { %><div class="flash ok">Saved.</div><% } %>
<% if (successMsg) { %><div class="flash ok"><%= successMsg %></div><% } %>
<% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load families: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-head">
    <h2>All families</h2>
    <% if (pagination) { %>
      <span class="muted" style="font-size:13px;"><%= pagination.total %> total</span>
    <% } %>
  </div>

  <!-- Filter bar -->
  <div style="padding:16px 24px; border-bottom:1px solid var(--border); background:#fafbfd;">
    <form method="GET" action="/families" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
      <div style="display:flex; flex-direction:column; gap:4px; min-width:240px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Search</label>
        <input type="text" name="search" value="<%= filters.search %>" placeholder="Parent name, family #, or student name…" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;" />
      </div>
      <div style="display:flex; gap:6px; align-items:flex-end;">
        <button type="submit" class="btn btn-primary" style="padding:8px 16px;">Filter</button>
        <% if (filters.search) { %>
          <a href="/families" class="btn btn-ghost" style="padding:8px 12px;">Clear</a>
        <% } %>
      </div>
    </form>
  </div>

  <% if (families.length === 0) { %>
    <div class="empty">
      <div class="display"><%= filters.search ? 'No families match your search' : 'No families yet' %></div>
      <p class="hint" style="margin-top:8px;">
        <%= filters.search ? 'Try a different search term.' : 'Families are created automatically when students are registered with parent details.' %>
      </p>
    </div>
  <% } else { %>
    <div class="table-wrap">
    <table class="ledger">
      <thead>
        <tr>
          <th>Family #</th>
          <th>Parent name</th>
          <th>Relationship</th>
          <th>Phone</th>
          <th>Email</th>
          <th>Students</th>
          <th style="text-align:right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% families.forEach(function(f) { %>
          <tr>
            <td><span class="pill ocr"><%= f.familyNumber || '—' %></span></td>
            <td><strong><%= f.name %></strong></td>
            <td><%= f.relationship %></td>
            <td class="mono"><%= f.phone %></td>
            <td><%= f.email %></td>
            <td>
              <% var childCount = f.children ? f.children.length : 0; %>
              <strong><%= childCount %></strong> <%= childCount === 1 ? 'student' : 'students' %>
            </td>
            <td style="text-align:right;">
              <a href="/families/<%= f._id %>" class="btn btn-ghost" style="padding:4px 12px; font-size:13px;">View &amp; edit</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>

    <!-- Pagination controls -->
    <% if (pagination && pagination.pages > 1) { %>
      <%
        var qs = '';
        if (filters.search) qs += '&search=' + encodeURIComponent(filters.search);
      %>
      <div class="pagination-bar">
        <span class="pagination-info">
          Page <%= pagination.page %> of <%= pagination.pages %> &middot; <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %>
        </span>
        <div class="pagination-links">
          <% if (pagination.hasPrev) { %>
            <a href="/families?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">&laquo; Prev</a>
          <% } else { %>
            <span class="page-link disabled">&laquo; Prev</span>
          <% } %>

          <%
            var cur = pagination.page;
            var total = pagination.pages;
            var pages = [];
            pages.push(1);
            for (var i = Math.max(2, cur - 2); i <= Math.min(total - 1, cur + 2); i++) {
              pages.push(i);
            }
            if (total > 1) pages.push(total);
            pages = pages.filter(function(v, idx, arr) { return arr.indexOf(v) === idx; }).sort(function(a, b) { return a - b; });
          %>
          <% var prev = 0; %>
          <% pages.forEach(function(p) { %>
            <% if (p - prev > 1) { %>
              <span class="page-ellipsis">&hellip;</span>
            <% } %>
            <% if (p === cur) { %>
              <span class="page-link active"><%= p %></span>
            <% } else { %>
              <a href="/families?page=<%= p %>&limit=<%= pagination.limit %><%= qs %>" class="page-link"><%= p %></a>
            <% } %>
            <% prev = p; %>
          <% }); %>

          <% if (pagination.hasNext) { %>
            <a href="/families?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">Next &raquo;</a>
          <% } else { %>
            <span class="page-link disabled">Next &raquo;</span>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/foot') %>
