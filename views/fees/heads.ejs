<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Setup</p>
    <h1>Fee Heads</h1>
  </div>
</div>

<% if (ok) { %><div class="flash ok">Saved.</div><% } %>
<% if (loadError) { %><div class="flash error"><%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>Add a fee head</h2></div>
  <div class="panel-body">
    <form method="POST" action="/fee-heads/create">
      <div class="field-row">
        <div class="field">
          <label for="name">Name</label>
          <input type="text" name="name" id="name" required placeholder="e.g. Tuition, Lab Fee, Transport" />
        </div>
        <div class="field">
          <label for="defaultAmount">Default amount (Rs)</label>
          <input type="number" name="defaultAmount" id="defaultAmount" min="0" value="0" />
        </div>
      </div>
      <div class="field">
        <label for="description">Description (optional)</label>
        <input type="text" name="description" id="description" placeholder="Short description" />
      </div>
      <button type="submit" class="btn btn-primary">Add fee head</button>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel-head"><h2>All fee heads</h2></div>
  <% if (feeHeads.length === 0) { %>
    <div class="empty">
      <div class="display">No fee heads yet</div>
      <p>Create one above to categorise fee records.</p>
    </div>
  <% } else { %>
    <table class="ledger">
      <thead>
        <tr>
          <th>Name</th>
          <th>Description</th>
          <th class="num">Default amount</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% feeHeads.forEach(function(h) { %>
          <tr>
            <td><strong><%= h.name %></strong></td>
            <td><%= h.description || '—' %></td>
            <td class="num mono">Rs <%= Number(h.defaultAmount).toLocaleString() %></td>
            <td><span class="pill <%= h.isActive ? 'paid' : 'pending' %>"><%= h.isActive ? 'Active' : 'Inactive' %></span></td>
            <td>
              <form method="POST" action="/fee-heads/<%= h._id %>/toggle" style="display:inline;">
                <input type="hidden" name="isActive" value="<%= !h.isActive %>" />
                <button type="submit" class="btn btn-ghost" style="padding:6px 10px;"><%= h.isActive ? 'Deactivate' : 'Activate' %></button>
              </form>
              <form method="POST" action="/fee-heads/<%= h._id %>/delete" style="display:inline;" data-confirm="Delete this fee head?">
                <button type="submit" class="btn btn-ghost" style="padding:6px 10px; color:var(--review);">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/foot') %>
