<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Fees</p>
    <h1>Bulk Assign Fees</h1>
  </div>
  <div style="display:flex; gap:8px;">
    <a href="/fees" class="btn btn-ghost">Back to fees</a>
  </div>
</div>

<% if (successMsg) { %><div class="flash ok"><%= successMsg %></div><% } %>
<% if (errorMsg) { %><div class="flash error"><%= errorMsg %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>Assign a fee to many students at once</h2></div>
  <div class="panel-body">
    <p style="color:var(--muted); margin-bottom:16px; font-size:0.9rem;">
      Pick a fee head and a target group. One fee record will be created per student at the fee head's default amount (or a custom override). Students who already have a record for the same fee head will be skipped automatically. Inactive, graduated, and withdrawn students are excluded.
    </p>
    <form method="POST" action="/fees/bulk-assign" id="bulk-assign-form">
      <div class="field-row">
        <div class="field">
          <label for="feeHead">Fee head *</label>
          <select name="feeHead" id="feeHead" required>
            <option value="">— select fee head —</option>
            <% feeHeads.filter(function(h) { return h.isActive; }).forEach(function(h) { %>
              <option value="<%= h._id %>" data-amount="<%= h.defaultAmount %>"><%= h.name %> (Rs <%= Number(h.defaultAmount).toLocaleString() %>)</option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="amount">Amount override (Rs)</label>
          <input type="number" name="amount" id="amount" min="0" placeholder="Leave blank for default" />
          <small style="color:var(--muted); font-size:0.78rem;">Leave empty to use the fee head's default amount.</small>
        </div>
      </div>

      <div class="field-row" style="margin-top:12px;">
        <div class="field">
          <label for="targetType">Assign to *</label>
          <select name="targetType" id="targetType" required>
            <option value="class">Specific class(es)</option>
            <option value="all">All students</option>
          </select>
        </div>
      </div>

      <div class="field" id="class-field" style="margin-top:4px;">
        <label>Classes <span style="font-weight:400;text-transform:none;letter-spacing:0;font-size:11px;color:var(--ink-soft);">(select one or more)</span></label>
        <div style="display:flex; gap:12px; margin-bottom:6px;">
          <button type="button" id="select-all-classes" class="btn btn-ghost" style="padding:4px 12px; font-size:12px;">Select all</button>
          <button type="button" id="clear-all-classes" class="btn btn-ghost" style="padding:4px 12px; font-size:12px;">Clear</button>
          <span id="class-count" style="font-size:12px; color:var(--ink-soft); align-self:center;"></span>
        </div>
        <div id="class-checkbox-list" style="max-height:280px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:12px 16px;background:#fafbfd;">
          <% classes.forEach(function(c) { %>
            <label style="display:flex;align-items:center;gap:8px;padding:5px 0;cursor:pointer;font-size:13px;text-transform:none;letter-spacing:0;font-weight:400;color:var(--ink);">
              <input type="checkbox" name="classLevel" value="<%= c._id %>" class="class-cb" />
              <%= c.gradeLevel %> — <%= c.name %> (<%= c.section || '—' %>)
            </label>
          <% }); %>
        </div>
      </div>

      <!-- Preview panel (populated via AJAX) -->
      <div id="preview-panel" style="display:none; margin-top:20px; border:1px solid var(--border); border-radius:8px; overflow:hidden;">
        <div style="padding:12px 16px; background:#fafbfd; border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:space-between;">
          <strong style="font-size:14px;" id="preview-heading">Preview</strong>
          <span id="preview-loading" style="font-size:12px; color:var(--ink-soft);">Loading…</span>
        </div>
        <div id="preview-body" style="padding:0;"></div>
      </div>

      <!-- Per-student amount overrides (populated by JS from preview data) -->
      <input type="hidden" name="perStudentAmounts" id="perStudentAmounts" value="" />

      <div style="margin-top:20px; display:flex; align-items:center; gap:16px;">
        <button type="submit" class="btn btn-primary" id="submit-btn">Create fee records</button>
        <span id="preview-text" style="color:var(--muted); font-size:0.85rem;"></span>
      </div>
    </form>
  </div>
</div>

<script src="/js/bulk-assign.js"></script>

<%- include('../partials/foot') %>
