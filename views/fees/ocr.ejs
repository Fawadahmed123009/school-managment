<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Scan &amp; enter</p>
    <h1>Photo to ledger</h1>
  </div>
</div>

<div id="upload-step">
  <div class="upload-drop">
    <div class="display">Drop a photo of the fee list</div>
    <p>Typed names, handwritten amounts — both are read automatically. You'll confirm everything before it's saved.</p>
    <input type="file" id="photo-input" accept="image/*" style="display:none" />
    <button type="button" class="btn btn-accent" id="pick-photo-btn">Choose photo</button>
  </div>

  <div class="panel cam-capture-panel" data-target-input="photo-input">
    <div class="panel-head"><h2>Or take a photo with the camera</h2></div>
    <div class="panel-body">
      <video class="cam-video" autoplay playsinline muted style="width:100%; max-width:640px; border-radius:8px; background:#000;"></video>
      <canvas class="cam-canvas" style="display:none;"></canvas>
      <img class="cam-preview" alt="Captured photo preview" style="display:none; width:100%; max-width:640px; border-radius:8px;" />
      <div style="margin-top:12px; display:flex; gap:8px; flex-wrap:wrap;">
        <button type="button" class="btn btn-primary cam-start">Start camera</button>
        <button type="button" class="btn btn-primary cam-capture" disabled>Capture</button>
        <button type="button" class="btn btn-ghost cam-switch" disabled>Switch camera</button>
        <button type="button" class="btn btn-primary cam-use" disabled>Use photo</button>
        <button type="button" class="btn btn-ghost cam-retake" disabled>Retake</button>
        <button type="button" class="btn btn-ghost cam-stop" disabled>Stop camera</button>
      </div>
      <p class="cam-status hint" style="margin-top:8px;"></p>
      <p class="hint">Every scan is also archived to cloud storage (fee-scans) for reference.</p>
    </div>
  </div>
</div>

<div id="review-step" style="display:none">
  <div class="ocr-layout">
    <div class="ocr-source">
      <img id="source-preview" alt="Uploaded fee list" />
      <p class="hint">Check this against the table if a row looks off.</p>
    </div>

    <div class="panel">
      <div class="panel-head">
        <h2>Extracted rows</h2>
        <span id="row-count" class="pill ocr"></span>
      </div>
      <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr>
            <th>Confidence</th>
            <th>Student</th>
            <th class="num">Amount (Rs)</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="rows-body"></tbody>
      </table>
      </div>
      <div class="review-foot">
        <div class="total">
          <span class="l">Total to save</span>
          Rs <span id="total-amount">0</span>
        </div>
        <div style="display:flex; gap:10px;">
          <button type="button" class="btn btn-ghost" id="rescan-btn">Start over</button>
          <button type="button" class="btn btn-primary" id="save-btn">Save all confirmed rows</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="ocr-students"><%- JSON.stringify(students).replace(/</g, '\\u003c') %></script>
<script src="/js/ocr-review.js"></script>
<script src="/js/ocr-camera.js"></script>

<%- include('../partials/foot') %>
