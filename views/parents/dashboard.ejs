<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Parent Portal</p>
    <h1>My Children</h1>
  </div>
</div>

<% if (loadError) { %><div class="flash error"><%= loadError %></div><% } %>
<% if (passwordSuccess) { %><div class="flash" style="background: var(--paid-bg, #f0fdf4); color: var(--paid, #16a34a); border: 1px solid var(--paid, #16a34a);">Password changed successfully.</div><% } %>
<% if (passwordError) { %><div class="flash error"><%= passwordError %></div><% } %>

<% if (profile && profile.children && profile.children.length > 0) { %>
  <div class="stats">
    <div class="stat">
      <div class="n mono"><%= profile.familyNumber || '—' %></div>
      <div class="l">Family number</div>
    </div>
    <div class="stat">
      <div class="n mono"><%= profile.children.length %></div>
      <div class="l">Children enrolled</div>
    </div>
  </div>
  <div class="panel">
    <div class="panel-head"><h2>Your Children</h2></div>
    <div class="panel-body">
      <div class="card-grid">
        <% profile.children.forEach(function(child) { %>
          <% var cAlerts = childAlerts && childAlerts[child._id.toString()] || []; %>
          <div class="card" <%= cAlerts.length > 0 ? 'style="border-left:3px solid var(--error);"' : '' %>>
            <div class="card-body">
              <h3><%= child.name %></h3>
              <p class="muted">Roll # <%= child.rollNumber %></p>
              <% if (child.classLevel) { %>
                <p class="muted">Class: <%= child.classLevel.gradeLevel %> — <%= child.classLevel.name %></p>
              <% } %>

              <% if (cAlerts.length > 0) { %>
              <div style="margin-top:10px;padding:8px 10px;background:rgba(239,68,68,0.04);border-radius:6px;">
                <% cAlerts.forEach(function(a) { %>
                  <div style="font-size:12px;color:var(--error);font-weight:600;padding:2px 0;"><%= a.message %></div>
                <% }); %>
              </div>
              <% } %>

              <div style="display:flex; gap:8px; margin-top:12px;">
                <a href="/child/<%= child._id %>/analysis" class="btn btn-ghost">View Progress</a>
                <a href="/child/<%= child._id %>/fees" class="btn btn-ghost">Fees</a>
              </div>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="panel">
    <div class="empty">
      <div class="display">No children linked yet</div>
      <p>Contact the school office to link your children to your parent account.</p>
    </div>
  </div>
<% } %>

<div class="panel">
  <div class="panel-head"><h2>Change password</h2></div>
  <div class="panel-body">
    <form method="POST" action="/parent-portal/change-password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field-row">
        <div class="field">
          <label for="currentPassword">Current password</label>
          <input type="password" name="currentPassword" id="currentPassword" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="newPassword">New password</label>
          <input type="password" name="newPassword" id="newPassword" required minlength="6" />
          <p class="hint">At least 6 characters, with letters and a number.</p>
        </div>
        <div class="field">
          <label for="confirmPassword">Confirm new password</label>
          <input type="password" name="confirmPassword" id="confirmPassword" required minlength="6" />
        </div>
      </div>
      <div style="margin-top: 12px;">
        <button type="submit" class="btn btn-primary">Change password</button>
      </div>
    </form>
  </div>
</div>

<% /* ── Per-child test-progress + subject-wise charts ── */ %>
<% if (profile && profile.children && profile.children.length > 0) { %>
  <% profile.children.forEach(function(child) { %>
    <% var cid = child._id.toString(); %>
    <% var ca = typeof childAnalyses !== 'undefined' ? childAnalyses[cid] : null; %>
    <% if (ca && ca.marks) { %>
    <div class="panel" style="margin-top:16px;">
      <div class="panel-head"><h2><%= child.name %> — Performance</h2></div>
      <div class="charts-row" style="padding:16px;">
        <div class="panel chart-panel">
          <div class="panel-head"><h2>Test progress <span class="chart-subtitle">Average % by session</span></h2></div>
          <div class="panel-body chart-body">
            <canvas id="progressChart-<%= cid %>"></canvas>
            <div class="chart-empty" id="progressEmpty-<%= cid %>" style="display:none;">No test results yet</div>
          </div>
        </div>
        <div class="panel chart-panel">
          <div class="panel-head"><h2>Subject-wise analysis <span class="chart-subtitle">Average % per subject</span></h2></div>
          <div class="panel-body chart-body">
            <canvas id="subjectChart-<%= cid %>"></canvas>
            <div class="chart-empty" id="subjectEmpty-<%= cid %>" style="display:none;">No test results yet</div>
          </div>
        </div>
      </div>
    </div>
    <script type="application/json" class="child-chart-data" data-child-id="<%= cid %>"><%- JSON.stringify({ progress: ca.marks.progress || [], bySubject: ca.marks.bySubject || [] }).replace(/</g, '\u003c') %></script>
    <% } %>
  <% }); %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="/js/dashboard-charts.js"></script>
<% } %>

<%- include('../partials/foot') %>
