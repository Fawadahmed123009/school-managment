<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<% if (loadError) { %>
  <div class="page-head"><div><h1>Child Progress</h1></div></div>
  <div class="flash error">Couldn't load analysis: <%= loadError %></div>
<% } else if (analysis) { %>
  <div class="page-head">
    <div>
      <p class="eyebrow"><%= analysis.student.classLevel ? analysis.student.classLevel.name : '' %></p>
      <h1><%= analysis.student.name %></h1>
    </div>
    <a href="/parent-portal" class="btn btn-ghost">← Back to children</a>
  </div>

  <div class="stats">
    <div class="stat">
      <div class="n mono"><%= analysis.attendance.percent !== null ? analysis.attendance.percent + '%' : '—' %></div>
      <div class="l">Attendance (<%= analysis.attendance.totalMarked %> days marked)</div>
    </div>
    <div class="stat">
      <div class="n mono"><%= analysis.marks.overallAverage !== null ? analysis.marks.overallAverage + '%' : '—' %></div>
      <div class="l">Overall test average</div>
    </div>
    <div class="stat">
      <div class="n mono">Rs <%= Number(analysis.fees.paid).toLocaleString() %></div>
      <div class="l">Fees paid</div>
    </div>
    <div class="stat">
      <div class="n mono" style="color:var(--review)">Rs <%= Number(analysis.fees.pending).toLocaleString() %></div>
      <div class="l">Fees pending</div>
    </div>
  </div>

  <% /* ── Parent: child alert notices ── */ %>
  <% var cAlerts = []; %>
  <% if (analysis.attendance.percent !== null && analysis.attendance.percent < alertThresholds.ATTENDANCE) { %>
    <% cAlerts.push({ type: 'attendance', message: analysis.student.name + "'s attendance is at " + analysis.attendance.percent + '%' }); %>
  <% } %>
  <% if (analysis.marks.bySubject) { %>
    <% analysis.marks.bySubject.forEach(function(s) { %>
      <% if (s.average < alertThresholds.SCORE) { %>
        <% cAlerts.push({ type: 'score', message: s.average + '% avg in ' + s.subject }); %>
      <% } %>
    <% }); %>
  <% } %>
  <% if (cAlerts.length > 0) { %>
  <div class="panel" style="border-left:4px solid var(--error);margin-bottom:16px;">
    <div class="panel-head"><h2 style="color:var(--error);">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;vertical-align:text-bottom;margin-right:6px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
      Needs attention
    </h2></div>
    <div class="panel-body" style="padding:12px 20px 16px;">
      <% cAlerts.forEach(function(a) { %>
        <div style="font-size:13px;color:var(--error);font-weight:600;padding:4px 0;border-bottom:1px solid var(--border);"><%= a.message %></div>
      <% }); %>
      <p style="font-size:12px;color:var(--ink-soft);margin-top:8px;">Consider speaking with the class teacher for support.</p>
    </div>
  </div>
  <% } %>

  <div class="panel">
    <div class="panel-head"><h2>Attendance breakdown</h2></div>
    <div class="panel-body" style="display:flex; gap:24px;">
      <div><span class="pill paid">Present</span> <%= analysis.attendance.present %></div>
      <div><span class="pill error">Absent</span> <%= analysis.attendance.absent %></div>
      <div><span class="pill review">Late</span> <%= analysis.attendance.late %></div>
    </div>
  </div>

  <div class="charts-row">
    <div class="panel chart-panel">
      <div class="panel-head"><h2>Test progress <span class="chart-subtitle">Average % by session</span></h2></div>
      <div class="panel-body chart-body">
        <canvas id="progressChart"></canvas>
        <div class="chart-empty" id="progressEmpty" style="display:none;">No test results yet</div>
      </div>
    </div>
    <div class="panel chart-panel">
      <div class="panel-head"><h2>Subject-wise performance <span class="chart-subtitle">Average % per subject</span></h2></div>
      <div class="panel-body chart-body">
        <canvas id="subjectChart"></canvas>
        <div class="chart-empty" id="subjectEmpty" style="display:none;">No test results yet</div>
      </div>
    </div>
  </div>

  <% if (analysis.marks.bySession.length === 0) { %>
    <div class="panel"><div class="empty"><div class="display">No test results yet</div></div></div>
  <% } else { %>
    <% analysis.marks.bySession.forEach(function(sessionBlock) { %>
      <div class="panel">
        <div class="panel-head">
          <h2><%= sessionBlock.session %></h2>
          <% if (sessionBlock.average !== null) { %><span class="pill ocr">Average: <%= sessionBlock.average %>%</span><% } %>
        </div>
        <div class="table-wrap">
        <table class="ledger">
          <thead><tr><th>Subject</th><th>Test</th><th>Date</th><th class="num">Score</th><th class="num">Total</th><th>%</th></tr></thead>
          <tbody>
            <% sessionBlock.tests.forEach(function(t) { %>
              <tr>
                <td><%= t.subject %></td>
                <td><%= t.test %></td>
                <td><%= new Date(t.date).toLocaleDateString() %></td>
                <td class="num mono"><%= t.score %></td>
                <td class="num mono"><%= t.totalMarks %></td>
                <td><%= t.percent !== null ? t.percent + '%' : '—' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      </div>
    <% }); %>
  <% } %>

  <div class="panel">
    <div class="panel-head"><h2>Fee records</h2></div>
    <% if (analysis.fees.records.length === 0) { %>
      <div class="empty"><div class="display">No fee records yet</div></div>
    <% } else { %>
      <div class="table-wrap">
      <table class="ledger">
        <thead><tr><th>Fee Head</th><th>Type</th><th class="num">Amount</th><th>Status</th><th>Date Paid</th></tr></thead>
        <tbody>
          <% analysis.fees.records.forEach(function(f) { %>
            <tr>
              <td><%= f.feeHead ? f.feeHead.name : '—' %></td>
              <td><%= f.feeType %></td>
              <td class="num mono">Rs <%= Number(f.amount).toLocaleString() %></td>
              <td><span class="pill <%= f.status %>"><%= f.status %></span></td>
              <td><%= f.datePaid ? new Date(f.datePaid).toLocaleDateString() : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script type="application/json" id="analysis-data"><%- JSON.stringify({ progress: analysis.marks.progress || [], bySubject: analysis.marks.bySubject || [] }).replace(/</g, '\\u003c') %></script>
  <script src="/js/analysis-charts.js"></script>
<% } else { %>
  <div class="panel"><div class="empty"><div class="display">No data available</div></div></div>
<% } %>

<%- include('../partials/foot') %>
