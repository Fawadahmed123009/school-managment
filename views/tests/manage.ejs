<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Tests</p>
    <h1>Manage tests</h1>
  </div>
  <div style="display:flex;gap:8px;">
    <a href="/sessions/manage" class="btn btn-ghost">Manage sessions →</a>
  </div>
</div>

<% if (ok) { %><div class="flash ok">Saved.</div><% } %>
<% if (createError) { %><div class="flash error"><%= createError %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load tests: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>Create a test</h2></div>
  <div class="panel-body">
    <form method="POST" action="/tests/create">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field-row">
        <div class="field">
          <label for="name">Test name</label>
          <input type="text" name="name" id="name" required />
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <select name="subject" id="subject" required>
            <option value="">Select a subject</option>
            <% subjects.forEach(function(s) { %>
              <option value="<%= s._id %>"><%= s.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="field">
        <label>Classes / sections</label>
        <div id="cpicker-manage" data-cpicker data-cpicker-source="cpicker-manage-classes" data-cpicker-field="classLevels" data-cpicker-required></div>
        <p class="hint">Select classes to include — this creates one unified roster across all selected.</p>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="date">Date</label>
          <input type="date" name="date" id="date" required />
        </div>
        <div class="field">
          <label for="totalMarks">Total marks</label>
          <input type="number" name="totalMarks" id="totalMarks" required />
        </div>
        <div class="field">
          <label for="passMarks">Pass marks</label>
          <input type="number" name="passMarks" id="passMarks" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="session">Session</label>
          <select name="session" id="session">
            <option value="">Standalone test — no session</option>
            <% sessions.forEach(function(s) { %>
              <option value="<%= s._id %>" data-phases='<%- JSON.stringify(s.phases) %>'><%= s.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field" id="phase-field" style="display:none;">
          <label for="phase">Phase</label>
          <select name="phase" id="phase">
            <option value="">—</option>
          </select>
        </div>
        <div class="field" id="week-field" style="display:none;">
          <label for="week">Week</label>
          <select name="week" id="week">
            <option value="">Select a week</option>
          </select>
          <p class="hint" id="week-hint"></p>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Create test</button>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel-head"><h2>All tests</h2></div>
  <% if (tests.length === 0) { %>
    <div class="empty"><div class="display">No tests yet</div></div>
  <% } else { %>
    <%
      // Category keys are written on every row so the cascade dropdowns below
      // can be built purely from the tests that actually exist.
      const NONE_KEY = 'none';
      const catKey = (value) => (value ? String(value) : NONE_KEY);
      const categoryOptions = [
        { id: 'filter-session', label: 'Session', all: 'All sessions' },
        { id: 'filter-phase', label: 'Phase', all: 'All phases' },
        { id: 'filter-week', label: 'Week', all: 'All weeks' },
      ];
    %>
    <div class="panel-body" style="padding-bottom:8px;">
      <div class="field-row" style="align-items:flex-end;margin-bottom:0;">
        <% categoryOptions.forEach(function(c) { %>
          <div class="field" style="flex:0 1 220px;min-width:170px;">
            <label for="<%= c.id %>"><%= c.label %></label>
            <select id="<%= c.id %>">
              <option value=""><%= c.all %></option>
            </select>
          </div>
        <% }); %>
        <div class="field" style="flex:0 0 auto;min-width:0;">
          <button type="button" id="filter-reset" class="btn btn-ghost" style="display:none;">Clear filters</button>
        </div>
      </div>
      <p class="hint" id="filter-count" style="color:var(--ink-soft);font-size:13px;margin:6px 0 0;"></p>
    </div>
    <div class="table-wrap">
    <table class="ledger">
      <thead><tr><th>Name</th><th>Subject</th><th>Classes</th><th>Session</th><th>Phase</th><th>Week</th><th class="num">Total</th><th></th></tr></thead>
      <tbody id="tests-tbody">
        <% tests.forEach(function(t) { %>
          <tr
            data-session="<%= catKey(t.session && t.session._id) %>"
            data-session-name="<%= t.session ? t.session.name : 'Standalone' %>"
            data-phase="<%= catKey(t.phase) %>"
            data-phase-name="<%= t.phase && phaseNames[t.phase] ? phaseNames[t.phase] : 'No phase' %>"
            data-week="<%= catKey(t.week && t.week._id) %>"
            data-week-name="<%= t.week ? t.week.name : 'No week' %>"
          >
            <td><strong><%= t.name %></strong></td>
            <td><%= t.subject ? t.subject.name : '—' %></td>
            <td><%= t.classLevels.map(function(c) { return c.name; }).join(', ') %></td>
            <td><%= t.session ? t.session.name : 'Standalone' %></td>
            <td><%= t.phase && phaseNames[t.phase] ? phaseNames[t.phase] : '—' %></td>
            <td><%= t.week ? t.week.name : '—' %></td>
            <td class="num mono"><%= t.totalMarks %></td>
            <td style="display:flex;gap:6px;justify-content:flex-end;">
              <a href="/tests/<%= t._id %>/result-sheet" class="btn btn-ghost" style="padding:4px 10px;">Results</a>
              <form method="POST" action="/tests/<%= t._id %>/delete" data-confirm="Delete this test and ALL submitted scores? This cannot be undone." style="display:inline;">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="btn btn-ghost" style="padding:4px 10px;color:var(--error);">Delete</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
    <div class="empty" id="filter-empty" style="display:none;"><div class="display">No tests in this category</div>Try a broader session, phase or week selection.</div>
  <% } %>
</div>

<script type="application/json" id="cpicker-manage-classes"><%- JSON.stringify(classes).replace(/</g, '\\u003c') %></script>
<script src="/js/class-picker.js"></script>
<script src="/js/test-manage.js"></script>
<script src="/js/test-manage-filter.js"></script>

<%- include('../partials/foot') %>
