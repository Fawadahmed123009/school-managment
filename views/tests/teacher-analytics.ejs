<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Analytics</p>
    <h1>My performance</h1>
  </div>
</div>

<% if (loadError) { %><div class="flash error">Couldn't load data: <%= loadError %></div><% } %>

<% if (classes.length === 0 && subjects.length === 0) { %>
  <div class="empty">
    <div class="display">No assignments yet</div>
    <p>You are not currently assigned to teach any subjects. Contact your administrator.</p>
  </div>
<% } else { %>

<!-- ── Filters: Session → Grade → Phase → Week → Subject → Test ───────── -->
<%
  // Cascade option sets, all derived from the teacher-scoped test snapshot so
  // every dropdown only ever offers options that contain one of the teacher's
  // tests. public/js/teacher-analytics-cascade.js narrows these further as the
  // upstream selections change (each option carries data-* scope keys).
  var sessionNameById = {};
  sessions.forEach(function (s) { sessionNameById[String(s._id)] = s.name; });
  var phaseNameById = {};
  sessions.forEach(function (s) {
    (s.phases || []).forEach(function (p) { phaseNameById[String(p._id)] = p.name; });
  });
  var gradeRank = function (g) { return g === 'PG' ? -1 : (parseInt(g, 10) || 9999); };
  var gradeSet = {}, gradesInScope = [];
  var phaseSet = {}, phasesInScope = [];
  var weekMap = {};
  (testSnapshot || []).forEach(function (t) {
    (t.grades || []).forEach(function (g) {
      var key = String(g);
      if (!gradeSet[key]) { gradeSet[key] = true; gradesInScope.push(key); }
    });
    if (t.phase && !phaseSet[t.phase]) { phaseSet[t.phase] = true; phasesInScope.push(t.phase); }
    if (t.week && !weekMap[t.week]) weekMap[t.week] = { name: t.weekName || 'Week', session: t.session, phase: t.phase };
  });
  gradesInScope.sort(function (a, b) { return gradeRank(a) - gradeRank(b); });
  var multiSession = Object.keys(sessionNameById).length > 1;
%>
<div class="panel">
  <div class="panel-body">
    <form method="GET" action="/teacher/analytics" class="field-row" style="align-items:flex-end; margin-bottom:0; flex-wrap:wrap;">
      <div class="field" style="min-width:160px;flex:1 1 160px;">
        <label for="ta-session">Session</label>
        <select name="sessionId" id="ta-session">
          <option value="">All sessions</option>
          <% (testSnapshot || []).map(function (t) { return t.session; }).filter(Boolean).filter(function (id, i, arr) { return arr.indexOf(id) === i; }).forEach(function (sid) { %>
            <option value="<%= sid %>" <%= filters.sessionId === sid ? 'selected' : '' %>><%= sessionNameById[sid] || 'Session' %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="min-width:140px;flex:1 1 140px;">
        <label for="ta-grade">Grade</label>
        <select name="grade" id="ta-grade">
          <option value="">All grades</option>
          <% gradesInScope.forEach(function (g) { %>
            <option value="<%= g %>" <%= filters.grade === g ? 'selected' : '' %>>Grade <%= g %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="min-width:160px;flex:1 1 160px;">
        <label for="ta-phase">Phase</label>
        <select name="phase" id="ta-phase">
          <option value="">All phases</option>
          <% phasesInScope.forEach(function (pid) { var owner = (testSnapshot || []).find(function (t) { return t.phase === pid; }) || {}; %>
            <option value="<%= pid %>" data-session="<%= owner.session || '' %>" <%= filters.phase === pid ? 'selected' : '' %>><%= phaseNameById[pid] || 'Phase' %><%= multiSession && owner.session ? ' (' + (sessionNameById[owner.session] || 'session') + ')' : '' %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="min-width:160px;flex:1 1 160px;">
        <label for="ta-week">Week</label>
        <select name="week" id="ta-week">
          <option value="">All weeks</option>
          <% Object.keys(weekMap).forEach(function (wid) { var w = weekMap[wid]; %>
            <option value="<%= wid %>" data-session="<%= w.session || '' %>" data-phase="<%= w.phase || '' %>" <%= filters.week === wid ? 'selected' : '' %>><%= w.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="min-width:160px;flex:1 1 160px;">
        <label for="ta-subject">Subject</label>
        <select name="subject" id="ta-subject">
          <option value="">All my subjects</option>
          <% subjects.forEach(function (s) { %>
            <option value="<%= s._id %>" <%= filters.subject === String(s._id) ? 'selected' : '' %>><%= s.displayName || s.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="min-width:200px;flex:1 1 200px;">
        <label for="ta-test">Test</label>
        <select name="testId" id="ta-test">
          <option value="">All tests</option>
          <% (testSnapshot || []).forEach(function (t) { %>
            <option value="<%= t._id %>"
              data-session="<%= t.session %>"
              data-grade="<%= (t.grades || []).join(',') %>"
              data-phase="<%= t.phase %>"
              data-week="<%= t.week %>"
              data-subject="<%= t.subjectId %>"
              <%= filters.testId === t._id ? 'selected' : '' %>><%= t.name %><%= t.subjectName ? ' \u2014 ' + t.subjectName : '' %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="flex:none;">
        <button type="submit" class="btn btn-primary">Apply</button>
        <a href="/teacher/analytics" class="btn btn-ghost" style="text-decoration:none;">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- ── Overall stats ───────────────────────────────────────── -->
<% if (overallStats) { %>
<div class="stats">
  <div class="stat">
    <div class="n mono"><%= overallStats.avg %>%</div>
    <div class="l">Average score</div>
  </div>
  <div class="stat">
    <div class="n mono" style="color:var(--paid);"><%= overallStats.max %>%</div>
    <div class="l">Highest score</div>
  </div>
  <div class="stat">
    <div class="n mono" style="color:var(--error);"><%= overallStats.min %>%</div>
    <div class="l">Lowest score</div>
  </div>
  <div class="stat">
    <div class="n mono"><%= overallStats.count %></div>
    <div class="l">Total results</div>
  </div>
</div>
<% } %>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- SECTION 1 — PER-CLASS AVERAGES                            -->
<!-- ══════════════════════════════════════════════════════════ -->
<div class="panel" style="margin-top:24px;">
  <div class="panel-head"><h2>Per-class averages</h2></div>
  <% if (perClass.length === 0) { %>
    <div class="panel-body">
      <div class="empty" style="padding:24px 0;">
        <div class="display">No data available</div>
        <p>No test results found for the selected filters.</p>
      </div>
    </div>
  <% } else { %>
    <div class="table-wrap">
    <table class="ledger">
      <thead>
        <tr><th>Class</th><th class="num">Avg %</th><th class="num">Min %</th><th class="num">Max %</th><th class="num">Results</th></tr>
      </thead>
      <tbody>
        <% perClass.forEach(function(c) { %>
          <tr>
            <td><strong><%= c.className %></strong></td>
            <td class="num mono"><%= c.avg !== null ? c.avg + '%' : '—' %></td>
            <td class="num mono"><%= c.min !== null ? c.min + '%' : '—' %></td>
            <td class="num mono"><%= c.max !== null ? c.max + '%' : '—' %></td>
            <td class="num mono"><%= c.count %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<!-- ══════════════════════════════════════════════════════════ -->
<!-- SECTION 2 — PER-SESSION AVERAGES                          -->
<!-- ══════════════════════════════════════════════════════════ -->
<div class="panel" style="margin-top:24px;">
  <div class="panel-head"><h2>Per-session averages</h2></div>
  <% if (perSession.length === 0) { %>
    <div class="panel-body">
      <div class="empty" style="padding:24px 0;">
        <div class="display">No session data</div>
        <p>No tests with sessions found for the selected filters, or no sessions exist yet.</p>
      </div>
    </div>
  <% } else { %>
    <div class="table-wrap">
    <table class="ledger">
      <thead>
        <tr><th>Session</th><th class="num">Avg %</th><th class="num">Min %</th><th class="num">Max %</th><th class="num">Results</th></tr>
      </thead>
      <tbody>
        <% perSession.forEach(function(s) { %>
          <tr>
            <td><strong><%= s.sessionName %></strong></td>
            <td class="num mono"><%= s.avg !== null ? s.avg + '%' : '—' %></td>
            <td class="num mono"><%= s.min !== null ? s.min + '%' : '—' %></td>
            <td class="num mono"><%= s.max !== null ? s.max + '%' : '—' %></td>
            <td class="num mono"><%= s.count %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  <% } %>
</div>

<% } %>

<script src="/js/teacher-analytics-cascade.js"></script>

<%- include('../partials/foot') %>
