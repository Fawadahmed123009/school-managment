<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Tests</p>
    <h1>Analytics</h1>
  </div>
</div>

<% if (loadError) { %><div class="flash error"><%= loadError %></div><% } %>

<!-- ── View mode toggle ─────────────────────────────────── -->
<div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap;">
  <a href="/tests/analytics" class="btn <%= (!viewMode || viewMode === 'single') ? 'btn-primary' : 'btn-ghost' %>">Single test</a>
  <a href="/tests/analytics?viewMode=trend&mode=student" class="btn <%= viewMode === 'trend' && (!trendMode || trendMode === 'student') ? 'btn-primary' : 'btn-ghost' %>">Trend — Student</a>
  <a href="/tests/analytics?viewMode=trend&mode=class" class="btn <%= viewMode === 'trend' && trendMode === 'class' ? 'btn-primary' : 'btn-ghost' %>">Trend — Class</a>
  <a href="/tests/analytics?viewMode=combined" class="btn <%= viewMode === 'combined' ? 'btn-primary' : 'btn-ghost' %>">Combined subject</a>
</div>

<% if (viewMode === 'trend') { %>
  <!-- ════════════════════════════════════════════════════════ -->
  <!-- ── TREND MODE ──────────────────────────────────────── -->
  <!-- ════════════════════════════════════════════════════════ -->

  <div class="panel">
    <div class="panel-head"><h2><%= trendMode === 'class' ? 'Class trend filters' : 'Student trend filters' %></h2></div>
    <div class="panel-body">
      <form method="GET" action="/tests/analytics">
        <input type="hidden" name="viewMode" value="trend" />
        <input type="hidden" name="mode" value="<%= trendMode || 'student' %>" />
        <!-- Unified filter cascade (same shared partial + JS as the PDF Reports
             page, fresh 'ax' prefix): Session → Grade → Section → Student →
             Subject → Test. Grade/Section are translated to class ids by the
             view route and Session/Grade/Section/Student/Subject feed the trend
             service; the Test level only narrows the picker (a trend spans
             every matching test). Client-side wiring: #report-class-scope +
             #ax-filter-state islands below. -->
        <%- include('../reports/partials/filter-cascade', { idp: 'ax', namep: 'ax', sessions: sessions, subjects: subjects, tests: tests, students: students }) %>
        <button type="submit" class="btn btn-primary">Apply filters</button>
      </form>
    </div>
  </div>

  <% if (trendLines.length === 0 && trendTableRows.length === 0) { %>
    <div class="empty"><div class="display"><%= !filters.studentId && trendMode !== 'class' ? 'Select a student to see trends' : (!filters.subjectId && trendMode === 'class' ? 'Select a subject to see class trends' : 'No trend data for those filters') %></div></div>
  <% } else { %>

    <!-- ── Trend chart ─────────────────────────────────────── -->
    <div class="panel">
      <div class="panel-head"><h2><%= trendMode === 'class' ? 'Class average trend' : 'Student score trend' %></h2></div>
      <div class="chart-body" style="height:320px; padding:16px;">
        <canvas id="trendChart"></canvas>
      </div>
    </div>

    <!-- ── Trend data table ────────────────────────────────── -->
    <% if (trendTableRows.length > 0) { %>
      <div class="panel">
        <div class="panel-head"><h2>Test details</h2></div>
        <div class="table-wrap">
        <table class="ledger">
          <thead>
            <% if (trendMode === 'class') { %>
              <tr><th>Class</th><th>Test</th><th>Date</th><th class="num">Avg %</th><th class="num">Min %</th><th class="num">Max %</th><th class="num">Students</th></tr>
            <% } else { %>
              <tr><th>Test</th><th>Date</th><th>Subject</th><th class="num">Score</th><th class="num">Total</th><th class="num">%</th></tr>
            <% } %>
          </thead>
          <tbody>
            <% if (trendMode === 'class') { %>
              <% trendTableRows.forEach(function(r) { %>
                <tr>
                  <td><%= r.className %></td>
                  <td><strong><%= r.testName %></strong></td>
                  <td><%= new Date(r.date).toLocaleDateString() %></td>
                  <td class="num mono"><%= r.avgPercent %>%</td>
                  <td class="num mono"><%= r.minPercent %>%</td>
                  <td class="num mono"><%= r.maxPercent %>%</td>
                  <td class="num mono"><%= r.count %></td>
                </tr>
              <% }); %>
            <% } else { %>
              <% trendTableRows.forEach(function(r) { %>
                <tr>
                  <td><strong><%= r.testName %></strong></td>
                  <td><%= new Date(r.date).toLocaleDateString() %></td>
                  <td><%= r.subjectDisplay || r.subjectName %></td>
                  <td class="num mono"><%= r.score %></td>
                  <td class="num mono"><%= r.totalMarks %></td>
                  <td><%= r.percent !== null ? r.percent + '%' : '—' %></td>
                </tr>
              <% }); %>
            <% } %>
          </tbody>
        </table>
        </div>
      </div>
    <% } %>

    <!-- ── Chart data island (CSP-safe) ────────────────────── -->
    <script type="application/json" id="trend-chart-data">{
      "trendMode": <%- JSON.stringify(trendMode) %>,
      "trendLines": <%- JSON.stringify(trendLines) %>,
      "trendTableRows": <%- JSON.stringify(trendTableRows) %>
    }</script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="/js/trend-charts.js"></script>
  <% } %>

<% } else if (viewMode === 'combined') { %>
  <!-- ════════════════════════════════════════════════════════ -->
  <!-- ── COMBINED-SUBJECT MODE ──────────────────────────── -->
  <!-- ════════════════════════════════════════════════════════ -->

  <div class="panel">
    <div class="panel-head"><h2>Filters</h2></div>
    <div class="panel-body">
      <form method="GET" action="/tests/analytics">
        <input type="hidden" name="viewMode" value="combined" />
        <!-- Same unified cascade as the other modes. Here leave the Test level
             on "All tests" and pick a Subject — the page then pools every test of
             that subject in scope. -->
        <%- include('../reports/partials/filter-cascade', { idp: 'ax', namep: 'ax', sessions: sessions, subjects: subjects, tests: tests, students: students }) %>
        <div class="field-row">
          <div class="field">
            <label for="sortBy">Sort by</label>
            <select name="sortBy" id="sortBy">
              <option value="" <%= !filters.sortBy ? 'selected' : '' %>>Name (A–Z)</option>
              <option value="rollAsc" <%= filters.sortBy === 'rollAsc' ? 'selected' : '' %>>Roll number (ascending)</option>
              <option value="rollDesc" <%= filters.sortBy === 'rollDesc' ? 'selected' : '' %>>Roll number (descending)</option>
            </select>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Apply filters</button>
      </form>
    </div>
  </div>

  <% if (!combined.active) { %>
    <div class="empty"><div class="display">Pick a Subject (leave Test on &ldquo;All tests&rdquo;) to combine every test of that subject</div></div>
  <% } else if (!combined.pooled || combined.pooled.count === 0) { %>
    <div class="empty"><div class="display">No results for that subject in the selected scope</div></div>
  <% } else { %>

    <div style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:8px;">
      <div style="font-size:13px; color:var(--ink-soft); font-weight:500;">
        Combined: <strong style="color:var(--ink);"><%= combined.subject ? (combined.subject.displayName || combined.subject.name) : 'Subject' %></strong>
        · <span class="mono"><%= combined.columns.length %></span> test<%= combined.columns.length !== 1 ? 's' : '' %>
      </div>
      <a class="btn btn-primary" href="/tests/analytics/pdf?<%= pdfQuery %>">Download PDF</a>
    </div>

    <!-- ── Pooled stat cards (percent-normalised across all combined tests) ── -->
    <div class="stats">
      <div class="stat">
        <div class="n mono"><%= combined.resultCount %></div>
        <div class="l">Students</div>
      </div>
      <div class="stat">
        <div class="n mono"><%= combined.pooled.count %></div>
        <div class="l">Test attempts</div>
      </div>
      <div class="stat">
        <div class="n mono"><%= combined.pooled.avg %>%</div>
        <div class="l">Combined average</div>
      </div>
      <div class="stat">
        <div class="n mono"><%= combined.pooled.max %>%</div>
        <div class="l">Highest pupil</div>
      </div>
      <div class="stat">
        <div class="n mono"><%= combined.pooled.min %>%</div>
        <div class="l">Lowest pupil</div>
      </div>
      <div class="stat">
        <div class="n mono"><%= combined.pooled.stddev %></div>
        <div class="l">Std deviation</div>
      </div>
    </div>

    <!-- ── Pooled percentage distribution ─────────────────── -->
    <% if (combined.distribution && combined.distribution.length) { %>
      <div class="panel">
        <div class="panel-head"><h2>Score distribution (%)</h2></div>
        <div class="chart-body" style="height:280px; padding:16px;">
          <canvas id="distributionChart"></canvas>
        </div>
      </div>
    <% } %>

    <!-- ── Per-test breakdown ─────────────────────────────── -->
    <div class="panel">
      <div class="panel-head"><h2>Per-test breakdown</h2></div>
      <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr><th>Test</th><th>Date</th><th class="num">Out of</th><th class="num">Students</th><th class="num">Avg %</th><th class="num">Min %</th><th class="num">Max %</th></tr>
        </thead>
        <tbody>
          <% combined.perTest.forEach(function(t) { %>
            <tr>
              <td><strong><%= t.name %></strong></td>
              <td><%= new Date(t.date).toLocaleDateString() %></td>
              <td class="num mono"><%= t.totalMarks %></td>
              <td class="num mono"><%= t.count %></td>
              <td class="num mono"><%= t.avg !== null ? t.avg + '%' : '—' %></td>
              <td class="num mono"><%= t.min !== null ? t.min + '%' : '—' %></td>
              <td class="num mono"><%= t.max !== null ? t.max + '%' : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>

    <!-- ── Combined marks list (one row per pupil, one cell per test) ── -->
    <% if (combined.marksRows && combined.marksRows.length) { %>
      <div class="panel">
        <div class="panel-head">
          <h2>Combined marks list</h2>
          <span class="muted" style="font-size:13px;"><%= combined.resultCount %> student<%= combined.resultCount !== 1 ? 's' : '' %></span>
        </div>
        <div class="table-wrap" style="overflow-x:auto;">
        <table class="ledger">
          <thead>
            <tr>
              <th>Roll #</th><th>Name</th>
              <% combined.columns.forEach(function(c) { %><th class="num"><%= c.name %></th><% }); %>
              <th class="num">Overall %</th>
            </tr>
          </thead>
          <tbody>
            <% combined.marksRows.forEach(function(r) { %>
              <tr>
                <td class="mono"><%= r.rollNumber %></td>
                <td><strong><%= r.name %></strong> <span class="mono" style="color:var(--ink-soft); font-size:12px;"><%= r.studentIdStr %></span></td>
                <% combined.columns.forEach(function(c) {
                     var cell = r.cells[c.testId];
                     var text = '—';
                     if (cell) { text = cell.absent ? 'A' : (cell.percent !== null ? cell.percent + '%' : '—'); }
                   %>
                  <td class="num mono"><%= text %></td>
                <% }); %>
                <td class="num mono"><strong><%= r.overallPercent !== null ? r.overallPercent + '%' : '—' %></strong></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        </div>
      </div>
    <% } %>

    <!-- ── Chart data island (CSP-safe) ────────────────────── -->
    <script type="application/json" id="analytics-chart-data">{
      "distribution": <%- JSON.stringify(combined.distribution) %>,
      "current": null,
      "previous": null
    }</script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script src="/js/test-analytics-charts.js"></script>

  <% } %>

<% } else { %>
  <!-- ════════════════════════════════════════════════════════ -->
  <!-- ── SINGLE-TEST MODE (existing) ─────────────────────── -->
  <!-- ════════════════════════════════════════════════════════ -->

<div class="panel">
  <div class="panel-head"><h2>Filters</h2></div>
  <div class="panel-body">
    <form method="GET" action="/tests/analytics">
      <!-- Unified filter cascade (same shared partial + JS as the PDF Reports
           page, fresh 'ax' prefix): Session → Grade → Section → Student →
           Subject → Test. The searchable Student picker replaces the old
           name/roll free-text search; grade/section are translated to class
           ids by the view route. A Test must be picked for results — the
           levels above it only narrow this dropdown (and the result set).
           Selection survives the GET reload via #ax-filter-state below. -->
      <%- include('../reports/partials/filter-cascade', { idp: 'ax', namep: 'ax', sessions: sessions, subjects: subjects, tests: tests, students: students }) %>
      <div class="field-row">
        <div class="field">
          <label for="sortBy">Sort by</label>
          <select name="sortBy" id="sortBy">
            <option value="" <%= !filters.sortBy ? 'selected' : '' %>>Name (A–Z)</option>
            <option value="rollAsc" <%= filters.sortBy === 'rollAsc' ? 'selected' : '' %>>Roll number (ascending)</option>
            <option value="rollDesc" <%= filters.sortBy === 'rollDesc' ? 'selected' : '' %>>Roll number (descending)</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Apply filters</button>
    </form>
  </div>
</div>

<% if (!hasFilters) { %>
  <div class="empty"><div class="display">Select a test to see analytics</div></div>
<% } else if (!current || current.count === 0) { %>
  <div class="empty"><div class="display">No results match those filters</div></div>
<% } else { %>

  <!-- ── Current test stat cards ─────────────────────────── -->
  <div style="margin-bottom:8px; font-size:13px; color:var(--ink-soft); font-weight:500;">
    Current test: <strong style="color:var(--ink);"><%= current.testName %></strong>
    <% if (current.totalMarks) { %> · out of <span class="mono"><%= current.totalMarks %></span><% } %>
    <% if (current.testDate) { %> · <%= new Date(current.testDate).toLocaleDateString() %><% } %>
  </div>
  <div class="stats">
    <div class="stat">
      <div class="n mono"><%= current.count %></div>
      <div class="l">Students</div>
    </div>
    <div class="stat">
      <div class="n mono"><%= current.avg %></div>
      <div class="l">Average</div>
    </div>
    <div class="stat">
      <div class="n mono"><%= current.max %></div>
      <div class="l">Highest</div>
    </div>
    <div class="stat">
      <div class="n mono"><%= current.min %></div>
      <div class="l">Lowest</div>
    </div>
    <div class="stat">
      <div class="n mono"><%= current.stddev %></div>
      <div class="l">Std deviation</div>
    </div>
  </div>

  <!-- ── Distribution chart ──────────────────────────────── -->
  <div class="panel">
    <div class="panel-head"><h2>Mark distribution</h2></div>
    <div class="chart-body" style="height:280px; padding:16px;">
      <canvas id="distributionChart"></canvas>
    </div>
  </div>

  <!-- ── Comparison with previous test ───────────────────── -->
  <% if (previous && previous.count > 0) { %>
    <div style="margin:28px 0 8px; font-size:13px; color:var(--ink-soft); font-weight:500;">
      Comparison: <strong style="color:var(--ink);"><%= current.testName %></strong> vs
      <strong style="color:var(--ink);"><%= previous.testName %></strong>
      <% if (previous.testDate) { %> (<%= new Date(previous.testDate).toLocaleDateString() %>)<% } %>
    </div>
    <div class="stats">
      <div class="stat">
        <div class="l" style="margin-bottom:6px;">Average</div>
        <div style="display:flex; gap:12px; align-items:baseline;">
          <span class="n mono" style="font-size:20px; color:var(--partial);"><%= current.avg %></span>
          <span style="color:var(--ink-soft); font-size:13px;">vs</span>
          <span class="n mono" style="font-size:20px; color:var(--ink-soft);"><%= previous.avg %></span>
          <% var avgDiff = (current.avg - previous.avg).toFixed(2); %>
          <span class="mono" style="font-size:12px; color:<%= avgDiff >= 0 ? 'var(--paid)' : 'var(--error)' %>;">
            <%= avgDiff >= 0 ? '+' : '' %><%= avgDiff %>
          </span>
        </div>
      </div>
      <div class="stat">
        <div class="l" style="margin-bottom:6px;">Highest</div>
        <div style="display:flex; gap:12px; align-items:baseline;">
          <span class="n mono" style="font-size:20px; color:var(--partial);"><%= current.max %></span>
          <span style="color:var(--ink-soft); font-size:13px;">vs</span>
          <span class="n mono" style="font-size:20px; color:var(--ink-soft);"><%= previous.max %></span>
        </div>
      </div>
      <div class="stat">
        <div class="l" style="margin-bottom:6px;">Lowest</div>
        <div style="display:flex; gap:12px; align-items:baseline;">
          <span class="n mono" style="font-size:20px; color:var(--partial);"><%= current.min %></span>
          <span style="color:var(--ink-soft); font-size:13px;">vs</span>
          <span class="n mono" style="font-size:20px; color:var(--ink-soft);"><%= previous.min %></span>
        </div>
      </div>
      <div class="stat">
        <div class="l" style="margin-bottom:6px;">Std deviation</div>
        <div style="display:flex; gap:12px; align-items:baseline;">
          <span class="n mono" style="font-size:20px; color:var(--partial);"><%= current.stddev %></span>
          <span style="color:var(--ink-soft); font-size:13px;">vs</span>
          <span class="n mono" style="font-size:20px; color:var(--ink-soft);"><%= previous.stddev %></span>
        </div>
      </div>
    </div>

    <!-- Grouped bar chart: current vs previous -->
    <div class="panel">
      <div class="panel-head"><h2>Test comparison</h2></div>
      <div class="chart-body" style="height:280px; padding:16px;">
        <canvas id="comparisonChart"></canvas>
      </div>
    </div>
  <% } else { %>
    <div class="panel" style="margin-top:20px;">
      <div class="panel-body" style="text-align:center; color:var(--ink-soft); padding:32px;">
        <div style="font-size:14px; font-weight:500; color:var(--ink); margin-bottom:4px;">No previous test to compare</div>
        <div style="font-size:13px;">This is the first (or only) test for this subject and class combination.</div>
      </div>
    </div>
  <% } %>

  <!-- ── Results table ───────────────────────────────────── -->
  <% if (resultRows.length > 0) { %>
    <div class="panel">
      <div class="panel-head">
        <h2>Student results</h2>
        <span class="muted" style="font-size:13px;"><%= resultCount %> student<%= resultCount !== 1 ? 's' : '' %></span>
      </div>
      <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr><th>Roll #</th><th>Name</th><th>Class</th><th class="num">Score</th></tr>
        </thead>
        <tbody>
          <% resultRows.forEach(function(r) { %>
            <tr>
              <td class="mono"><%= r.rollNumber %></td>
              <td><strong><%= r.name %></strong> <span class="mono" style="color:var(--ink-soft); font-size:12px;"><%= r.studentIdStr %></span></td>
              <td><%= r.className %></td>
              <td class="num mono"><%= r.score %><% if (current.totalMarks) { %>/<%= current.totalMarks %><% } %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    </div>
  <% } %>

  <!-- ── Chart data island (CSP-safe) ────────────────────── -->
  <script type="application/json" id="analytics-chart-data">{
    "distribution": <%- JSON.stringify(distribution) %>,
    "current": <%- JSON.stringify(current) %>,
    "previous": <%- JSON.stringify(previous) %>
  }</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script src="/js/test-analytics-charts.js"></script>

<% } %>

<% } %>

<!-- ── Shared filter cascade wiring (same files as the PDF Reports page) ──
     #report-class-scope: classLevelId → {grade, section} map the cascade reads
     to resolve a test's grade/section behind its ClassLevels.
     #ax-filter-state: the just-applied cascade selection, re-applied by
     public/js/tests-analytics-cascade.js through the shared factory. -->
<script type="application/json" id="report-class-scope"><%- JSON.stringify(classScope || {}).replace(/</g, '\\u003c') %></script>
<script type="application/json" id="ax-filter-state"><%- JSON.stringify(filterState || {}).replace(/</g, '\\u003c') %></script>
<script src="/js/student-typeahead.js"></script>
<script src="/js/report-filter-cascade.js"></script>
<script src="/js/tests-analytics-cascade.js"></script>

<%- include('../partials/foot') %>
