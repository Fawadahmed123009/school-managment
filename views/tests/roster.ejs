<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<% if (loadError) { %>
  <div class="page-head"><div><h1>Mark test</h1></div></div>
  <div class="flash error"><%= loadError %></div>
<% } else { %>
  <div class="page-head">
    <div>
      <p class="eyebrow"><%= test.subject ? (test.subject.displayName || test.subject.name) : '' %></p>
      <h1><%= test.name %></h1>
    </div>
    <a href="/tests/mark" class="btn btn-ghost">← Pick another test</a>
  </div>

  <% if (ok) { %><div class="flash ok">Results saved.</div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>

  <% if (test) { %>
  <!-- Test score scale — the assigned teacher can fix total/pass marks here.
       Saved via fetch (see test-scores.js), NOT a POST form: a full reload
       would wipe any scores already typed into the roster below. -->
  <div class="panel" id="test-settings" data-test-id="<%= testId %>" style="margin-bottom:16px;">
    <div class="panel-head"><h2>Test settings</h2></div>
    <div class="panel-body" style="display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
      <div class="field" style="margin:0;">
        <label for="total-marks-input">Total marks</label>
        <input type="number" name="totalMarks" id="total-marks-input" min="1" value="<%= test.totalMarks %>" required style="width:110px;" />
      </div>
      <div class="field" style="margin:0;">
        <label for="pass-marks-input">Pass marks</label>
        <input type="number" name="passMarks" id="pass-marks-input" min="0" value="<%= test.passMarks %>" required style="width:110px;" />
      </div>
      <button type="button" class="btn btn-primary" id="save-settings-btn">Save</button>
      <span id="settings-status" role="status" style="font-size:13px;color:var(--ink-soft);align-self:center;"></span>
    </div>
  </div>
  <% } %>

  <% if (roster.length === 0) { %>
    <div class="empty"><div class="display">No students in the selected classes yet</div></div>
  <% } else { %>
    <div class="panel">
      <div class="panel-head">
        <h2>Enter scores</h2>
        <span class="pill ocr">Out of <%= test.totalMarks %></span>
      </div>
      <p style="margin:0 0 12px;font-size:12px;color:var(--ink-soft);">
        Type <strong>A</strong> (or leave the box blank) to mark the pupil <strong>Absent</strong> —
        absences are excluded from the class average. A typed <strong>0</strong> is a genuine score:
        it counts as 0% and is shown as “0”, not “A”.
      </p>
      <div class="attend-filters">
        <div class="attend-filter-field">
          <label for="search-student">Search student</label>
          <input type="text" id="search-student" placeholder="Name or roll number…" autocomplete="off" />
        </div>
        <div class="attend-filter-field">
          <label for="sort-roll">Sort by</label>
          <select id="sort-roll">
            <option value="">Default order</option>
            <option value="rollAsc">Roll number (ascending)</option>
            <option value="rollDesc">Roll number (descending)</option>
          </select>
        </div>
      </div>
      <div class="table-wrap">
      <table class="ledger">
        <thead><tr><th>Student</th><th class="num">Score</th><th class="num">%</th><th>Marks uploaded</th></tr></thead>
        <tbody id="roster-body">
          <% roster.forEach(function(r) { %>
            <tr data-student="<%= r.student %>" data-absent="<%= r.absent ? '1' : '' %>" data-name="<%= r.name.toLowerCase() %>" data-roll="<%= (r.rollNumber || '').toString().toLowerCase() %>">
              <td>
                <% if (r.rollNumber) { %><span class="mono" style="display:inline-block;min-width:36px;margin-right:6px;color:var(--ink-soft);font-size:12px;">#<%= r.rollNumber %></span><% } %>
                <strong><%= r.name %></strong> <span class="mono" style="color:var(--ink-soft)"><%= r.studentId %></span>
                <% if (r.parentName) { %><div style="font-size:11px;color:var(--ink-soft);">Parent: <%= r.parentName %></div><% } %>
              </td>
              <td class="num">
                <% if (r.absent) { %><span class="pill" style="color:var(--error);border-color:var(--error);" title="Absent — not counted in the average">A</span><% } %>
                <input type="text" class="score-input" maxlength="6" autocomplete="off" data-max="<%= test.totalMarks %>" value="<%= r.absent ? 'A' : (r.score != null ? r.score : '') %>" placeholder="A" title="Score, or A for absent" />
              </td>
              <td class="num"><span class="pct-cell mono" style="color:var(--ink-soft);font-size:12px;"><%= (!r.absent && r.score != null && test.totalMarks) ? Math.round((r.score / test.totalMarks) * 1000) / 10 + '%' : '' %></span></td>
              <td style="font-size:12px;color:var(--ink-soft);">
                <% if (r.markedAt) { %>
                  <span title="Uploaded <%= new Date(r.firstMarkedAt || r.markedAt).toLocaleString() %><%= r.markedByName ? ' by ' + r.markedByName : '' %>"><%= new Date(r.markedAt).toLocaleDateString() %></span>
                  <% if (r.markedByName) { %><div style="font-size:11px;">by <%= r.markedByName %></div><% } %>
                <% } else { %><span style="opacity:.5">—</span><% } %>
              </td>
            </tr>
          <% }); %>
          <tr id="roster-no-match" style="display:none;">
            <td colspan="4" style="text-align:center;color:var(--ink-soft);padding:24px;">No student matches this search.</td>
          </tr>
        </tbody>
      </table>
      </div>
      <div class="review-foot">
        <div class="total"><span class="l">Entered</span> <span id="entered-count">0</span> / <%= roster.length %></div>
        <div style="display:flex;align-items:center;gap:12px;">
          <span id="scores-status" role="status" style="font-size:13px;color:var(--ink-soft);"></span>
          <button type="button" class="btn btn-primary" id="save-scores-btn">Save scores</button>
        </div>
      </div>
    </div>
  <% } %>

  <form id="scores-form" method="POST" action="/tests/mark/<%= testId %>" style="display:none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="records" id="records-input" />
  </form>

  <script src="/js/test-scores.js"></script>
<% } %>

<%- include('../partials/foot') %>
