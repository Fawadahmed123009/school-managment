<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<% if (loadError) { %>
  <div class="page-head"><div><h1>Mark test</h1></div></div>
  <div class="flash error"><%= loadError %></div>
<% } else { %>
  <div class="page-head">
    <div>
      <p class="eyebrow"><%= test.subject ? test.subject.name : '' %></p>
      <h1><%= test.name %></h1>
    </div>
    <a href="/tests/mark" class="btn btn-ghost">← Pick another test</a>
  </div>

  <% if (ok) { %><div class="flash ok">Results saved.</div><% } %>
  <% if (marksOk) { %><div class="flash ok">Marks scale updated.</div><% } %>
  <% if (typeof error !== 'undefined' && error) { %><div class="flash error"><%= error %></div><% } %>

  <% if (test) { %>
  <!-- Test score scale — the assigned teacher can fix total/pass marks here -->
  <form method="POST" action="/tests/mark/<%= testId %>/settings" class="panel" style="margin-bottom:16px;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <div class="panel-head"><h2>Test settings</h2></div>
    <div class="panel-body" style="display:flex;gap:16px;align-items:flex-end;flex-wrap:wrap;">
      <div class="field" style="margin:0;">
        <label for="total-marks-input">Total marks</label>
        <input type="number" name="totalMarks" id="total-marks-input" min="1" value="<%= test.totalMarks %>" required style="width:110px;" />
      </div>
      <div class="field" style="margin:0;">
        <label for="pass-marks-input">Pass marks</label>
        <input type="number" name="passMarks" id="pass-marks-input" min="0" value="<%= test.passMarks %>" required style="width:110px;" />
      </div>
      <button type="submit" class="btn btn-primary">Save marks</button>
    </div>
  </form>
  <% } %>

  <% if (roster.length === 0) { %>
    <div class="empty"><div class="display">No students in the selected classes yet</div></div>
  <% } else { %>
    <div class="panel">
      <div class="panel-head">
        <h2>Enter scores</h2>
        <span class="pill ocr">Out of <%= test.totalMarks %></span>
      </div>
      <div class="attend-filters">
        <div class="attend-filter-field">
          <label for="sort-roll">Sort by</label>
          <select id="sort-roll">
            <option value="">Default order</option>
            <option value="rollAsc">Roll number (ascending)</option>
            <option value="rollDesc">Roll number (descending)</option>
          </select>
        </div>
      </div>
      <table class="ledger">
        <thead><tr><th>Student</th><th class="num">Score</th></tr></thead>
        <tbody id="roster-body">
          <% roster.forEach(function(r) { %>
            <tr data-student="<%= r.student %>" data-name="<%= r.name.toLowerCase() %>" data-roll="<%= (r.rollNumber || '').toString().toLowerCase() %>">
              <td>
                <% if (r.rollNumber) { %><span class="mono" style="display:inline-block;min-width:36px;margin-right:6px;color:var(--ink-soft);font-size:12px;">#<%= r.rollNumber %></span><% } %>
                <strong><%= r.name %></strong> <span class="mono" style="color:var(--ink-soft)"><%= r.studentId %></span>
              </td>
              <td class="num"><input type="number" class="score-input" min="0" max="<%= test.totalMarks %>" value="<%= r.score ?? '' %>" /></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <div class="review-foot">
        <div class="total"><span class="l">Entered</span> <span id="entered-count">0</span> / <%= roster.length %></div>
        <button type="button" class="btn btn-primary" id="save-scores-btn">Save scores</button>
      </div>
    </div>
  <% } %>

  <form id="scores-form" method="POST" action="/tests/mark/<%= testId %>" style="display:none;">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
    <input type="hidden" name="records" id="records-input" />
  </form>

  <script src="/js/test-scores.js"></script>
<% } %>

<%- include('../partials/foot') %>
