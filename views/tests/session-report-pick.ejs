<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Test session</p>
    <h1>Phase report card</h1>
  </div>
  <a href="/sessions/manage" class="btn btn-ghost">← Back to sessions</a>
</div>

<% if (loadError) { %><div class="flash error"><%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-body">
    <div class="field">
      <label for="studentId">Student</label>
      <select id="studentId">
        <option value="">Select a student</option>
        <% students.forEach(function(s) { %>
          <option value="<%= s._id %>"><%= s.name %></option>
        <% }); %>
      </select>
    </div>
    <button type="button" class="btn btn-primary" onclick="const v = document.getElementById('studentId').value; if (v) window.location.href = '/sessions/<%= sessionId %>/report/' + v;">View report</button>
  </div>
</div>

<%- include('../partials/foot') %>
