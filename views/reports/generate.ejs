<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Reports</p>
    <h1>Generate PDF Report</h1>
  </div>
  <a href="/dashboard" class="btn btn-ghost">&#8592; Back</a>
</div>

<% if (typeof loadError !== 'undefined' && loadError) { %><div class="flash error"><%= loadError %></div><% } %>
<% const errorMsg = typeof query !== 'undefined' && query.error ? query.error : null; %>
<% if (errorMsg) { %><div class="flash error"><%= errorMsg %></div><% } %>

<form method="POST" action="/reports/generate" id="pdfForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
  <div class="panel">
    <div class="panel-head"><h2>1. Choose report type</h2></div>
    <div class="panel-body">
      <!-- Report type is submitted via this hidden field; the toggle buttons
           below are the visible control (same pattern as the session-report
           "Report for" toggle). Only one panel is ever active — the others are
           hidden (display:none), never removed, so their inactive controls stay
           in the form but never submit conflicting values. -->
      <input type="hidden" name="reportType" id="reportType" value="result-sheet" />
      <div class="field">
        <label>Report Type</label>
        <div id="reportType-toggle" style="display:flex; gap:8px; flex-wrap:wrap;">
          <button type="button" class="btn btn-primary" data-report-type="result-sheet">Result Sheet (single test)</button>
          <button type="button" class="btn btn-ghost" data-report-type="analytics">Analytics (week / phase scope)</button>
          <button type="button" class="btn btn-ghost" data-report-type="session-report">Session Report Card (phase report)</button>
        </div>
      </div>
      <p class="hint">Pick a report type to reveal its options below.</p>
    </div>
  </div>

  <!-- Result Sheet fields -->
  <div class="panel report-fields" data-for="result-sheet">
    <div class="panel-head"><h2>2. Filter results</h2></div>
    <div class="panel-body">
      <!-- The unified cascade, identical in every panel. A result sheet is
           generated for exactly one Test: Session and Subject narrow the test
           list, Grade and Section scope which pupils the sheet lists (the
           generator's contract — testId + grade + section — is unchanged). -->
      <%- include('partials/filter-cascade', { idp: 'rs', namep: 'resultSheet', sessions: sessions, subjects: subjects, tests: tests, students: students }) %>
      <p class="hint">Select one Test — the sheet lists every pupil of that test, narrowed by Grade / Section ("All sections" keeps both). The Student picker only helps locate a pupil's class; it does not reduce the sheet to one pupil.</p>
    </div>
  </div>

  <!-- Analytics fields -->
  <div class="panel report-fields" data-for="analytics" style="display:none">
    <div class="panel-head"><h2>2. Filter results</h2></div>
    <div class="panel-body">
      <!-- The same unified cascade. Session, Subject and Test bound which
           results feed the report; Grade, Section and Student scope the pupils.
           All six fields submit under unique `analytics*` names (the panels
           share one <form> and hidden ≠ unsubmitted). -->
      <%- include('partials/filter-cascade', { idp: 'an', namep: 'analytics', sessions: sessions, subjects: subjects, tests: tests, students: students }) %>
      <p class="hint">Session, Subject and Test bound which results feed the report; Grade, Section and Student scope the pupils. Leave any on its "All …" option to keep it broad — a single Student enables the WhatsApp share, and with no filters the report covers every matching result school-wide.</p>
    </div>
  </div>

  <!-- Session Report fields -->
  <div class="panel report-fields" data-for="session-report" style="display:none">
    <div class="panel-head"><h2>2. Session report options</h2></div>
    <div class="panel-body">
      <!-- Hidden scope is what the server reads: 'student' for one pupil,
           'sections' for the bulk class/grade paths (both submit a classLevelIds
           array). The visible mode toggle below rewrites it. Kept enabled so it
           always submits regardless of the active mode. -->
      <input type="hidden" name="scope" id="sr-scope" value="student" />

      <!-- The unified cascade, identical to the other panels. A report card is
           per pupil: Session and Student feed the generator directly (names
           sessionReportSessionId / sessionReportStudentId); Grade and Section
           narrow the Student list; Subject and Test are browse-only here — the
           card always covers every subject of the session. -->
      <%- include('partials/filter-cascade', { idp: 'sr', namep: 'sessionReport', sessions: sessions, subjects: subjects, tests: tests, students: students }) %>
      <p class="hint">Pick a Session and a Student for one report card. "Whole grade" / "Selected sections" below generate bulk cards per class instead.</p>

      <!-- ── Report mode toggle ─────────────────────────────── -->
      <div class="field">
        <label>Report for</label>
        <div id="sr-mode-toggle" style="display:flex; gap:8px; flex-wrap:wrap;">
          <button type="button" class="btn btn-primary" data-sr-mode="student">Specific student</button>
          <button type="button" class="btn btn-ghost" data-sr-mode="grade">Whole grade</button>
          <button type="button" class="btn btn-ghost" data-sr-mode="sections">Selected sections</button>
        </div>
      </div>

      <!-- Mode: Whole grade — Grade → Section (Boys/Girls). The chosen grade +
           section resolve to every matching class; their ids are submitted as a
           hidden classLevelIds array (bulk 'sections' scope). -->
      <div class="sr-mode-panel" data-sr-mode-for="grade" style="display:none">
        <div class="field-row">
          <div class="field">
            <label for="sr-grade-grade">Grade</label>
            <select id="sr-grade-grade"><option value="">-- Select grade --</option></select>
          </div>
          <div class="field">
            <label for="sr-grade-section">Section (Boys/Girls)</label>
            <select id="sr-grade-section"><option value="">-- Select grade first --</option></select>
          </div>
        </div>
        <p class="hint" id="sr-grade-summary">Select a grade and section to include every matching class.</p>
        <!-- Resolved class ids for the chosen grade + section, filled by
             report-session-bulk.js. Hidden; submits as classLevelIds[] (bulk
             'sections' scope) so a grade/section spanning several classes (e.g.
             grade 9 with multiple groups) generates a card for each. -->
        <div id="sr-grade-class-holder" style="display:none"></div>
      </div>

      <!-- Mode: Selected sections — pick a grade, then tick its class/sections.
           Ticked ids submit as classLevelIds[]. -->
      <div class="sr-mode-panel" data-sr-mode-for="sections" style="display:none">
        <div class="field-row">
          <div class="field">
            <label for="sr-sec-grade">Grade</label>
            <select id="sr-sec-grade"><option value="">-- Select grade --</option></select>
          </div>
        </div>
        <label>Sections</label>
        <div id="sr-class-checkbox-list" style="max-height:280px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:12px 16px;background:#fafbfd;">
          <p class="hint" id="sr-sec-empty">Select a grade to list its sections.</p>
        </div>
        <p class="hint">One PDF report card per active student in the ticked class/es.</p>
      </div>

      <div class="field-row">
        <div class="field">
          <label for="sr-period">Period</label>
          <select id="sr-period">
            <option value="session">Whole session</option>
            <option value="phase">Specific phase</option>
            <option value="week">Specific week</option>
            <option value="weeks">Selected weeks (combine multiple)</option>
          </select>
        </div>
        <div class="field">
          <label for="phaseId_sr">Phase</label>
          <select name="phaseId" id="phaseId_sr" disabled>
            <option value="">-- Select session first --</option>
          </select>
        </div>
        <div class="field">
          <label for="weekId_sr">Week</label>
          <select name="weekId" id="weekId_sr" disabled>
            <option value="">-- Select session first --</option>
          </select>
        </div>
      </div>

      <!-- Multi-week picker: shown only for the "Selected weeks" period. A phase
           is chosen first, then that phase's weeks are ticked individually; the
           report aggregates ONLY the ticked weeks' tests (never the whole
           phase). The phase filter is a narrowing control with no `name` — only
           weekIds[] submits. Built client-side from the embedded session weeks. -->
      <div class="sr-period-field" data-sr-period-for="weeks" style="display:none">
        <div class="field-row">
          <div class="field">
            <label for="sr-weeks-phase">Phase</label>
            <select id="sr-weeks-phase"><option value="">-- Select phase first --</option></select>
          </div>
        </div>
        <label>Weeks to include</label>
        <div id="sr-week-checkbox-list" style="max-height:280px;overflow-y:auto;border:1px solid var(--border);border-radius:8px;padding:12px 16px;background:#fafbfd;">
          <p class="hint" id="sr-week-empty">Select a session, then a phase, to choose weeks.</p>
        </div>
        <p class="hint">Pick a phase, then tick the specific weeks to combine — results come only from these weeks' tests.</p>
      </div>
      <p class="hint">Bulk scopes and WhatsApp sending are for admins and managers. Students with no results in the selected period are skipped.</p>
    </div>
  </div>

  <button type="submit" class="btn btn-primary" style="margin-top:16px">Generate PDF</button>
</form>

<script type="application/json" id="sr-weeks"><%- JSON.stringify(weeks).replace(/</g, '\\u003c') %></script>
<script src="/js/report-generate.js"></script>
<script src="/js/report-filter-cascade.js"></script>
<script src="/js/report-session-bulk.js"></script>

<%- include('../partials/foot') %>
