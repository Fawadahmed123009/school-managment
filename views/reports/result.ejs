<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Reports</p>
    <h1>PDF Ready</h1>
  </div>
  <a href="/reports/generate" class="btn btn-ghost">&#8592; Generate another</a>
</div>

<div class="panel">
  <div class="panel-head"><h2>Your report is ready</h2></div>
  <div class="panel-body" style="text-align:center; padding:40px 20px;">
    <div style="font-size:48px; margin-bottom:16px;">&#128196;</div>
    <% if (studentName) { %>
      <p style="font-size:14px; color:var(--ink-soft); margin-bottom:8px;">Report for</p>
      <p style="font-size:20px; font-weight:700; color:var(--ink); margin-bottom:24px;"><%= studentName %></p>
    <% } %>

    <a href="<%= pdfUrl %>" target="_blank" class="btn btn-primary" style="font-size:15px; padding:12px 32px;">
      &#128194; Download / View PDF
    </a>

    <% if (whatsappLink) { %>
      <div style="margin-top:20px;">
        <a href="<%= whatsappLink %>" target="_blank" class="btn" style="background:#25D366; color:#fff; font-size:15px; padding:12px 32px;">
          &#9993; Share via WhatsApp
        </a>
        <p class="hint" style="margin-top:8px;">Sends to <%= studentName %>'s registered WhatsApp number</p>
      </div>
    <% } else { %>
      <p class="hint" style="margin-top:16px;">WhatsApp share is available when the report covers exactly one student.</p>
    <% } %>
  </div>
</div>

<%- include('../partials/foot') %>
