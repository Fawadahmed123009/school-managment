<%
// ── Unified PDF-report filter cascade ───────────────────────────────────────
// One markup definition shared verbatim by all three report panels (Result
// Sheet, Session Report Card, Analytics) so their filter UI can never drift.
// Session → Grade → Section → Student → Subject → Test, every field optional
// ("All …" = no narrowing). ONE chain per panel, driven by real data:
//   • Session picks the classes its tests cover (Test.classLevels, read from
//     each test option's data-classes) → Grade / Section / Student list only
//     what exists inside that covered set (a pupil links in via data-class).
//   • Grade → Section → Student then narrow each other as usual.
//   • Subject lists only subjects with a test in the current
//     session+grade+section scope; Test narrows on session + grade/section +
//     subject together. Changing any field clears/re-keeps everything below it.
// Client behaviour lives in public/js/report-filter-cascade.js — it binds the
// six selects by these exact `<idp>-*` ids and reads the class-scope map
// (#report-class-scope, classLevelId → {grade, section}) rendered by
// views/reports/generate.ejs.
//
// Locals:
//   idp     — element-id prefix ('rs' | 'sr' | 'an')
//   namep   — submit-name prefix ('resultSheet' | 'sessionReport' | 'analytics');
//             unique per panel because all three share ONE <form> and a hidden
//             input still submits — a shared name would double-post.
//   students, subjects, tests, sessions — server-rendered option lists,
//             already role-scoped by the view route (GET /pdf-reports/teacher-
//             students for pupils), so a plain teacher's Student search can
//             only ever match their own assigned class.
// Only the fields each generator actually consumes need to exist server-side;
// the names are uniform here so every panel posts the same shape.
const NONE_KEY = 'none';
const catKey = (value) => (value ? String(value) : NONE_KEY);
%>
<div class="field-row">
  <div class="field">
    <label for="<%= idp %>-session">Session</label>
    <select name="<%= namep %>SessionId" id="<%= idp %>-session">
      <option value="">-- All sessions --</option>
      <% sessions.forEach(function (s) { %>
        <option value="<%= s._id %>" data-phases='<%- JSON.stringify((s.phases || []).slice().sort(function (a, b) { return a.order - b.order; })) %>'><%= s.name %></option>
      <% }); %>
    </select>
  </div>
  <div class="field">
    <label for="<%= idp %>-grade">Grade</label>
    <select name="<%= namep %>Grade" id="<%= idp %>-grade">
      <option value="">All grades</option>
    </select>
  </div>
</div>
<div class="field-row">
  <div class="field">
    <label for="<%= idp %>-section">Section</label>
    <select name="<%= namep %>Section" id="<%= idp %>-section" disabled>
      <option value="">All sections</option>
    </select>
  </div>
  <div class="field student-picker">
    <label for="<%= idp %>-student-search">Student</label>
    <!-- Searchable pupil picker. The <select> below stays the ONE source of
         truth: it still carries `name` (so the panel submits the pupil id) and
         every option's data-grade / data-section / data-class (so the cascade
         can narrow it) — the search box only replaces how it is *chosen*. The
         typeahead searches exactly that select's current option pool, so it can
         never offer a pupil outside the chosen Grade/Section scope or beyond
         the server-side role scoping of this panel. Shared component:
         public/js/student-typeahead.js (same one the Fee search uses). -->
    <input type="text" id="<%= idp %>-student-search" class="student-typeahead-input" autocomplete="off"
           placeholder="Search by name or roll number..." />
    <select name="<%= namep %>StudentId" id="<%= idp %>-student" class="student-typeahead-select" style="display:none">
      <option value="">All students</option>
      <% students.forEach(function (s) { %>
        <option value="<%= s._id %>" data-grade="<%= s.grade || 'none' %>" data-section="<%= s.section || 'none' %>" data-class="<%= s.classLevelId || '' %>" data-name="<%= s.name %>" data-roll="<%= s.rollNumber %>"><%= s.name %> (<%= s.rollNumber %>)</option>
      <% }); %>
    </select>
    <div id="<%= idp %>-student-results" class="student-typeahead-results" style="display:none"></div>
    <p class="hint" id="<%= idp %>-student-hint"></p>
  </div>
</div>
<div class="field-row">
  <div class="field">
    <label for="<%= idp %>-subject">Subject</label>
    <select name="<%= namep %>SubjectId" id="<%= idp %>-subject">
      <option value="">All subjects</option>
      <% subjects.forEach(function (s) { %>
        <option value="<%= s._id %>"><%= s.displayName || s.name %></option>
      <% }); %>
    </select>
  </div>
  <div class="field">
    <label for="<%= idp %>-test">Test</label>
    <select name="<%= namep %>TestId" id="<%= idp %>-test">
      <option value="">All tests</option>
      <% tests.forEach(function (t) { %>
        <option value="<%= t._id %>" data-session="<%= catKey(t.session && t.session._id) %>" data-subject="<%= catKey(t.subject && t.subject._id) %>" data-classes='<%- JSON.stringify((t.classLevels || []).map(function (cl) { return (cl && cl._id ? String(cl._id) : String(cl)); })) %>'><%= t.name %> — <%= t.subject ? (t.subject.displayName || t.subject.name) : '?' %> (<%= new Date(t.date).toLocaleDateString() %>)</option>
      <% }); %>
    </select>
  </div>
</div>
<p class="hint" id="<%= idp %>-test-count"></p>
