<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Tests</p>
    <h1>Edit week — <%= session.name %></h1>
  </div>
  <a href="/sessions/<%= session._id %>/weeks" class="btn btn-ghost">Back to weeks</a>
</div>

<% if (saveError) { %><div class="flash error"><%= saveError %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2><%= week.name %></h2></div>
  <div class="panel-body">
    <form method="POST" action="/sessions/<%= session._id %>/weeks/<%= week._id %>/edit">
      <div class="field-row">
        <div class="field">
          <label for="name">Week name</label>
          <input type="text" name="name" id="name" value="<%= week.name %>" required />
        </div>
        <div class="field">
          <label for="phase">Phase</label>
          <select name="phase" id="phase" required>
            <option value="">Select a phase</option>
            <% session.phases.sort(function(a, b) { return a.order - b.order; }).forEach(function(p) { %>
              <option value="<%= p._id %>" <%= String(week.phase) === String(p._id) ? 'selected' : '' %>><%= p.name %></option>
            <% }); %>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="startDate">Start date</label>
          <input type="date" name="startDate" id="startDate" value="<%= new Date(week.startDate).toISOString().split('T')[0] %>" required />
        </div>
        <div class="field">
          <label for="endDate">End date</label>
          <input type="date" name="endDate" id="endDate" value="<%= new Date(week.endDate).toISOString().split('T')[0] %>" required />
        </div>
      </div>
      <div class="field-row" style="gap:8px;">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a href="/sessions/<%= session._id %>/weeks" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/foot') %>
