<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Finance</p>
    <h1>Income</h1>
  </div>
  <a href="/income-heads" class="btn btn-ghost">Income heads</a>
</div>

<% if (ok) { %><div class="flash ok">Income recorded.</div><% } %>
<% if (error) { %><div class="flash error"><%= error %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load income data: <%= loadError %></div><% } %>

<!-- ── Record income: quantity × rate (auto total) OR a direct total ── -->
<div class="panel">
  <div class="panel-head">
    <h2>Record income</h2>
    <span class="chart-subtitle">Ad-hoc income — notes sales, donations, etc.</span>
  </div>
  <div class="panel-body">
    <% if (activeHeads.length === 0) { %>
      <div class="flash error">No active income heads. <a href="/income-heads">Create one</a> before recording income.</div>
    <% } %>
    <form method="POST" action="/income/create" id="incomeEntryForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <input type="hidden" name="entryMode" id="entryMode" value="quantity" />
      <div class="field-row" style="align-items:flex-end; flex-wrap:wrap; gap:12px;">
        <div class="field" style="min-width:220px;">
          <label for="incomeHead">Income head</label>
          <select name="incomeHead" id="incomeHead" required>
            <option value="">Select a head…</option>
            <% activeHeads.forEach(function(h) { %>
              <option value="<%= h._id %>"><%= h.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field" style="max-width:180px;">
          <label for="date">Date</label>
          <input type="date" name="date" id="date" value="<%= defaultDate %>" required />
        </div>
        <div class="field" style="min-width:220px;">
          <label for="description">Description</label>
          <input type="text" name="description" id="description" required placeholder="e.g. Notes sold to Grade 9, furniture sale" />
        </div>
      </div>

      <!-- Amount-type toggle (segmented buttons; external JS swaps the panels) -->
      <div class="field" style="max-width:420px;">
        <label>Amount type</label>
        <div class="tp-tabs" style="padding:0;">
          <button type="button" class="tp-tab active" data-mode="quantity" id="modeQuantity">Quantity × unit rate</button>
          <button type="button" class="tp-tab" data-mode="direct" id="modeDirect">Direct total</button>
        </div>
      </div>

      <!-- Quantity mode: total auto-calculates (never entered manually) -->
      <div class="field-row" data-for="quantity" style="align-items:flex-end; flex-wrap:wrap; gap:12px;">
        <div class="field" style="max-width:160px;">
          <label for="quantity">Quantity</label>
          <input type="number" name="quantity" id="quantity" step="any" min="0" required placeholder="e.g. 2.5" />
        </div>
        <div class="field" style="max-width:160px;">
          <label for="unitRate">Unit rate (Rs)</label>
          <input type="number" name="unitRate" id="unitRate" step="0.01" min="0" required placeholder="e.g. 45.50" />
        </div>
        <div class="field" style="max-width:200px;">
          <label for="totalDisplay">Total amount (Rs)</label>
          <input type="text" id="totalDisplay" value="0.00" readonly tabindex="-1" />
        </div>
      </div>

      <!-- Direct mode: admin enters the total (e.g. a lump donation) -->
      <div class="field-row" data-for="direct" style="align-items:flex-end; flex-wrap:wrap; gap:12px; display:none;">
        <div class="field" style="max-width:240px;">
          <label for="totalAmount">Total amount (Rs)</label>
          <input type="number" name="totalAmount" id="totalAmount" step="0.01" min="0" placeholder="e.g. 5000" />
        </div>
      </div>

      <div class="field">
        <label for="notes">Notes (optional)</label>
        <input type="text" name="notes" id="notes" placeholder="Any extra detail" />
      </div>
      <button type="submit" class="btn btn-primary">Record income</button>
    </form>
  </div>
</div>

<!-- ── History filters (head + inclusive date range) ── -->
<div class="panel">
  <div class="panel-body">
    <form method="GET" action="/income" class="field-row" style="align-items:flex-end; margin-bottom:0; flex-wrap:wrap; gap:12px;">
      <div class="field" style="min-width:220px;">
        <label for="filterHead">Income head</label>
        <select name="incomeHead" id="filterHead">
          <option value="">All heads</option>
          <% allHeads.forEach(function(h) { %>
            <option value="<%= h._id %>" <%= filters.incomeHead === String(h._id) ? 'selected' : '' %>><%= h.name %><%= h.isActive ? '' : ' (inactive)' %></option>
          <% }); %>
        </select>
      </div>
      <div class="field" style="max-width:180px;">
        <label for="filterFrom">From</label>
        <input type="date" name="from" id="filterFrom" value="<%= filters.from %>" />
      </div>
      <div class="field" style="max-width:180px;">
        <label for="filterTo">To</label>
        <input type="date" name="to" id="filterTo" value="<%= filters.to %>" />
      </div>
      <div class="field" style="flex:none;">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="/income" class="btn btn-ghost">Reset</a>
      </div>
    </form>
  </div>
</div>

<!-- ── Running total for the filtered view (sum across ALL filtered results) ── -->
<div class="stats" style="margin-bottom:16px;">
  <div class="stat-card accent-green">
    <div class="stat-value mono"><%= fmtRs(runningTotal) %></div>
    <div class="stat-label">Running total (filtered)</div>
  </div>
  <div class="stat-card accent-blue">
    <div class="stat-value mono"><%= count %></div>
    <div class="stat-label">Entr<%= count !== 1 ? 'ies' : 'y' %></div>
  </div>
</div>

<!-- ── Income history (date-wise log, newest first) ── -->
<div class="panel">
  <div class="panel-head">
    <h2>Income history</h2>
    <span class="chart-subtitle"><%= pagination.total %> entr<%= pagination.total !== 1 ? 'ies' : 'y' %> · newest first</span>
  </div>
  <% if (entries.length === 0) { %>
    <div class="panel-body" style="color:var(--ink-soft);">No income recorded for this filter yet. Record one above.</div>
  <% } else { %>
    <div class="table-wrap">
      <table class="ledger">
        <thead>
          <tr><th>Date</th><th>Head</th><th>Description</th><th class="num">Qty</th><th class="num">Unit rate</th><th class="num">Total</th><th>Notes</th><th>By</th></tr>
        </thead>
        <tbody>
          <% entries.forEach(function(e) { %>
            <tr>
              <td class="mono"><%= e.dateKey %></td>
              <td><%= e.headName %><%= e.headActive ? '' : ' (inactive)' %></td>
              <td><strong><%= e.description %></strong></td>
              <td class="num mono"><%= e.qtyDisplay %></td>
              <td class="num mono"><%= e.rateFmt %></td>
              <td class="num mono"><strong><%= e.totalFmt %></strong></td>
              <td><%= e.notes || '—' %></td>
              <td><%= e.createdByName %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <%
      var qs = '';
      if (filters.incomeHead) qs += '&incomeHead=' + encodeURIComponent(filters.incomeHead);
      if (filters.from) qs += '&from=' + encodeURIComponent(filters.from);
      if (filters.to) qs += '&to=' + encodeURIComponent(filters.to);
    %>
    <div class="panel-body">
      <div class="pagination-bar">
        <span class="pagination-info">
          Page <%= pagination.page %> of <%= Math.max(pagination.pages, 1) %> &middot; <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %>
        </span>
        <div class="pagination-links">
          <% if (pagination.hasPrev) { %>
            <a href="/income?page=<%= pagination.page - 1 %><%= qs %>" class="page-link">&laquo; Prev</a>
          <% } else { %>
            <span class="page-link disabled">&laquo; Prev</span>
          <% } %>
          <% if (pagination.hasNext) { %>
            <a href="/income?page=<%= pagination.page + 1 %><%= qs %>" class="page-link">Next &raquo;</a>
          <% } else { %>
            <span class="page-link disabled">Next &raquo;</span>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>
</div>

<script src="/js/income-entry.js"></script>
<%- include('../partials/foot') %>