<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Roster</p>
    <h1>Students</h1>
  </div>
</div>

<% if (ok) { %><div class="flash ok">Saved.</div><% } %>
<% if (createError) { %><div class="flash error"><%= createError %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load students: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>Register a student</h2></div>
  <div class="panel-body">
    <form method="POST" action="/students/create">
      <div class="field-row">
        <div class="field">
          <label for="name">Student name</label>
          <input type="text" name="name" id="name" required />
        </div>
        <div class="field">
          <label for="fatherName">Father's name</label>
          <input type="text" name="fatherName" id="fatherName" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="gender">Gender</label>
          <select name="gender" id="gender" required>
            <option value="">Select gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
        </div>
        <div class="field">
          <label for="whatsappNumber">WhatsApp contact number</label>
          <input type="tel" name="whatsappNumber" id="whatsappNumber" required />
        </div>
      </div>
      <div class="field">
        <label for="address">Address</label>
        <input type="text" name="address" id="address" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="feeAgreed">Fee agreed (Rs)</label>
          <input type="number" name="feeAgreed" id="feeAgreed" min="0" required />
        </div>
        <div class="field">
          <label for="classLevel">Class</label>
          <select name="classLevel" id="classLevel" required>
            <option value="">Select a class</option>
            <% classes.forEach(function(c) { %>
              <option value="<%= c._id %>"><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="rollNumber">Roll number</label>
          <input type="number" name="rollNumber" id="rollNumber" min="1" required />
          <p class="hint">Unique within the selected class.</p>
        </div>
      </div>

      <details style="margin-top:12px;">
        <summary style="cursor:pointer; font-weight:600; color:var(--muted);">Parent / Family details <span style="font-weight:400; font-size:0.85em;">(optional — auto-creates or matches family)</span></summary>
        <div class="field-row" style="margin-top:12px;">
          <div class="field">
            <label for="parentName">Parent name</label>
            <input type="text" name="parentName" id="parentName" placeholder="Leave blank to use father's name" />
          </div>
          <div class="field">
            <label for="parentPhone">Parent phone</label>
            <input type="tel" name="parentPhone" id="parentPhone" placeholder="Matched against existing parents" />
            <p class="hint">If a parent with this phone exists, student is auto-linked to their family.</p>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="parentEmail">Parent email</label>
            <input type="email" name="parentEmail" id="parentEmail" placeholder="Optional" />
          </div>
          <div class="field">
            <label for="relationship">Relationship</label>
            <select name="relationship" id="relationship">
              <option value="father">Father</option>
              <option value="mother">Mother</option>
              <option value="guardian">Guardian</option>
            </select>
          </div>
        </div>
      </details>

      <button type="submit" class="btn btn-primary">Register student</button>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel-head"><h2>All students</h2></div>
  <% if (students.length === 0) { %>
    <div class="empty">
      <div class="display">No students yet</div>
    </div>
  <% } else { %>
    <table class="ledger">
      <thead>
        <tr>
          <th>Roll #</th>
          <th>Name</th>
          <th>Father's name</th>
          <th>Family</th>
          <th>Gender</th>
          <th>Class</th>
          <th>Admitted</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach(function(s) { %>
          <tr>
            <td class="mono"><%= s.rollNumber ?? '—' %></td>
            <td><strong><%= s.name %></strong></td>
            <td><%= s.fatherName ?? '—' %></td>
            <td><% if (s.familyNumber) { %><span class="pill ocr"><%= s.familyNumber %></span><% } else { %><span class="muted">—</span><% } %></td>
            <td><%= s.gender ?? '—' %></td>
            <td><%= s.classLevel ? s.classLevel.name : '—' %></td>
            <td><%= new Date(s.dateAdmitted).toLocaleDateString() %></td>
            <td>
              <% if (s.isSuspended) { %><span class="pill review">Suspended</span>
              <% } else if (s.isWithdrawn) { %><span class="pill error">Withdrawn</span>
              <% } else if (s.isGraduated) { %><span class="pill paid">Graduated</span>
              <% } else { %><span class="pill ocr">Active</span><% } %>
            </td>
            <td>
              <a href="/students/<%= s._id %>/edit" class="btn btn-ghost" style="padding:4px 10px;">Edit</a>
              <a href="/students/<%= s._id %>/analysis" class="btn btn-ghost" style="padding:4px 10px;">View</a>
              <a href="/students/<%= s._id %>/photo" class="btn btn-ghost" style="padding:4px 10px;">Photo</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('../partials/foot') %>
