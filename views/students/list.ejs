<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Roster</p>
    <h1>Students</h1>
  </div>
</div>

<% if (ok) { %><div class="flash ok">Saved.</div><% } %>
<% if (createError) { %><div class="flash error"><%= createError %></div><% } %>
<% if (loadError) { %><div class="flash error">Couldn't load students: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>Register a student</h2></div>
  <div class="panel-body">
    <form method="POST" action="/students/create">
      <div class="field-row">
        <div class="field">
          <label for="name">Student name</label>
          <input type="text" name="name" id="name" required />
        </div>
        <div class="field">
          <label for="fatherName">Father's name</label>
          <input type="text" name="fatherName" id="fatherName" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" required />
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" name="password" id="password" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="gender">Gender</label>
          <select name="gender" id="gender" required>
            <option value="">Select gender</option>
            <option value="Male">Male</option>
            <option value="Female">Female</option>
          </select>
        </div>
        <div class="field">
          <label for="whatsappNumber">WhatsApp contact number</label>
          <input type="tel" name="whatsappNumber" id="whatsappNumber" required />
        </div>
      </div>
      <div class="field">
        <label for="address">Address</label>
        <input type="text" name="address" id="address" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="feeAgreed">Fee agreed (Rs)</label>
          <input type="number" name="feeAgreed" id="feeAgreed" min="0" required />
        </div>
        <div class="field">
          <label for="classLevel">Class</label>
          <select name="classLevel" id="classLevel" required>
            <option value="">Select a class</option>
            <% classes.forEach(function(c) { %>
              <option value="<%= c._id %>"><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="rollNumber">Roll number</label>
          <input type="number" name="rollNumber" id="rollNumber" min="1" required />
          <p class="hint">Unique within the selected class.</p>
        </div>
      </div>

      <details style="margin-top:12px;">
        <summary style="cursor:pointer; font-weight:600; color:var(--muted);">Parent / Family details <span style="font-weight:400; font-size:0.85em;">(optional — auto-creates or matches family)</span></summary>
        <div class="field-row" style="margin-top:12px;">
          <div class="field">
            <label for="parentName">Parent name</label>
            <input type="text" name="parentName" id="parentName" placeholder="Leave blank to use father's name" />
          </div>
          <div class="field">
            <label for="parentPhone">Parent phone</label>
            <input type="tel" name="parentPhone" id="parentPhone" placeholder="Matched against existing parents" />
            <p class="hint">If a parent with this phone exists, student is auto-linked to their family.</p>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="parentEmail">Parent email</label>
            <input type="email" name="parentEmail" id="parentEmail" placeholder="Optional" />
          </div>
          <div class="field">
            <label for="relationship">Relationship</label>
            <select name="relationship" id="relationship">
              <option value="father">Father</option>
              <option value="mother">Mother</option>
              <option value="guardian">Guardian</option>
            </select>
          </div>
        </div>
      </details>

      <button type="submit" class="btn btn-primary">Register student</button>
    </form>
  </div>
</div>

<div class="panel">
  <div class="panel-head">
    <h2>All students</h2>
    <span class="muted" style="font-size:13px;"><%= typeof totalStudents !== 'undefined' ? totalStudents : 0 %> total in database</span>
  </div>

  <!-- Filter bar -->
  <div style="padding:16px 24px; border-bottom:1px solid var(--border); background:#fafbfd;">
    <form method="GET" action="/students" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Class</label>
        <select name="class" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;">
          <option value="">All classes</option>
          <% classes.forEach(function(c) { %>
            <option value="<%= c._id %>" <%= filters.class == c._id ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Student name</label>
        <input type="text" name="name" value="<%= filters.name %>" placeholder="Search by name…" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;" />
      </div>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Parent name</label>
        <input type="text" name="parent" value="<%= filters.parent %>" placeholder="Search by parent…" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;" />
      </div>
      <div style="display:flex; gap:6px; align-items:flex-end;">
        <button type="submit" class="btn btn-primary" style="padding:8px 16px;">Filter</button>
        <% if (filters.class || filters.name || filters.parent) { %>
          <a href="/students" class="btn btn-ghost" style="padding:8px 12px;">Clear</a>
        <% } %>
      </div>
    </form>
  </div>

  <% if (students.length === 0) { %>
    <div class="empty">
      <div class="display"><%= (filters.class || filters.name || filters.parent) ? 'No students match your filters' : 'No students yet' %></div>
    </div>
  <% } else { %>
    <table class="ledger">
      <thead>
        <tr>
          <th>Roll #</th>
          <th>Name</th>
          <th>Father's name</th>
          <th>Family</th>
          <th>Gender</th>
          <th>Class</th>
          <th>Admitted</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach(function(s) { %>
          <tr>
            <td class="mono"><%= s.rollNumber ?? '—' %></td>
            <td><strong><%= s.name %></strong></td>
            <td><%= s.fatherName ?? '—' %></td>
            <td><% if (s.familyNumber) { %><span class="pill ocr"><%= s.familyNumber %></span><% } else { %><span class="muted">—</span><% } %></td>
            <td><%= s.gender ?? '—' %></td>
            <td><%= s.classLevel ? s.classLevel.name : '—' %></td>
            <td><%= new Date(s.dateAdmitted).toLocaleDateString() %></td>
            <td>
              <% if (s.isSuspended) { %><span class="pill review">Suspended</span>
              <% } else if (s.isWithdrawn) { %><span class="pill error">Withdrawn</span>
              <% } else if (s.isGraduated) { %><span class="pill paid">Graduated</span>
              <% } else { %><span class="pill ocr">Active</span><% } %>
            </td>
            <td>
              <a href="/students/<%= s._id %>/edit" class="btn btn-ghost" style="padding:4px 10px;">Edit</a>
              <a href="/students/<%= s._id %>/analysis" class="btn btn-ghost" style="padding:4px 10px;">View</a>
              <a href="/students/<%= s._id %>/photo" class="btn btn-ghost" style="padding:4px 10px;">Photo</a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>

    <!-- Pagination controls -->
    <% if (pagination && pagination.pages > 1) { %>
      <%
        /* Build base query string preserving current filters */
        var qs = '';
        if (filters.class) qs += '&class=' + encodeURIComponent(filters.class);
        if (filters.name)  qs += '&name='  + encodeURIComponent(filters.name);
        if (filters.parent) qs += '&parent=' + encodeURIComponent(filters.parent);
      %>
      <div class="pagination-bar">
        <span class="pagination-info">
          Page <%= pagination.page %> of <%= pagination.pages %> &middot; <%= pagination.total %> result<%= pagination.total !== 1 ? 's' : '' %>
        </span>
        <div class="pagination-links">
          <% if (pagination.hasPrev) { %>
            <a href="/students?page=<%= pagination.page - 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">&laquo; Prev</a>
          <% } else { %>
            <span class="page-link disabled">&laquo; Prev</span>
          <% } %>

          <%
            /* Show page numbers with ellipsis for large page counts */
            var cur = pagination.page;
            var total = pagination.pages;
            var pages = [];
            /* always include first page */
            pages.push(1);
            /* window around current page */
            for (var i = Math.max(2, cur - 2); i <= Math.min(total - 1, cur + 2); i++) {
              pages.push(i);
            }
            /* always include last page */
            if (total > 1) pages.push(total);
            /* deduplicate and sort */
            pages = pages.filter(function(v, idx, arr) { return arr.indexOf(v) === idx; }).sort(function(a, b) { return a - b; });
          %>
          <% var prev = 0; %>
          <% pages.forEach(function(p) { %>
            <% if (p - prev > 1) { %>
              <span class="page-ellipsis">&hellip;</span>
            <% } %>
            <% if (p === cur) { %>
              <span class="page-link active"><%= p %></span>
            <% } else { %>
              <a href="/students?page=<%= p %>&limit=<%= pagination.limit %><%= qs %>" class="page-link"><%= p %></a>
            <% } %>
            <% prev = p; %>
          <% }); %>

          <% if (pagination.hasNext) { %>
            <a href="/students?page=<%= pagination.page + 1 %>&limit=<%= pagination.limit %><%= qs %>" class="page-link">Next &raquo;</a>
          <% } else { %>
            <span class="page-link disabled">Next &raquo;</span>
          <% } %>
        </div>
      </div>
    <% } %>
  <% } %>
</div>

<%- include('../partials/foot') %>
