<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Roster</p>
    <h1>Edit student</h1>
  </div>
  <div class="page-head-actions">
    <a href="/students" class="btn btn-ghost">&#8592; Back to students</a>
  </div>
</div>

<% if (editError) { %><div class="flash error"><%= editError %></div><% } %>
<% if (typeof successMsg !== 'undefined' && successMsg) { %><div class="flash" style="background:var(--paid,#16a34a); color:#fff;"><%= successMsg %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2>Student details</h2></div>
  <div class="panel-body">
    <form method="POST" action="/students/<%= student._id %>/update">
      <div class="field-row">
        <div class="field">
          <label for="name">Student name</label>
          <input type="text" name="name" id="name" value="<%= student.name || '' %>" required />
        </div>
        <div class="field">
          <label for="fatherName">Father's name</label>
          <input type="text" name="fatherName" id="fatherName" value="<%= student.fatherName || '' %>" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="email">Email</label>
          <input type="email" name="email" id="email" value="<%= student.email || '' %>" required />
        </div>
        <div class="field">
          <label for="whatsappNumber">WhatsApp contact number</label>
          <input type="tel" name="whatsappNumber" id="whatsappNumber" value="<%= student.whatsappNumber || '' %>" required />
        </div>
      </div>
      <div class="field">
        <label for="address">Address</label>
        <input type="text" name="address" id="address" value="<%= student.address || '' %>" required />
      </div>
      <div class="field-row">
        <div class="field">
          <label for="gender">Gender</label>
          <select name="gender" id="gender" required>
            <option value="">Select gender</option>
            <option value="Male" <%= student.gender === 'Male' ? 'selected' : '' %>>Male</option>
            <option value="Female" <%= student.gender === 'Female' ? 'selected' : '' %>>Female</option>
          </select>
        </div>
        <div class="field">
          <label for="religion">Religion</label>
          <select name="religion" id="religion">
            <option value="Muslim" <%= student.religion === 'Muslim' ? 'selected' : '' %>>Muslim</option>
            <option value="Non-Muslim" <%= student.religion === 'Non-Muslim' ? 'selected' : '' %>>Non-Muslim</option>
          </select>
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="feeAgreed">Fee agreed (Rs)</label>
          <input type="number" name="feeAgreed" id="feeAgreed" min="0" value="<%= student.feeAgreed != null ? student.feeAgreed : '' %>" />
          <p class="hint">Leave blank to use the fee head's default amount. Enter 0 for scholarship/sponsored students.</p>
        </div>
        <div class="field">
          <label for="classLevel">Class</label>
          <select name="classLevel" id="classLevel" required>
            <option value="">Select a class</option>
            <% classes.forEach(function(c) { %>
              <option value="<%= c._id %>" <%= (student.classLevel && (student.classLevel._id.toString() === c._id.toString() || student.classLevel.toString() === c._id.toString())) ? 'selected' : '' %>><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="field">
          <label for="rollNumber">Roll number</label>
          <input type="text" name="rollNumber" id="rollNumber" value="<%= student.rollNumber ?? '' %>" required />
          <p class="hint">Unique within the selected class.</p>
        </div>
      </div>

      <div class="field">
        <label for="password">New password <span style="color:var(--ink-soft); font-size:12px;">(leave blank to keep current)</span></label>
        <input type="text" name="password" id="password" placeholder="Enter new password or leave blank" />
      </div>

      <details style="margin-top:12px;">
        <summary style="cursor:pointer; font-weight:600; color:var(--muted);">Status flags</summary>
        <div class="field-row" style="margin-top:12px;">
          <div class="field">
            <label for="status">Enrollment status</label>
            <select name="status" id="status">
              <option value="active" <%= (!student.status || student.status === 'active') ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= student.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
            <small style="color:var(--muted); font-size:0.78rem;">Inactive students are excluded from fee assignment.</small>
          </div>
          <div class="field">
            <label style="display:flex; align-items:center; gap:8px;">
              <input type="checkbox" name="isSuspended" value="true" <%= student.isSuspended ? 'checked' : '' %> />
              Suspended
            </label>
          </div>
          <div class="field">
            <label style="display:flex; align-items:center; gap:8px;">
              <input type="checkbox" name="isWithdrawn" value="true" <%= student.isWithdrawn ? 'checked' : '' %> />
              Withdrawn
            </label>
          </div>
          <div class="field">
            <label style="display:flex; align-items:center; gap:8px;">
              <input type="checkbox" name="isGraduated" value="true" <%= student.isGraduated ? 'checked' : '' %> />
              Graduated
            </label>
          </div>
        </div>
      </details>

      <div style="margin-top:16px; display:flex; gap:12px;">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a href="/students" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>

<% if (student.parent) { %>
<div class="panel" style="border:1px solid var(--review, #ca8a04);">
  <div class="panel-head"><h2>Linked parent</h2></div>
  <div class="panel-body">
    <form method="POST" action="/students/<%= student._id %>/update-parent" id="editParentForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field-row">
        <div class="field">
          <label for="parentName">Parent name</label>
          <input type="text" name="parentName" id="parentName" value="<%= student.parent.name || '' %>" required />
        </div>
        <div class="field">
          <label for="parentEmail">Parent email</label>
          <input type="email" name="parentEmail" id="parentEmail" value="<%= student.parent.email || '' %>" required />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="parentPhone">Phone number</label>
          <input type="tel" name="parentPhone" id="parentPhone" value="<%= student.parent.phone || '' %>" required />
        </div>
        <div class="field">
          <label for="relationship">Relationship</label>
          <select name="relationship" id="relationship">
            <option value="father" <%= student.parent.relationship === 'father' ? 'selected' : '' %>>Father</option>
            <option value="mother" <%= student.parent.relationship === 'mother' ? 'selected' : '' %>>Mother</option>
            <option value="guardian" <%= student.parent.relationship === 'guardian' ? 'selected' : '' %>>Guardian</option>
          </select>
        </div>
      </div>
      <p class="hint" style="margin-bottom:12px;">Changing the phone number here only updates contact info &mdash; it does not re-trigger family matching.</p>
      <button type="submit" class="btn btn-primary">Save parent changes</button>
    </form>

    <hr style="margin: 24px 0; border: none; border-top: 1px solid var(--border, #e2e8f0);" />

    <h3 style="margin-bottom: 8px;">Reset parent password</h3>
    <p class="muted" style="font-size: 13px; margin-bottom: 16px;">
      Generate a new random password or enter one manually. The new password will be shown once after reset.
    </p>
    <form method="POST" action="/students/<%= student._id %>/reset-parent-password" id="resetParentPasswordForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field-row" style="align-items: flex-end;">
        <div class="field" style="flex: 1;">
          <label for="parentPassword">New password <span style="color:var(--ink-soft); font-size:12px;">(leave blank to auto-generate)</span></label>
          <input type="text" name="password" id="parentPassword" placeholder="Auto-generated if empty" />
        </div>
        <button type="button" class="btn btn-ghost" id="generatePasswordBtn" style="margin-bottom: 4px;">Generate</button>
      </div>
      <div style="margin-top: 12px;">
        <button type="submit" class="btn" style="background: var(--review, #ca8a04); color: #fff;">Reset parent password</button>
      </div>
    </form>
  </div>
</div>
<% } else { %>
<div class="panel" style="border:1px solid var(--primary, #3b82f6);">
  <div class="panel-head"><h2>Add parent / family details</h2></div>
  <div class="panel-body">
    <p class="muted" style="font-size: 13px; margin-bottom: 16px;">
      This student was registered without parent details. You can add parent information now.
      If the phone or email matches an existing parent account, you&rsquo;ll be asked whether to link to that family or create a new one.
    </p>
    <form method="POST" action="/students/<%= student._id %>/add-parent" id="addParentForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field-row">
        <div class="field">
          <label for="addParentName">Parent name</label>
          <input type="text" name="parentName" id="addParentName" required />
        </div>
        <div class="field">
          <label for="addParentEmail">Parent email</label>
          <input type="email" name="parentEmail" id="addParentEmail" placeholder="Optional if phone provided" />
        </div>
      </div>
      <div class="field-row">
        <div class="field">
          <label for="addParentPhone">Phone number</label>
          <input type="tel" name="parentPhone" id="addParentPhone" required />
        </div>
        <div class="field">
          <label for="addRelationship">Relationship</label>
          <select name="relationship" id="addRelationship">
            <option value="father">Father</option>
            <option value="mother">Mother</option>
            <option value="guardian">Guardian</option>
          </select>
        </div>
      </div>
      <div style="margin-top: 12px;">
        <button type="submit" class="btn btn-primary">Add parent details</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<div class="panel" style="border:1px solid var(--error, #c00);">
  <div class="panel-head"><h2 style="color:var(--error, #c00);">Danger zone</h2></div>
  <div class="panel-body" style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12px;">
    <p>Permanently delete this student record. This cannot be undone.</p>
    <form method="POST" action="/students/<%= student._id %>/delete" data-confirm="Delete <%= student.name %> permanently? This cannot be undone.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button type="submit" class="btn" style="background:var(--error, #c00); color:#fff;">Delete student</button>
    </form>
  </div>
</div>

<script>
document.getElementById('generatePasswordBtn').addEventListener('click', function() {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  let password = '';
  const array = new Uint8Array(10);
  crypto.getRandomValues(array);
  for (let i = 0; i < 10; i++) {
    password += chars[array[i] % chars.length];
  }
  document.getElementById('parentPassword').value = password;
});
</script>

<%- include('../partials/foot') %>
