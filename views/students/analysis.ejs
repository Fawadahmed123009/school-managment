<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<% if (loadError) { %>
  <div class="page-head"><div><h1>Student analysis</h1></div></div>
  <div class="flash error">Couldn't load analysis: <%= loadError %></div>
<% } else { %>
  <% /* Flash for send-report failures (route redirects back with ?reportError=). */ %>
  <% if (typeof reportError !== 'undefined' && reportError) { %>
    <div class="flash error"><%= reportError %></div>
  <% } %>
  <div class="page-head">
    <div style="display:flex; align-items:center; gap:16px;">
      <% if (analysis.student.photoUrl) { %>
        <img src="<%= analysis.student.photoUrl %>?t=<%= Date.now() %>" alt="" style="width:56px; height:56px; border-radius:8px; object-fit:cover;" />
      <% } %>
      <div>
        <p class="eyebrow"><%= analysis.student.classLevel ? analysis.student.classLevel.name : '' %></p>
        <h1><%= analysis.student.name %></h1>
      </div>
    </div>
    <div class="page-head-actions">
      <% /* Admin/manager only (page === 'students' is the requireAdminOrManager route).
             Generates the latest-session report card PDF server-side, then lands on
             the existing "PDF Ready" page with the wa.me deep link — same flow as
             /reports/generate sharing. Targets Student.whatsappNumber, the parent-
             facing number used by every other WhatsApp feature in the app. */ %>
      <% if (page === 'students') { %>
        <% if (analysis.student.whatsappNumber) { %>
          <form method="post" action="/students/<%= analysis.student._id %>/send-report" style="display:inline;">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button type="submit" class="btn" style="background:#25D366; color:#fff;">Send report on WhatsApp</button>
          </form>
        <% } else { %>
          <span class="pill review" title="No WhatsApp number saved for this student — add it in the Edit form">no #</span>
        <% } %>
      <% } %>
      <a href="/students/<%= analysis.student._id %>/photo" class="btn btn-ghost">Photo</a>
      <a href="/students" class="btn btn-ghost">← Back to students</a>
    </div>
  </div>

  <div class="stats">
    <div class="stat">
      <div class="n mono"><%= analysis.attendance.percent !== null ? analysis.attendance.percent + '%' : '—' %></div>
      <div class="l">Attendance (<%= analysis.attendance.totalMarked %> days marked)</div>
    </div>
    <div class="stat">
      <div class="n mono"><%= analysis.marks.overallAverage !== null ? analysis.marks.overallAverage + '%' : '—' %></div>
      <div class="l">Overall test average</div>
    </div>
    <div class="stat">
      <div class="n mono"><span class="pill <%= analysis.fees.pending > 0 ? 'review' : 'paid' %>"><%= analysis.fees.pending > 0 ? 'Pending' : 'Up to date' %></span></div>
      <div class="l">Fee status</div>
    </div>
  </div>

  <% /* ── Profile details — at-a-glance identity + contact block ──
         Phone targets Student.whatsappNumber, the only phone field captured on
         the add/edit forms (same number the WhatsApp features use). Father's
         Name reuses Student.fatherName — the exact field the Session Report
         Card header prints. Fields render "—" when blank so the layout stays
         stable. Non-active status flagged in the heading when set. */ %>
  <div class="panel">
    <div class="panel-head"><h2>Profile details<%= analysis.student.status && analysis.student.status !== 'active' ? ' · ' + analysis.student.status : '' %></h2></div>
    <div class="panel-body" style="display:flex; flex-wrap:wrap; gap:14px 26px;">
      <% [
        { label: 'Roll No',        value: analysis.student.rollNumber },
        { label: 'Student ID',     value: analysis.student.studentId },
        { label: 'Class',          value: analysis.student.classLevel ? analysis.student.classLevel.name : '' },
        { label: 'Gender',         value: analysis.student.gender },
        { label: 'Date Admitted',  value: analysis.student.dateAdmitted ? new Date(analysis.student.dateAdmitted).toLocaleDateString() : '' },
        { label: "Father's Name",  value: analysis.student.fatherName },
        { label: 'Phone / WhatsApp', value: analysis.student.whatsappNumber }
      ].forEach(function (f) { %>
        <div style="min-width:150px;">
          <div style="font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-soft);"><%= f.label %></div>
          <div style="font-size:14px; font-weight:600; margin-top:2px;"><%= f.value && String(f.value).trim() ? f.value : '—' %></div>
        </div>
      <% }); %>
      <% if (analysis.student.address && String(analysis.student.address).trim()) { %>
        <div style="min-width:230px; flex:1;">
          <div style="font-size:11px; text-transform:uppercase; letter-spacing:.04em; color:var(--ink-soft);">Address</div>
          <div style="font-size:14px; font-weight:600; margin-top:2px;"><%= analysis.student.address %></div>
        </div>
      <% } %>
    </div>
  </div>

  <% /* ── Alert notices (student self-view or admin viewing) ── */ %>
  <% if (typeof alertThresholds !== 'undefined') { %>
    <% var aAlerts = []; %>
    <% if (analysis.attendance.percent !== null && analysis.attendance.percent < alertThresholds.ATTENDANCE) { %>
      <% aAlerts.push({ type: 'attendance', message: analysis.student.name + "'s attendance is at " + analysis.attendance.percent + '%' }); %>
    <% } %>
    <% if (analysis.marks.bySubject) { %>
      <% analysis.marks.bySubject.forEach(function(s) { %>
        <% if (s.average < alertThresholds.SCORE) { %>
          <% aAlerts.push({ type: 'score', message: s.average + '% avg in ' + (s.label || s.subject) }); %>
        <% } %>
      <% }); %>
    <% } %>
    <% if (aAlerts.length > 0) { %>
    <div class="panel" style="border-left:4px solid var(--error);margin-bottom:16px;">
      <div class="panel-head"><h2 style="color:var(--error);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;vertical-align:text-bottom;margin-right:6px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <%= user.role === 'student' ? 'Heads up' : 'Needs attention' %>
      </h2></div>
      <div class="panel-body" style="padding:12px 20px 16px;">
        <% aAlerts.forEach(function(a) { %>
          <div style="font-size:13px;color:var(--error);font-weight:600;padding:4px 0;border-bottom:1px solid var(--border);"><%= a.message %></div>
        <% }); %>
        <p style="font-size:12px;color:var(--ink-soft);margin-top:8px;"><%= user.role === 'student' ? 'Talk to your teacher or counsellor if you need help.' : 'Consider discussing with the student and their parents.' %></p>
      </div>
    </div>
    <% } %>
  <% } %>

  <div class="panel">
    <div class="panel-head"><h2>Attendance breakdown</h2></div>
    <div class="panel-body" style="display:flex; gap:24px;">
      <div><span class="pill paid">Present</span> <%= analysis.attendance.present %></div>
      <div><span class="pill error">Absent</span> <%= analysis.attendance.absent %></div>
      <div><span class="pill review">Late</span> <%= analysis.attendance.late %></div>
    </div>
  </div>

  <% /* ── Charts: current-month attendance pie + subject-average bar ──
         Same JSON-island + external-script pattern as the parent child-analysis
         view (CSP forbids inline scripts); analysis-charts.js no-ops on canvases
         that aren't present, so a page only needs the islands its charts read. */ %>
  <div class="charts-row">
    <div class="panel chart-panel">
      <div class="panel-head"><h2>Attendance — <%= analysis.attendance.currentMonth.monthLabel %> <span class="chart-subtitle"><%= analysis.attendance.currentMonth.percent !== null ? analysis.attendance.currentMonth.percent + '% present · ' + analysis.attendance.currentMonth.totalMarked + ' days marked' : 'nothing marked this month' %></span></h2></div>
      <div class="panel-body chart-body">
        <canvas id="monthAttendanceChart"></canvas>
        <div class="chart-empty" id="monthAttendanceEmpty" style="display:none;">No attendance marked this month yet</div>
      </div>
    </div>
    <div class="panel chart-panel">
      <div class="panel-head"><h2>Subject-wise performance <span class="chart-subtitle">Average % per subject</span></h2></div>
      <div class="panel-body chart-body">
        <canvas id="subjectChart"></canvas>
        <div class="chart-empty" id="subjectEmpty" style="display:none;">No test results yet</div>
      </div>
    </div>
  </div>

  <% /* ── Test results: grouped by Subject, tests ordered by Week ──
         One collapsible <details> panel per subject (labelled with displayName,
         consistent with the subject-naming work). Uses native <details>/<summary>
         so it needs no JS / inline handlers (CSP-safe) — same pattern already used
         on the student add/edit forms. The FIRST subject is open by default so the
         structure is visible immediately without dumping a wall of rows for every
         subject at once; click any header to toggle. Within each subject the tests
         are listed in week order (chronological). Score cell: "A" for an absence,
         otherwise the real score (a genuine 0 shows "0"). */ %>
  <% var subjectGroups = (analysis.marks.subjectGroups && analysis.marks.subjectGroups.length)
        ? analysis.marks.subjectGroups
        : (analysis.marks.bySession || []).reduce(function(acc, s) {
            // Fallback for cached/older analysis payloads without subjectGroups:
            // rebuild the grouping from the flat per-session rows so the section
            // still renders (week columns will be blank). Grand totals per group
            // are computed here too, with the same pooled rule the service uses
            // (rows without totalMarks are skipped).
            s.tests.forEach(function(t) {
              var k = t.subject || 'Unknown';
              var g = acc.filter(function(x){ return x.label === k; })[0];
              if (!g) { g = { label: k, tests: [], average: null, grandObtained: 0, grandTotalMarks: 0, grandPercent: null }; acc.push(g); }
              g.tests.push(t);
              if (Number(t.totalMarks) > 0) {
                g.grandObtained += Number(t.score) || 0;
                g.grandTotalMarks += Number(t.totalMarks);
              }
            });
            return acc;
          }, []);
        // Fill grandPercent on fallback groups (service groups already carry it).
        subjectGroups.forEach(function(g) {
          if (g.grandPercent === undefined || (g.grandPercent === null && g.grandTotalMarks > 0)) {
            g.grandPercent = g.grandTotalMarks > 0
              ? Math.round((g.grandObtained / g.grandTotalMarks) * 10000) / 100
              : null;
          }
        }); %>
  <% if (subjectGroups.length === 0) { %>
    <div class="panel"><div class="empty"><div class="display">No test results yet</div></div></div>
  <% } else { %>
  <% subjectGroups.forEach(function(group, gi) { %>
    <details class="subject-group"<%= gi === 0 ? ' open' : '' %>>
      <summary>
        <span class="sg-title"><span class="caret">&#9656;</span> <%= group.label %></span>
        <% if (group.grandTotalMarks > 0) { %>
          <% /* Per-subject pooled grand totals — visible without expanding, so a
                 collapsed row still answers "how is this subject doing overall". */ %>
          <span class="pill review" title="Grand Obtained ÷ Grand Total across this subject's tests (absences count as 0 obtained)"><%= group.grandObtained %> / <%= group.grandTotalMarks %></span>
          <span class="pill ocr"><%= group.grandPercent !== null ? group.grandPercent + '%' : '—' %></span>
        <% } else if (group.average !== null) { %>
          <span class="pill ocr">Average: <%= group.average %>%</span>
        <% } %>
      </summary>
      <div class="table-wrap">
      <table class="ledger">
        <thead><tr><th>Test</th><th>Week</th><th class="num">Score</th><th class="num">Total</th><th>%</th></tr></thead>
        <tbody>
          <% group.tests.forEach(function(t) { %>
            <tr>
              <td><%= t.test %></td>
              <td><%= t.weekName || '—' %></td>
              <td class="num mono"><% if (t.absent) { %><span style="color:var(--error);font-weight:600;" title="Absent — counts as 0% here">A</span><% } else { %><%= t.score %><% } %></td>
              <td class="num mono"><%= t.totalMarks %></td>
              <td><%= t.percent !== null ? t.percent + '%' : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
        <% /* Totals footer — per-subject pooled Grand Obtained / Grand Total /
               Grand %, mirroring the whole-card Grand total panel. Skipped on
               single-test subjects, where it would just duplicate the only row. */ %>
        <% if (group.tests.length > 1 && group.grandTotalMarks > 0) { %>
        <tfoot>
          <tr>
            <td colspan="2" style="font-weight:700;">Grand Total</td>
            <td class="num mono" style="font-weight:700;"><%= group.grandObtained %></td>
            <td class="num mono" style="font-weight:700;"><%= group.grandTotalMarks %></td>
            <td style="font-weight:700;"><%= group.grandPercent !== null ? group.grandPercent + '%' : '—' %></td>
          </tr>
        </tfoot>
        <% } %>
      </table>
      </div>
    </details>
  <% }); %>

  <% /* ── Grand totals — pooled obtained / maximum across every recorded test ──
         Shown only when there are results (an empty profile has nothing to sum).
         Computed server-side in studentAnalysis.service with the Session Report
         Card's "Total"-row rule: absent → 0 obtained, full total marks kept in
         the denominator. Distinct from the "Overall test average" stat above,
         which averages per-test percentages rather than pooling raw marks. */ %>
    <% var grand = analysis.marks.grandPercent; %>
    <div class="panel">
      <div class="panel-head"><h2>Grand total <span class="chart-subtitle"><%= analysis.marks.totalTests %> test<%= analysis.marks.totalTests === 1 ? '' : 's' %> · obtained ÷ maximum, pooled across all subjects</span></h2></div>
      <div class="stats" style="margin:12px 20px 20px;">
        <div class="stat">
          <div class="n mono"><%= analysis.marks.grandObtained %></div>
          <div class="l">Grand Obtained</div>
        </div>
        <div class="stat">
          <div class="n mono"><%= analysis.marks.grandTotalMarks %></div>
          <div class="l">Grand Total</div>
        </div>
        <div class="stat">
          <div class="n mono"><%= grand !== null ? grand + '%' : '—' %></div>
          <div class="l">Grand %</div>
        </div>
      </div>
      <p style="font-size:12px; color:var(--ink-soft); padding:0 20px 14px; margin:0;">Same rule as the Session Report Card's Total row: an absence contributes 0 obtained while its full total marks stay in the denominator.</p>
    </div>
  <% } %>

  <div class="panel">
    <div class="panel-head"><h2>Fee records</h2></div>
    <% if (analysis.fees.records.length === 0) { %>
      <div class="empty"><div class="display">No fee records yet</div></div>
    <% } else { %>
      <div class="table-wrap">
      <table class="ledger">
        <thead><tr><th>Fee Head</th><th>Type</th><th>Status</th><th>Date Paid</th></tr></thead>
        <tbody>
          <% analysis.fees.records.forEach(function(f) { %>
            <tr>
              <td><%= f.feeHead ? f.feeHead.name : '—' %></td>
              <td><%= f.feeType %></td>
              <td><span class="pill <%= f.status %>"><%= f.status %></span></td>
              <td><%= f.datePaid ? new Date(f.datePaid).toLocaleDateString() : '—' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      </div>
    <% } %>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  <script type="application/json" id="analysis-data"><%- JSON.stringify({ progress: analysis.marks.progress || [], bySubject: analysis.marks.bySubject || [], monthAttendance: analysis.attendance.currentMonth }).replace(/</g, '\\u003c') %></script>
  <script src="/js/analysis-charts.js"></script>
<% } %>

<%- include('../partials/foot') %>
