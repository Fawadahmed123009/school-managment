<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Academics</p>
    <h1>Edit section</h1>
  </div>
</div>

<% if (saveError) { %><div class="flash error"><%= saveError %></div><% } %>

<div class="panel">
  <div class="panel-head"><h2><%= section.name %></h2></div>
  <div class="panel-body">
    <form method="POST" action="/sections/<%= section._id %>/edit">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="field-row">
        <div class="field">
          <label for="name">Name</label>
          <input type="text" name="name" id="name" value="<%= section.name %>" required />
        </div>
      </div>
      <div class="field-row" style="gap:8px;">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a href="/sections" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/foot') %>
