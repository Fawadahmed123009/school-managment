<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Attendance</p>
    <h1>My classes</h1>
  </div>
</div>

<% if (loadError) { %><div class="flash error">Couldn't load data: <%= loadError %></div><% } %>

<% if (classes.length === 0) { %>
  <div class="empty">
    <div class="display">No classes assigned</div>
    <p>You are not currently assigned to teach any classes. Contact your administrator.</p>
  </div>
<% } else { %>

<!-- ══════════════════════════════════════════════════════════════════ -->
<!-- UNIFIED FILTER BAR                                                -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<div class="panel">
  <div class="panel-body">
    <form method="GET" action="/attendance/my-classes" class="field-row" id="filterForm"
          style="align-items:flex-end; margin-bottom:0; flex-wrap:wrap; gap:12px;">

      <!-- Date range control -->
      <div class="field" style="min-width:150px;">
        <label for="rangeType">Date range</label>
        <select name="rangeType" id="rangeType">
          <option value="today"  <%= rangeType === 'today'  ? 'selected' : '' %>>Today</option>
          <option value="week"   <%= rangeType === 'week'   ? 'selected' : '' %>>This Week</option>
          <option value="month"  <%= rangeType === 'month'  ? 'selected' : '' %>>This Month</option>
          <option value="custom" <%= rangeType === 'custom' ? 'selected' : '' %>>Custom range</option>
        </select>
      </div>

      <!-- Week picker -->
      <div class="field range-field range-week" style="display:none; max-width:180px;">
        <label for="weekStart">Week of</label>
        <input type="date" name="weekStart" id="weekStart" value="<%= weekStartValue %>" />
      </div>

      <!-- Month picker -->
      <div class="field range-field range-month" style="display:none; max-width:100px;">
        <label for="year">Year</label>
        <input type="number" name="year" id="year" value="<%= year %>" />
      </div>
      <div class="field range-field range-month" style="display:none; max-width:100px;">
        <label for="month">Month</label>
        <input type="number" name="month" id="month" min="1" max="12" value="<%= month %>" />
      </div>

      <!-- Custom range pickers -->
      <div class="field range-field range-custom" style="display:none; max-width:170px;">
        <label for="startDate">From</label>
        <input type="date" name="startDate" id="startDate" value="<%= rangeType === 'custom' ? startDate : '' %>" />
      </div>
      <div class="field range-field range-custom" style="display:none; max-width:170px;">
        <label for="endDate">To</label>
        <input type="date" name="endDate" id="endDate" value="<%= rangeType === 'custom' ? endDate : '' %>" />
      </div>

      <!-- Scope control (teacher: no "whole institute") -->
      <div class="field" style="min-width:170px;">
        <label for="scope">Scope</label>
        <select name="scope" id="scope">
          <option value="myClasses"       <%= scope === 'myClasses'       ? 'selected' : '' %>>My classes</option>
          <option value="specificClass"   <%= scope === 'specificClass'   ? 'selected' : '' %>>Specific class</option>
          <option value="specificStudent" <%= scope === 'specificStudent' ? 'selected' : '' %>>Specific student</option>
        </select>
      </div>

      <!-- Class selector (visible when scope = specificClass or specificStudent) -->
      <div class="field scope-field scope-specificClass scope-specificStudent" style="display:none; min-width:180px;">
        <label for="classLevel">Class</label>
        <select name="classLevel" id="classLevel">
          <option value="">All my classes</option>
          <% classes.forEach(function(c) { %>
            <option value="<%= c._id %>" <%= classLevel === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="field" style="flex:none;">
        <button type="submit" class="btn btn-primary">View</button>
      </div>
    </form>
  </div>
</div>

<!-- Student search sub-filters (toggled by JS; always in DOM) -->
<div class="panel scope-specificStudent-panel" id="studentSearchPanel" style="display:<%= scope === 'specificStudent' ? '' : 'none' %>;">
  <div class="panel-body">
    <form method="GET" action="/attendance/my-classes" class="filter-bar">
      <input type="hidden" name="scope" value="specificStudent" />
      <input type="hidden" name="rangeType" value="<%= rangeType %>" />
      <% if (rangeType === 'week') { %>
        <input type="hidden" name="weekStart" value="<%= weekStartValue %>" />
      <% } else if (rangeType === 'month') { %>
        <input type="hidden" name="year" value="<%= year %>" />
        <input type="hidden" name="month" value="<%= month %>" />
      <% } else if (rangeType === 'custom') { %>
        <input type="hidden" name="startDate" value="<%= startDate %>" />
        <input type="hidden" name="endDate" value="<%= endDate %>" />
      <% } %>
      <div style="min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Class</label>
        <select name="classLevel">
          <option value="">All my classes</option>
          <% classes.forEach(function(c) { %>
            <option value="<%= c._id %>" <%= classLevel === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div style="min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Sort by</label>
        <select name="sortBy">
          <option value="" <%= !sortBy ? 'selected' : '' %>>Name (A–Z)</option>
          <option value="rollAsc" <%= sortBy === 'rollAsc' ? 'selected' : '' %>>Roll number (ascending)</option>
          <option value="rollDesc" <%= sortBy === 'rollDesc' ? 'selected' : '' %>>Roll number (descending)</option>
        </select>
      </div>
      <div style="flex:none;">
        <button type="submit" class="btn btn-primary">Search</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Range label ── -->
<div style="margin-bottom:20px;">
  <strong style="font-size:16px;">
    <% if (rangeType === 'today') { %>
      <%= startDate %>
    <% } else if (rangeType === 'week') { %>
      Week of <%= startDate %> &ndash; <%= endDate %>
    <% } else if (rangeType === 'month') { %>
      <%= year %> - <%= String(month).padStart(2, '0') %>
    <% } else if (rangeType === 'custom') { %>
      <%= startDate %> &ndash; <%= endDate %>
    <% } %>
    <% if (scope === 'specificClass' && classLevel) { %>
      <% var selClass = classes.find(function(c) { return c._id === classLevel; }); %>
      &middot; <%= selClass ? selClass.name : 'Class' %>
    <% } else if (scope === 'specificStudent') { %>
      &middot; Student view
    <% } %>
  </strong>
</div>

<!-- ══════════════════════════════════════════════════════════════════ -->
<!-- MY CLASSES / SPECIFIC CLASS SCOPE — TEACHER-SCOPED DASHBOARD       -->
<!-- (same layout as the admin/manager rollup, narrowed to the          -->
<!--  teacher's assigned classes server-side)                           -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<% if (scope === 'myClasses' || scope === 'specificClass') { %>

  <% if (!dash) { %>
    <div class="empty">
      <div class="display">Couldn't load dashboard data</div>
      <p>Check the error above and try again.</p>
    </div>
  <% } else { %>

    <!-- ── Incomplete-marking banner (amber; dismissible for this view) ── -->
    <% if (banner) { %>
      <div class="att-banner" id="incompleteBanner">
        <span class="att-banner-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        <div class="att-banner-text">
          <strong>Incomplete attendance</strong> &mdash; only <%= banner.marked %>/<%= banner.expected %>
          <%= banner.singleDay ? 'students marked' : 'student-day slots marked' %>
          for <% if (isSingleDay) { %><%= startDate %><% } else { %><%= startDate %> &rarr; <%= endDate %><% } %>.
          All rates below reflect marked records only.
        </div>
        <button type="button" class="att-banner-close" id="dismissBanner" aria-label="Dismiss">&times;</button>
      </div>
    <% } %>

    <!-- ── KPI row (teacher's assigned classes only) ── -->
    <div class="stats">
      <div class="stat-card accent-blue">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div class="stat-value" data-count="<%= dash.enrolled %>"><%= dash.enrolled.toLocaleString() %></div>
        <div class="stat-label">Students in my classes</div>
      </div>
      <div class="stat-card accent-green">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-value" data-count="<%= dash.summary.present %>"><%= dash.summary.present.toLocaleString() %></div>
        <div class="stat-label"><%= isSingleDay ? 'Present' : 'Present (range)' %></div>
      </div>
      <div class="stat-card accent-red">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <div class="stat-value" data-count="<%= dash.summary.absent %>"><%= dash.summary.absent.toLocaleString() %></div>
        <div class="stat-label"><%= isSingleDay ? 'Absent' : 'Absent (range)' %></div>
      </div>
      <div class="stat-card accent-gold">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-value" data-count="<%= dash.summary.late %>"><%= dash.summary.late.toLocaleString() %></div>
        <div class="stat-label"><%= isSingleDay ? 'Late' : 'Late (range)' %></div>
      </div>
      <div class="stat-card <%= dash.summary.rate !== null && dash.summary.rate < 75 ? 'accent-red' : 'accent-purple' %>">
        <div class="stat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg>
        </div>
        <div class="stat-value" data-count="<%= dash.summary.rate !== null ? dash.summary.rate : 0 %>"><%= dash.summary.rate !== null ? dash.summary.rate + '%' : '—' %></div>
        <div class="stat-label">Overall rate</div>
      </div>
    </div>

    <!-- ── Weekly trend + Overview donut (side by side on wide screens) ── -->
    <div class="att-dash-grid">
      <div class="panel chart-panel">
        <div class="panel-head">
          <h2>Weekly Attendance Trend</h2>
          <span class="chart-subtitle">daily rate &middot; 7 days to <%= endDate %></span>
        </div>
        <div class="panel-body chart-body">
          <canvas id="weeklyTrendChart"></canvas>
        </div>
        <div class="att-chart-legend">
          <span class="key"><i style="background:#10b981;"></i> full day</span>
          <span class="key"><i style="background:#f59e0b;"></i> partial marking</span>
          <span class="key"><i style="background:#e5e7eb;"></i> not marked</span>
        </div>
      </div>
      <div class="panel chart-panel">
        <div class="panel-head"><h2>Attendance Overview</h2></div>
        <div class="panel-body chart-body">
          <% if (dash.summary.marked > 0) { %>
            <canvas id="overviewChart"></canvas>
          <% } else { %>
            <div class="chart-empty">No attendance marked for this range</div>
          <% } %>
        </div>
      </div>
    </div>
    <script type="application/json" id="weekly-data"><%- JSON.stringify(weekly) %></script>
    <script type="application/json" id="overview-data"><%- JSON.stringify(dash.summary) %></script>

    <!-- ── Class-wise table — the teacher's own assigned classes only ── -->
    <% if (scope === 'myClasses' && classRows.length > 0) { %>
      <div class="panel" style="margin-top:24px;">
        <div class="panel-head">
          <h2>My Classes Attendance</h2>
          <span style="font-size:12px; color:var(--ink-soft);">click a column heading to sort</span>
        </div>
        <div class="table-wrap">
          <table class="ledger" id="classWiseTable">
            <thead>
              <tr>
                <th class="th-sort" data-sort="name" role="button" tabindex="0">Class</th>
                <th class="th-sort num" data-sort="total" role="button" tabindex="0">Total</th>
                <th class="th-sort num" data-sort="present" role="button" tabindex="0">Present</th>
                <th class="th-sort num" data-sort="absent" role="button" tabindex="0">Absent</th>
                <th class="th-sort num" data-sort="rate" role="button" tabindex="0">Rate</th>
              </tr>
            </thead>
            <tbody>
              <% classRows.forEach(function(c) { %>
                <tr data-name="<%= c.name.toLowerCase() %>" data-total="<%= c.marked %>" data-present="<%= c.present %>" data-absent="<%= c.absent %>" data-rate="<%= c.rate !== null ? c.rate : '' %>">
                  <td>
                    <strong><%= c.name %></strong>
                    <% if (c.incomplete) { %><span class="pill review" title="Some students/days are unmarked in this range">incomplete</span><% } %>
                  </td>
                  <td class="num mono"><%= c.marked %></td>
                  <td class="num mono"><%= c.present %></td>
                  <td class="num mono"><%= c.absent %></td>
                  <td class="num mono"><%= c.rate !== null ? c.rate + '%' : '—' %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- ── Monthly report card (calendar month the range ends in) ── -->
    <% if (monthly) { %>
      <div class="panel" style="margin-top:24px;">
        <div class="panel-head">
          <h2>Monthly Report &mdash; <%= monthly.label %></h2>
          <span class="chart-subtitle"><%= monthly.markedDays %> marked day<%= monthly.markedDays === 1 ? '' : 's' %></span>
        </div>
        <div class="panel-body">
          <div class="stats" style="margin-bottom:0;">
            <div class="stat">
              <div class="n mono"><%= monthly.avgRate !== null ? monthly.avgRate + '%' : '—' %></div>
              <div class="l">Avg rate</div>
            </div>
            <div class="stat">
              <div class="n mono" style="color:var(--paid);"><%= monthly.present.toLocaleString() %></div>
              <div class="l">Total present</div>
            </div>
            <div class="stat">
              <div class="n mono" style="color:var(--error);"><%= monthly.absent.toLocaleString() %></div>
              <div class="l">Total absent</div>
            </div>
            <div class="stat">
              <div class="n mono" style="color:var(--review);"><%= monthly.late.toLocaleString() %></div>
              <div class="l">Total late</div>
            </div>
          </div>
        </div>
      </div>
    <% } %>

    <!-- ── Insight tiles ── -->
    <% if (insights.length > 0) { %>
      <div style="margin-top:28px;">
        <div class="panel-head" style="padding-left:0;"><h2>Insights</h2></div>
        <div class="action-grid">
          <% insights.forEach(function(t) { %>
            <a href="<%= t.href %>" class="action-card">
              <span class="action-icon">
                <% if (t.icon === 'day') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                <% } else if (t.icon === 'month') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
                <% } else if (t.icon === 'absent') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="18" y1="8" x2="23" y2="13"/><line x1="23" y1="8" x2="18" y2="13"/></svg>
                <% } else if (t.icon === 'late') { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <% } else { %>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                <% } %>
              </span>
              <span class="action-text">
                <span class="action-title"><%= t.title %></span>
                <span class="action-desc"><%= t.desc %></span>
              </span>
            </a>
          <% }); %>
        </div>
      </div>
    <% } %>

  <% } %>

<!-- ══════════════════════════════════════════════════════════════════ -->
<!-- SPECIFIC STUDENT SCOPE                                            -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<% } else if (scope === 'specificStudent') { %>

  <% var students = perStudent || []; %>

  <!-- Student list -->
  <% if (students.length === 0 && !filters.studentId) { %>
    <div class="empty">
      <div class="display">No students found</div>
      <p>No students are enrolled in the selected class(es).</p>
    </div>
  <% } else if (students.length > 0) { %>
    <div class="panel">
      <div class="panel-head">
        <h2>Students</h2>
        <span style="font-size:13px; color:var(--ink-soft);"><%= students.length %> found</span>
      </div>
      <div class="att-student-list">
        <% students.forEach(function(s) { %>
          <%
            var histParams = new URLSearchParams();
            histParams.set('scope', 'specificStudent');
            histParams.set('rangeType', rangeType);
            if (rangeType === 'week') histParams.set('weekStart', weekStartValue);
            else if (rangeType === 'month') { histParams.set('year', year); histParams.set('month', month); }
            else if (rangeType === 'custom') { histParams.set('startDate', startDate); histParams.set('endDate', endDate); }
            histParams.set('studentId', s.student);
            if (classLevel) histParams.set('classLevel', classLevel);
            if (sortBy) histParams.set('sortBy', sortBy);
          %>
          <div class="att-student-row">
            <div class="att-s-info">
              <span class="att-s-name"><%= s.name %></span>
              <span class="att-s-meta">Roll #<%= s.rollNumber %> &middot; <%= s.className %></span>
            </div>
            <a href="/attendance/my-classes?<%= histParams.toString() %>" class="btn btn-ghost" style="text-decoration:none; padding:4px 14px; font-size:12px;">View history</a>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Selected student's history + snapshot -->
  <% if (filters.studentId && studentHistory) { %>
    <%
      var hist = studentHistory.history;
      var summ = studentHistory.summary;
      var selectedStudent = students.find(function(s) { return String(s.student) === String(filters.studentId); });
      var studentLabel = selectedStudent ? selectedStudent.name : 'Selected student';
      var studentRoll = selectedStudent ? selectedStudent.rollNumber : '';
      var studentCls = selectedStudent ? selectedStudent.className : '';
    %>
    <div style="margin-top:28px;">
      <div class="page-head" style="margin-bottom:16px;">
        <div>
          <p class="eyebrow">Student attendance</p>
          <h1><%= studentLabel %></h1>
          <% if (studentRoll || studentCls) { %>
            <p style="font-size:13px; color:var(--ink-soft); margin-top:4px;">
              <% if (studentRoll) { %>Roll #<%= studentRoll %><% } %>
              <% if (studentRoll && studentCls) { %> &middot; <% } %>
              <% if (studentCls) { %><%= studentCls %><% } %>
            </p>
          <% } %>
        </div>
      </div>

      <!-- Summary stats -->
      <div class="stats">
        <div class="stat">
          <div class="n mono"><%= summ.total %></div>
          <div class="l">School days in range</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--paid);"><%= summ.present %></div>
          <div class="l">Present</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--error);"><%= summ.absent %></div>
          <div class="l">Absent</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--review);"><%= summ.late %></div>
          <div class="l">Late</div>
        </div>
        <div class="stat">
          <div class="n mono"><%= summ.total > 0 ? Math.round(((summ.present + summ.late) / summ.total) * 100) : 0 %>%</div>
          <div class="l">Attendance rate</div>
        </div>
      </div>

      <!-- Snapshot doughnut -->
      <% if (summ.total > 0) { %>
        <div class="panel chart-panel">
          <div class="panel-head"><h2>Summary — <%= startDate %> to <%= endDate %></h2></div>
          <div class="panel-body chart-body">
            <canvas id="studentSummaryChart"></canvas>
          </div>
        </div>
        <script type="application/json" id="student-summary-data"><%- JSON.stringify(summ) %></script>
      <% } %>

      <!-- Timeline -->
      <% if (hist.length > 0) { %>
        <div class="panel" style="margin-top:24px;">
          <div class="panel-head">
            <h2>Day-by-day timeline</h2>
            <span style="font-size:13px; color:var(--ink-soft);"><%= hist.length %> days</span>
          </div>
          <div class="att-timeline">
            <% hist.forEach(function(h) { %>
              <% var dateObj = new Date(h.date + 'T00:00:00'); %>
              <% var dayName = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][dateObj.getDay()]; %>
              <div class="att-timeline-row">
                <span class="att-date"><%= h.date %></span>
                <span class="att-day"><%= dayName %></span>
                <% if (h.status === 'present') { %>
                  <span class="pill paid">Present</span>
                <% } else if (h.status === 'absent') { %>
                  <span class="pill error">Absent</span>
                <% } else if (h.status === 'late') { %>
                  <span class="pill review">Late</span>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <div class="empty"><div class="display">No attendance records in this range</div></div>
      <% } %>
    </div>
  <% } %>

<% } %>

<% } %>

