<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Attendance</p>
    <h1>Pick a class</h1>
  </div>
</div>

<% if (loadError) { %><div class="flash error">Couldn't load classes: <%= loadError %></div><% } %>

<div class="panel">
  <div class="panel-body">
    <div class="field">
      <label for="classLevel">Class</label>
      <select id="classLevel">
        <option value="">Select a class</option>
        <% classes.forEach(function(c) { %>
          <option value="<%= c._id %>"><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <button type="button" class="btn btn-primary" id="attendance-go-btn">Go</button>
  </div>
</div>

<script src="/js/attendance-pick.js"></script>

<%- include('../partials/foot') %>
