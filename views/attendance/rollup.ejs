<%- include('../partials/head') %>
<%- include('../partials/sidebar') %>
<%- include('../partials/topbar') %>

<div class="page-head">
  <div>
    <p class="eyebrow">Attendance</p>
    <h1>Rollup &amp; history</h1>
  </div>
</div>

<% if (loadError) { %><div class="flash error">Couldn't load data: <%= loadError %></div><% } %>

<!-- ══════════════════════════════════════════════════════════════════ -->
<!-- UNIFIED FILTER BAR                                                -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<div class="panel">
  <div class="panel-body">
    <form method="GET" action="/attendance/rollup" class="field-row" id="filterForm"
          style="align-items:flex-end; margin-bottom:0; flex-wrap:wrap; gap:12px;">

      <!-- Date range control -->
      <div class="field" style="min-width:150px;">
        <label for="rangeType">Date range</label>
        <select name="rangeType" id="rangeType">
          <option value="today"  <%= rangeType === 'today'  ? 'selected' : '' %>>Today</option>
          <option value="week"   <%= rangeType === 'week'   ? 'selected' : '' %>>This Week</option>
          <option value="month"  <%= rangeType === 'month'  ? 'selected' : '' %>>This Month</option>
          <option value="custom" <%= rangeType === 'custom' ? 'selected' : '' %>>Custom range</option>
        </select>
      </div>

      <!-- Week picker (visible only when rangeType = week) -->
      <div class="field range-field range-week" style="display:none; max-width:180px;">
        <label for="weekStart">Week of</label>
        <input type="date" name="weekStart" id="weekStart" value="<%= weekStartValue %>" />
      </div>

      <!-- Month picker (visible only when rangeType = month) -->
      <div class="field range-field range-month" style="display:none; max-width:100px;">
        <label for="year">Year</label>
        <input type="number" name="year" id="year" value="<%= year %>" />
      </div>
      <div class="field range-field range-month" style="display:none; max-width:100px;">
        <label for="month">Month</label>
        <input type="number" name="month" id="month" min="1" max="12" value="<%= month %>" />
      </div>

      <!-- Custom range pickers (visible only when rangeType = custom) -->
      <div class="field range-field range-custom" style="display:none; max-width:170px;">
        <label for="startDate">From</label>
        <input type="date" name="startDate" id="startDate" value="<%= rangeType === 'custom' ? startDate : '' %>" />
      </div>
      <div class="field range-field range-custom" style="display:none; max-width:170px;">
        <label for="endDate">To</label>
        <input type="date" name="endDate" id="endDate" value="<%= rangeType === 'custom' ? endDate : '' %>" />
      </div>

      <!-- Scope control -->
      <div class="field" style="min-width:170px;">
        <label for="scope">Scope</label>
        <select name="scope" id="scope">
          <option value="institute" <%= scope === 'institute' ? 'selected' : '' %>>Whole institute</option>
          <option value="class"     <%= scope === 'class'     ? 'selected' : '' %>>Specific class</option>
          <option value="student"   <%= scope === 'student'   ? 'selected' : '' %>>Specific student</option>
        </select>
      </div>

      <!-- Class selector (visible when scope = class, or as search filter when scope = student) -->
      <div class="field scope-field scope-class scope-student" style="display:none; min-width:180px;">
        <label for="classLevel">Class</label>
        <select name="classLevel" id="classLevel">
          <option value="">All classes</option>
          <% classes.forEach(function(c) { %>
            <option value="<%= c._id %>" <%= classLevel === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>

      <div class="field" style="flex:none;">
        <button type="submit" class="btn btn-primary">View</button>
      </div>
    </form>
  </div>
</div>

<!-- Student search sub-filters (toggled by JS; always in DOM) -->
<div class="panel scope-student-panel" id="studentSearchPanel" style="display:<%= scope === 'student' ? '' : 'none' %>;">
  <div class="panel-body">
    <form method="GET" action="/attendance/rollup" style="display:flex; gap:12px; flex-wrap:wrap; align-items:flex-end;">
      <input type="hidden" name="scope" value="student" />
      <input type="hidden" name="rangeType" value="<%= rangeType %>" />
      <% if (rangeType === 'week') { %>
        <input type="hidden" name="weekStart" value="<%= weekStartValue %>" />
      <% } else if (rangeType === 'month') { %>
        <input type="hidden" name="year" value="<%= year %>" />
        <input type="hidden" name="month" value="<%= month %>" />
      <% } else if (rangeType === 'custom') { %>
        <input type="hidden" name="startDate" value="<%= startDate %>" />
        <input type="hidden" name="endDate" value="<%= endDate %>" />
      <% } %>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Class</label>
        <select name="classLevel" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;">
          <option value="">All classes</option>
          <% classes.forEach(function(c) { %>
            <option value="<%= c._id %>" <%= classLevel === String(c._id) ? 'selected' : '' %>><%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:120px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Roll number</label>
        <input type="text" name="rollNumber" value="<%= filters.rollNumber %>" placeholder="e.g. 9A-01" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;" />
      </div>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Student name</label>
        <input type="text" name="name" value="<%= filters.name %>" placeholder="Search by name…" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;" />
      </div>
      <div style="display:flex; flex-direction:column; gap:4px; min-width:160px;">
        <label style="font-size:11px; font-weight:600; color:var(--ink-soft); text-transform:uppercase; letter-spacing:0.04em;">Sort by</label>
        <select name="sortBy" style="padding:8px 10px; border:1px solid var(--border); border-radius:6px; font-size:13px;">
          <option value="" <%= !filters.sortBy ? 'selected' : '' %>>Name (A–Z)</option>
          <option value="rollAsc" <%= filters.sortBy === 'rollAsc' ? 'selected' : '' %>>Roll number (ascending)</option>
          <option value="rollDesc" <%= filters.sortBy === 'rollDesc' ? 'selected' : '' %>>Roll number (descending)</option>
        </select>
      </div>
      <div style="flex:none;">
        <button type="submit" class="btn btn-primary">Search</button>
      </div>
    </form>
  </div>
</div>

<!-- ── Range label ── -->
<div style="margin-bottom:20px;">
  <strong style="font-size:16px;">
    <% if (rangeType === 'today') { %>
      <%= startDate %>
    <% } else if (rangeType === 'week') { %>
      Week of <%= startDate %> &ndash; <%= endDate %>
    <% } else if (rangeType === 'month') { %>
      <%= year %> - <%= String(month).padStart(2, '0') %>
    <% } else if (rangeType === 'custom') { %>
      <%= startDate %> &ndash; <%= endDate %>
    <% } %>
    <% if (scope === 'class' && classLevel) { %>
      <% var selClass = classes.find(function(c) { return c._id === classLevel; }); %>
      &middot; <%= selClass ? selClass.name : 'Class' %>
    <% } else if (scope === 'student') { %>
      &middot; Student view
    <% } %>
  </strong>
</div>

<!-- ══════════════════════════════════════════════════════════════════ -->
<!-- INSTITUTE / CLASS SCOPE — Snapshot or Trend + Per-class           -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<% if (scope === 'institute' || scope === 'class') { %>

  <% if (isSingleDay) { %>
    <!-- ── SNAPSHOT VIEW (single day) ── -->
    <% if (dailyRollup.length === 0) { %>
      <div class="empty">
        <div class="display">No attendance recorded for this day</div>
        <p>Try a different date or check back later.</p>
      </div>
    <% } else { %>
      <% var snap = dailyRollup[0]; %>
      <div class="stats">
        <div class="stat">
          <div class="n mono"><%= snap.total %></div>
          <div class="l">Total students</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--paid);"><%= snap.present %></div>
          <div class="l">Present</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--error);"><%= snap.absent %></div>
          <div class="l">Absent</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--review);"><%= snap.late %></div>
          <div class="l">Late</div>
        </div>
        <div class="stat">
          <div class="n mono"><%= snap.total > 0 ? Math.round(((snap.present + snap.late) / snap.total) * 100) : 0 %>%</div>
          <div class="l">Attendance rate</div>
        </div>
      </div>

      <div class="panel chart-panel">
        <div class="panel-head"><h2>Snapshot — <%= startDate %></h2></div>
        <div class="panel-body chart-body">
          <canvas id="snapshotChart"></canvas>
        </div>
      </div>
      <script type="application/json" id="snapshot-data"><%- JSON.stringify(snap) %></script>
    <% } %>

  <% } else { %>
    <!-- ── TREND VIEW (multi-day) ── -->
    <% if (dailyRollup.length === 0) { %>
      <div class="empty">
        <div class="display">No attendance recorded for this range</div>
        <p>Try a different range or check back later.</p>
      </div>
    <% } else { %>
      <%
        var totalP = 0, totalA = 0, totalL = 0;
        dailyRollup.forEach(function(d) { totalP += d.present; totalA += d.absent; totalL += d.late; });
        var totalAll = totalP + totalA + totalL;
      %>
      <div class="stats">
        <div class="stat">
          <div class="n mono"><%= dailyRollup.length %></div>
          <div class="l">Days with attendance</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--paid);"><%= totalP %></div>
          <div class="l">Total present</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--error);"><%= totalA %></div>
          <div class="l">Total absent</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--review);"><%= totalL %></div>
          <div class="l">Total late</div>
        </div>
        <% if (totalAll > 0) { %>
        <div class="stat">
          <div class="n mono"><%= Math.round(((totalP + totalL) / totalAll) * 100) %>%</div>
          <div class="l">Attendance rate</div>
        </div>
        <% } %>
      </div>

      <div class="panel chart-panel">
        <div class="panel-head"><h2>Daily attendance trend</h2></div>
        <div class="panel-body chart-body">
          <canvas id="dailyAttChart"></canvas>
        </div>
      </div>
      <script type="application/json" id="daily-rollup-data"><%- JSON.stringify(dailyRollup) %></script>

      <!-- Day grid for quick visual scan -->
      <div class="day-grid">
        <% dailyRollup.forEach(function(d) { %>
          <% var dateObj = new Date(d.date + 'T00:00:00'); %>
          <% var dayName = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][dateObj.getDay()]; %>
          <div class="day-cell">
            <div class="day-date"><%= dayName %> <%= dateObj.getDate() %></div>
            <div class="day-counts">
              <span class="c-present" title="Present"><%= d.present %></span>
              <span class="c-absent" title="Absent"><%= d.absent %></span>
              <span class="c-late" title="Late"><%= d.late %></span>
            </div>
          </div>
        <% }); %>
      </div>

      <!-- Detailed table -->
      <div class="panel" style="margin-top:24px;">
        <div class="panel-head"><h2>Detailed breakdown</h2></div>
        <div class="table-wrap">
          <table class="ledger">
            <thead>
              <tr><th>Date</th><th>Day</th><th class="num">Present</th><th class="num">Absent</th><th class="num">Late</th><th class="num">Total</th></tr>
            </thead>
            <tbody>
              <% dailyRollup.forEach(function(d) { %>
                <% var dateObj = new Date(d.date + 'T00:00:00'); %>
                <% var dayName = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][dateObj.getDay()]; %>
                <tr>
                  <td><%= d.date %></td>
                  <td><%= dayName %></td>
                  <td class="num mono"><%= d.present %></td>
                  <td class="num mono"><%= d.absent %></td>
                  <td class="num mono"><%= d.late %></td>
                  <td class="num mono"><%= d.total %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>

    <!-- ── PER-CLASS COMPARISON (only for whole-institute multi-day) ── -->
    <% if (scope === 'institute') { %>
      <% var classNames = Object.keys(rollup); %>
      <% if (classNames.length > 0) { %>
        <div class="panel chart-panel" style="margin-top:28px;">
          <div class="panel-head"><h2>Per-class comparison</h2></div>
          <div class="panel-body chart-body">
            <canvas id="classAttChart"></canvas>
          </div>
        </div>
        <script type="application/json" id="class-rollup-data"><%- JSON.stringify(rollup) %></script>

        <div class="panel" style="margin-top:24px;">
          <div class="panel-head"><h2>Class breakdown</h2></div>
          <div class="table-wrap">
            <table class="ledger">
              <thead>
                <tr><th>Class</th><th class="num">Present</th><th class="num">Absent</th><th class="num">Late</th></tr>
              </thead>
              <tbody>
                <% classNames.forEach(function(name) { %>
                  <tr>
                    <td><strong><%= name %></strong></td>
                    <td class="num mono"><%= rollup[name].present %></td>
                    <td class="num mono"><%= rollup[name].absent %></td>
                    <td class="num mono"><%= rollup[name].late %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    <% } %>

  <% } %>

<!-- ══════════════════════════════════════════════════════════════════ -->
<!-- STUDENT SCOPE — Student list + selected student's history          -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<% } else if (scope === 'student') { %>

  <% var students = studentSearch.students || []; %>

  <!-- Student list -->
  <% if (students.length === 0 && !filters.studentId) { %>
    <div class="empty">
      <div class="display">No students found</div>
      <p>Try adjusting your filters above.</p>
    </div>
  <% } else if (students.length > 0) { %>
    <div class="panel">
      <div class="panel-head">
        <h2>Students</h2>
        <span style="font-size:13px; color:var(--ink-soft);"><%= students.length %> found</span>
      </div>
      <div class="att-student-list">
        <% students.forEach(function(s) { %>
          <%
            // Build the "View history" link preserving all current filters
            var histParams = new URLSearchParams();
            histParams.set('scope', 'student');
            histParams.set('rangeType', rangeType);
            if (rangeType === 'week') histParams.set('weekStart', weekStartValue);
            else if (rangeType === 'month') { histParams.set('year', year); histParams.set('month', month); }
            else if (rangeType === 'custom') { histParams.set('startDate', startDate); histParams.set('endDate', endDate); }
            histParams.set('studentId', s._id);
            if (classLevel) histParams.set('classLevel', classLevel);
            if (filters.rollNumber) histParams.set('rollNumber', filters.rollNumber);
            if (filters.name) histParams.set('name', filters.name);
            if (filters.sortBy) histParams.set('sortBy', filters.sortBy);
          %>
          <div class="att-student-row">
            <div class="att-s-info">
              <span class="att-s-name"><%= s.name %></span>
              <span class="att-s-meta">Roll #<%= s.rollNumber %> &middot; <%= s.classLevel ? s.classLevel.name : '—' %></span>
            </div>
            <a href="/attendance/rollup?<%= histParams.toString() %>" class="btn btn-ghost" style="text-decoration:none; padding:4px 14px; font-size:12px;">View history</a>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>

  <!-- Selected student's attendance history + snapshot -->
  <% if (filters.studentId && studentSearch.history) { %>
    <%
      var hist = studentSearch.history;
      var summ = studentSearch.summary;
      var selectedStudent = students.find(function(s) { return String(s._id) === String(filters.studentId); });
      var studentLabel = selectedStudent ? selectedStudent.name : 'Selected student';
      var studentRoll = selectedStudent ? selectedStudent.rollNumber : '';
      var studentClass = selectedStudent && selectedStudent.classLevel ? selectedStudent.classLevel.name : '';
    %>
    <div style="margin-top:28px;">
      <div class="page-head" style="margin-bottom:16px;">
        <div>
          <p class="eyebrow">Student attendance</p>
          <h1><%= studentLabel %></h1>
          <% if (studentRoll || studentClass) { %>
            <p style="font-size:13px; color:var(--ink-soft); margin-top:4px;">
              <% if (studentRoll) { %>Roll #<%= studentRoll %><% } %>
              <% if (studentRoll && studentClass) { %> &middot; <% } %>
              <% if (studentClass) { %><%= studentClass %><% } %>
            </p>
          <% } %>
        </div>
      </div>

      <!-- Summary stats -->
      <div class="stats">
        <div class="stat">
          <div class="n mono"><%= summ.total %></div>
          <div class="l">School days in range</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--paid);"><%= summ.present %></div>
          <div class="l">Present</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--error);"><%= summ.absent %></div>
          <div class="l">Absent</div>
        </div>
        <div class="stat">
          <div class="n mono" style="color:var(--review);"><%= summ.late %></div>
          <div class="l">Late</div>
        </div>
        <div class="stat">
          <div class="n mono"><%= summ.total > 0 ? Math.round(((summ.present + summ.late) / summ.total) * 100) : 0 %>%</div>
          <div class="l">Attendance rate</div>
        </div>
      </div>

      <!-- Snapshot doughnut for selected student -->
      <% if (summ.total > 0) { %>
        <div class="panel chart-panel">
          <div class="panel-head"><h2>Summary — <%= startDate %> to <%= endDate %></h2></div>
          <div class="panel-body chart-body">
            <canvas id="studentSummaryChart"></canvas>
          </div>
        </div>
        <script type="application/json" id="student-summary-data"><%- JSON.stringify(summ) %></script>
      <% } %>

      <!-- Timeline -->
      <% if (hist.length > 0) { %>
        <div class="panel" style="margin-top:24px;">
          <div class="panel-head">
            <h2>Day-by-day timeline</h2>
            <span style="font-size:13px; color:var(--ink-soft);"><%= hist.length %> days</span>
          </div>
          <div class="att-timeline">
            <% hist.forEach(function(h) { %>
              <% var dateObj = new Date(h.date + 'T00:00:00'); %>
              <% var dayName = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'][dateObj.getDay()]; %>
              <div class="att-timeline-row">
                <span class="att-date"><%= h.date %></span>
                <span class="att-day"><%= dayName %></span>
                <% if (h.status === 'present') { %>
                  <span class="pill paid">Present</span>
                <% } else if (h.status === 'absent') { %>
                  <span class="pill error">Absent</span>
                <% } else if (h.status === 'late') { %>
                  <span class="pill review">Late</span>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>
      <% } else { %>
        <div class="empty"><div class="display">No attendance records in this range</div></div>
      <% } %>
    </div>
  <% } %>

<% } %>

<!-- ══════════════════════════════════════════════════════════════════ -->
<!-- SCRIPTS (external files only — CSP-safe, no inline code)           -->
<!-- ══════════════════════════════════════════════════════════════════ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="/js/attendance-rollup-charts.js"></script>

<%- include('../partials/foot') %>
