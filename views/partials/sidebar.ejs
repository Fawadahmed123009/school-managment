<aside class="sidebar" id="sidebar">
  <div class="brand">
    <img src="/images/logo.jpg" alt="Logo" class="brand-logo" />
    <div class="brand-text">
      <span class="brand-name">Avenir Academy</span>
      <span class="brand-sub">Staff Portal</span>
    </div>
  </div>
  <nav>
    <a href="/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <% if (user.role === 'admin') { %>
      <a href="/students" class="<%= page === 'students' ? 'active' : '' %>">Students</a>
      <a href="/students/import" class="<%= page === 'students-import' ? 'active' : '' %>">Bulk import students</a>
      <a href="/staff" class="<%= page === 'staff' ? 'active' : '' %>">Staff</a>
      <a href="/fees" class="<%= page === 'fees' ? 'active' : '' %>">Fees</a>
      <a href="/fee-heads" class="<%= page === 'fee-heads' ? 'active' : '' %>">Fee heads</a>
      <a href="/fees/collection" class="<%= page === 'fees-collection' ? 'active' : '' %>">Collection report</a>
      <a href="/fees/defaulters" class="<%= page === 'fees-defaulters' ? 'active' : '' %>">Defaulters</a>
      <a href="/fees/ocr" class="<%= page === 'fees-ocr' ? 'active' : '' %>">Scan &amp; enter fees <span class="tag">New</span></a>
      <a href="/classes" class="<%= page === 'classes' ? 'active' : '' %>">Classes</a>
      <a href="/assignments" class="<%= page === 'assignments' ? 'active' : '' %>">Assignments</a>
      <a href="/tests/manage" class="<%= page === 'tests-manage' ? 'active' : '' %>">Manage tests</a>
      <a href="/sessions/manage" class="<%= page === 'sessions-manage' ? 'active' : '' %>">Test sessions</a>
      <a href="/tests/analytics" class="<%= page === 'tests-analytics' ? 'active' : '' %>">Analytics</a>
      <a href="/reports/generate" class="<%= page === 'reports' ? 'active' : '' %>">PDF Reports</a>
      <a href="/attendance/rollup" class="<%= page === 'attendance-rollup' ? 'active' : '' %>">Attendance rollup</a>
    <% } %>
    <% if (user.role === 'teacher') { %>
      <a href="/marks" class="<%= page === 'marks' ? 'active' : '' %>">Marks &amp; results</a>
      <a href="/marks/ocr" class="<%= page === 'marks-ocr' ? 'active' : '' %>">Scan &amp; enter marks <span class="tag">New</span></a>
      <a href="/tests/mark" class="<%= page === 'tests-mark' ? 'active' : '' %>">Mark a test</a>
      <a href="/reports/generate" class="<%= page === 'reports' ? 'active' : '' %>">PDF Reports</a>
      <a href="/attendance" class="<%= page === 'attendance' ? 'active' : '' %>">Attendance</a>
    <% } %>
    <% if (user.role === 'student') { %>
      <a href="/my/analysis" class="<%= page === 'my-analysis' ? 'active' : '' %>">My progress</a>
    <% } %>
    <% if (user.role === 'parent') { %>
      <a href="/parent-portal" class="<%= page === 'parent-dashboard' ? 'active' : '' %>">My Children</a>
    <% } %>
  </nav>
  <div class="foot">Signed in as <strong style="color:#d1d5db"><%= user.name %></strong></div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
