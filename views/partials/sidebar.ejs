<aside class="sidebar" id="sidebar">
  <div class="brand">
    <img src="/images/logo.jpg" alt="Logo" class="brand-logo" />
    <div class="brand-text">
      <span class="brand-name">Avenir Academy</span>
      <span class="brand-sub">Staff Portal</span>
    </div>
  </div>
  <nav>
    <!-- Dashboard — standalone, always visible -->
    <a href="/dashboard" class="nav-standalone <%= page === 'dashboard' ? 'active' : '' %>" data-page="dashboard">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      <span>Dashboard</span>
    </a>

    <% if (user.role === 'admin' || user.isManager) { %>
    <!-- Academics -->
    <div class="nav-section" data-section="academics">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        <span>Academics</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/classes" class="<%= page === 'classes' ? 'active' : '' %>" data-page="classes">Classes</a>
        <a href="/programs" class="<%= page === 'programs' ? 'active' : '' %>" data-page="programs">Programs</a>
        <a href="/subjects" class="<%= page === 'subjects' ? 'active' : '' %>" data-page="subjects">Subjects</a>
        <a href="/assignments" class="<%= page === 'assignments' ? 'active' : '' %>" data-page="assignments">Assignments</a>
        <a href="/staff" class="<%= page === 'staff' ? 'active' : '' %>" data-page="staff">Staff</a>
      </div>
    </div>

    <!-- Students -->
    <div class="nav-section" data-section="students">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span>Students</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/students" class="<%= page === 'students' ? 'active' : '' %>" data-page="students">All students</a>
        <a href="/families" class="<%= page === 'families' ? 'active' : '' %>" data-page="families">Families</a>
        <a href="/students/import" class="<%= page === 'students-import' ? 'active' : '' %>" data-page="students-import">Bulk import</a>
        <a href="/students/export" class="<%= page === 'students-export' ? 'active' : '' %>" data-page="students-export">Export</a>
      </div>
    </div>

    <!-- Tests -->
    <div class="nav-section" data-section="tests">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Tests</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/tests/manage" class="<%= page === 'tests-manage' ? 'active' : '' %>" data-page="tests-manage">Manage tests</a>
        <a href="/sessions/manage" class="<%= page === 'sessions-manage' ? 'active' : '' %>" data-page="sessions-manage">Test sessions</a>
        <a href="/tests/analytics" class="<%= page === 'tests-analytics' ? 'active' : '' %>" data-page="tests-analytics">Analytics</a>
        <a href="/reports/generate" class="<%= page === 'reports' ? 'active' : '' %>" data-page="reports">PDF Reports</a>
      </div>
    </div>

    <!-- Attendance -->
    <div class="nav-section" data-section="attendance">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
        <span>Attendance</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/attendance/rollup" class="<%= page === 'attendance-rollup' ? 'active' : '' %>" data-page="attendance-rollup">Attendance rollup</a>
      </div>
    </div>
    <% } %>

    <% if (user.role === 'admin') { %>
    <!-- Fees -->
    <div class="nav-section" data-section="fees">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
        <span>Fees</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/fees" class="<%= page === 'fees' ? 'active' : '' %>" data-page="fees">Fees</a>
        <a href="/fees/bulk-assign" class="<%= page === 'fees-bulk-assign' ? 'active' : '' %>" data-page="fees-bulk-assign">Bulk assign</a>
        <a href="/fee-heads" class="<%= page === 'fee-heads' ? 'active' : '' %>" data-page="fee-heads">Fee heads</a>
        <a href="/fees/collection" class="<%= page === 'fees-collection' ? 'active' : '' %>" data-page="fees-collection">Collection report</a>
        <a href="/fees/defaulters" class="<%= page === 'fees-defaulters' ? 'active' : '' %>" data-page="fees-defaulters">Defaulters</a>
        <a href="/fees/inactive-dues" class="<%= page === 'fees-inactive-dues' ? 'active' : '' %>" data-page="fees-inactive-dues">Inactive dues</a>
        <a href="/fees/ocr" class="<%= page === 'fees-ocr' ? 'active' : '' %>" data-page="fees-ocr">Scan &amp; enter <span class="tag">New</span></a>
      </div>
    </div>
    <% } %>

    <% if (user.role === 'teacher') { %>
    <!-- Tests & Marks -->
    <div class="nav-section" data-section="tests">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        <span>Tests &amp; Marks</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/marks/ocr" class="<%= page === 'marks-ocr' ? 'active' : '' %>" data-page="marks-ocr">Scan &amp; enter marks <span class="tag">New</span></a>
        <a href="/tests/mark" class="<%= page === 'tests-mark' ? 'active' : '' %>" data-page="tests-mark">Mark a test</a>
      </div>
    </div>

    <!-- Attendance -->
    <div class="nav-section" data-section="attendance">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M9 16l2 2 4-4"/></svg>
        <span>Attendance</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/attendance" class="<%= page === 'attendance' ? 'active' : '' %>" data-page="attendance">Mark attendance</a>
        <a href="/attendance/my-classes" class="<%= page === 'attendance-view' ? 'active' : '' %>" data-page="attendance-view">View attendance</a>
      </div>
    </div>

    <!-- Analytics -->
    <div class="nav-section" data-section="analytics">
      <button class="nav-section-header" type="button" aria-expanded="false">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <span>Analytics</span>
        <svg class="nav-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <div class="nav-section-body">
        <a href="/teacher/analytics" class="<%= page === 'teacher-analytics' ? 'active' : '' %>" data-page="teacher-analytics">My analytics</a>
      </div>
    </div>
    <% } %>

    <% if (user.role === 'student') { %>
    <a href="/my/analysis" class="nav-standalone <%= page === 'my-analysis' ? 'active' : '' %>" data-page="my-analysis">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      <span>My progress</span>
    </a>
    <% } %>

    <% if (user.role === 'parent') { %>
    <a href="/parent-portal" class="nav-standalone <%= page === 'parent-dashboard' ? 'active' : '' %>" data-page="parent-dashboard">
      <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
      <span>My Children</span>
    </a>
    <% } %>
  </nav>
  <div class="foot">Signed in as <strong style="color:#d1d5db"><%= user.name %></strong></div>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
