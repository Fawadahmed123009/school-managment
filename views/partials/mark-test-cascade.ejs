<%#
  Shared seven-level test-marking cascade used by BOTH teacher pages
  (views/tests/pick.ejs and views/marks/ocr.ejs):
    Session → Grade → Section → Phase → Week → Subject → Test
  Every dropdown is populated server-side from the teacher's own Assignment
  records by public/js/test-cascade-filters.js — nothing here is rendered from
  a school-wide list. Labels stay hidden until a level becomes usable; the
  field wrappers keep their slot so the numbering never jumps around.
%>
<div class="grid-2col">
  <div class="field" id="session-field">
    <label for="session-select">1. Select session</label>
    <select id="session-select" disabled required>
      <option value="">Loading sessions...</option>
    </select>
  </div>

  <div class="field" id="grade-field" style="display:none;">
    <label for="grade-select">2. Select grade</label>
    <select id="grade-select" disabled required>
      <option value="">Select a session first...</option>
    </select>
  </div>
</div>

<div class="grid-2col">
  <div class="field" id="section-field" style="display:none;">
    <label for="section-select">3. Select section</label>
    <select id="section-select" disabled required>
      <option value="">Select a grade first...</option>
    </select>
  </div>

  <div class="field" id="phase-field" style="display:none;">
    <label for="phase-select">4. Select phase</label>
    <select id="phase-select" disabled required>
      <option value="">Select a section first...</option>
    </select>
  </div>
</div>

<div class="grid-2col">
  <div class="field" id="week-field" style="display:none;">
    <label for="week-select">5. Select week</label>
    <select id="week-select" disabled required>
      <option value="">Select a phase first...</option>
    </select>
  </div>

  <div class="field" id="subject-field" style="display:none;">
    <label for="subject-select">6. Select subject</label>
    <select id="subject-select" disabled required>
      <option value="">Select a week first...</option>
    </select>
  </div>
</div>

<div class="field" id="test-field" style="display:none;">
  <label for="test-select">7. Select test</label>
  <select id="test-select" disabled required>
    <option value="">Select filters first...</option>
  </select>
</div>
