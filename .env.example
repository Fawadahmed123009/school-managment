# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Rate limiting / proxy (H3) ──────────────────────────
# Number of CONFORMING front proxies that APPEND X-Forwarded-For before the
# request reaches Node (cPanel/Apache or Cloudflare→Apache → 1; direct Node
# exposure → 0, which makes the limiter ignore XFF entirely so clients cannot
# spoof it to dodge the login lockout).
# TRUST_PROXY_HOPS=1
# Global per-client request budget per 15 min (static/upload/report asset
# paths are exempt). Default 2000.
# RATE_LIMIT_GLOBAL_MAX=2000
# Failed-login attempts allowed per {ip + account} per 5 min. Default 10.
# RATE_LIMIT_LOGIN_MAX=10

# ── MongoDB Atlas ───────────────────────────────────────
DB=mongodb+srv://<user>:<password>@cluster0.nrinqhy.mongodb.net/school-mgmt?retryWrites=true&w=majority

# ── App URL (used by CORS, cookies, etc.) ───────────────
APP_URL=https://avenslms.com

# ── Internal API base URL ───────────────────────────────
# On iisnode/Plesk the Node process uses a named pipe, so
# http://localhost:PORT won't work. Set this to the public URL.
INTERNAL_API_URL=https://avenslms.com/api/v1

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=<generate-a-64-char-hex-string>

# ── Cookie signing ──────────────────────────────────────
# Signs the `session` cookie so it is tamper-evident (defense-in-depth on top
# of DB identity resolution in authView). Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this value invalidates every current session (forces re-login).
COOKIE_SECRET=<generate-a-strong-random-hex-string>

# ── School branding ─────────────────────────────────────
SCHOOL_NAME=Avenir Academy Management Portal

# ── Institute contact (used in WhatsApp message templates) ──
INSTITUTE_WHATSAPP=03399019990

# ── Google Gemini (OCR features) ────────────────────────
GEMINI_API_KEY=<your-google-ai-api-key>

# ── Cloudflare R2 (student photos / file uploads) ───────
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_BUCKET_NAME=avenslms-files
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.avenslms.com

# ── Extra CORS origins (comma-separated, optional) ──────
# EXTRA_ALLOWED_ORIGINS=https://www.avenslms.com
