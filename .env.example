# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── MongoDB Atlas ───────────────────────────────────────
DB=mongodb+srv://<user>:<password>@cluster0.nrinqhy.mongodb.net/school-mgmt?retryWrites=true&w=majority

# ── App URL (used by CORS, cookies, etc.) ───────────────
APP_URL=https://avenslms.com

# ── Internal API base URL ───────────────────────────────
# On iisnode/Plesk the Node process uses a named pipe, so
# http://localhost:PORT won't work. Set this to the public URL.
INTERNAL_API_URL=https://avenslms.com/api/v1

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=<generate-a-64-char-hex-string>

# ── School branding ─────────────────────────────────────
SCHOOL_NAME=Avenir Academy Management Portal

# ── Google Gemini (OCR features) ────────────────────────
GEMINI_API_KEY=<your-google-ai-api-key>

# ── Cloudflare R2 (student photos / file uploads) ───────
R2_ACCOUNT_ID=<your-cloudflare-account-id>
R2_ACCESS_KEY_ID=<your-r2-access-key>
R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
R2_BUCKET_NAME=avenslms-files
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://cdn.avenslms.com

# ── Extra CORS origins (comma-separated, optional) ──────
# EXTRA_ALLOWED_ORIGINS=https://www.avenslms.com
